<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title ? title + ' | EventHub' : 'EventHub | Premium Events' %></title>
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/uicons-regular-rounded/css/uicons-regular-rounded.css'>
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.1.0/uicons-solid-rounded/css/uicons-solid-rounded.css'>
    <script src="/js/validation.js" defer></script>
    <script src="/js/toast.js" defer></script>
    <script src="/js/loader.js" defer></script>
    <script src="/js/confirm.js" defer></script>
    <script src="/js/navbar.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <!-- Leaflet Map CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Cropper JS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <% if (locals.user || locals.organizer) { %>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Get the current user's ID
                const currentUserId = '<%= locals.user?._id || locals.organizer?._id %>';
                
                // Connect to Socket.io
                const socket = io({ query: { userId: currentUserId } });

                // Listen for status updates
                socket.on('statusUpdate', (data) => {
                    
                    // 1. Show Toast Notification
                    if (data.status === 'approved') {
                        Toast.success(data.message);
                    } else if (data.status === 'rejected' || data.status === 'suspended') {
                        Toast.error(data.message);
                    } else {
                        Toast.info(data.message);
                    }

                    // 2. Update Navbar Notification UI (If the elements exist)
                    const dot = document.getElementById('notificationDot');
                    const list = document.getElementById('notificationList');
                    const emptyMsg = document.getElementById('emptyNotificationMsg');

                    if (dot) dot.style.display = 'block';
                    if (emptyMsg) emptyMsg.remove();

                    if (list) {
                        const itemHtml = `
                            <div class="notification-item unread animate-fade-in">
                                <div class="notification-icon-circle ${data.status === 'approved' ? 'success' : ''}">
                                    <i class="fi fi-rr-bell"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <p class="text-white small mb-1" style="line-height: 1.4;">${data.message}</p>
                                    <span class="text-dim x-small">Just now</span>
                                </div>
                            </div>
                        `;
                        list.insertAdjacentHTML('afterbegin', itemHtml);
                    }

                    // 3. Auto-refresh page if approved so they gain Organizer Access
                    if (data.status === 'approved') {
                        setTimeout(() => {
                            window.location.reload();
                        }, 2500);
                    }
                });
            });
        </script>
    <% } %>
    <!-- GLOBAL TOAST NOTIFICATION HANDLER -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            const urlParams = new URLSearchParams(window.location.search);
            
            // Grab all possible parameter names you might use
            const errorMessage = urlParams.get('error');
            const successMessage = urlParams.get('success');
            const genericMessage = urlParams.get('message'); // Matches your screenshot!

            // Helper function to clean the URL after showing the toast
            const cleanUrl = () => {
                window.history.replaceState({}, document.title, window.location.pathname);
            };

            // If the library isn't loaded, don't crash
            if (typeof Toast === 'undefined') {
                console.error("Toast library is not loaded yet!");
                return;
            }

            // Fire the correct toast based on what is in the URL
            if (errorMessage) {
                Toast.error(errorMessage);
                cleanUrl();
            } else if (successMessage) {
                Toast.success(successMessage);
                cleanUrl();
            } else if (genericMessage) {
                // Treat generic messages as errors (since it's a session expiration)
                Toast.error(genericMessage);
                cleanUrl();
            }
        });
    </script>
    <!-- Global Confirmation Modal -->
    <div class="modal-overlay" id="customConfirmModal" style="z-index: 9999;">
        <div class="modal-container" style="max-width: 400px; padding: 0;">
            <div class="modal-body text-center p-5">
                <div id="confirmIconBg" style="width: 70px; height: 70px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.5rem;">
                    <i id="confirmIcon" class="fi"></i>
                </div>
                <h3 class="fw-bold mb-2 text-white" id="confirmTitle"></h3>
                <p class="text-dim mb-4" id="confirmMessage" style="font-size: 0.95rem;"></p>
                <div class="d-flex gap-3 mt-2">
                    <button class="btn btn-outline flex-grow-1" id="confirmCancelBtn" style="border-color: rgba(255,255,255,0.2) !important; color: white !important;">Cancel</button>
                    <button class="btn flex-grow-1" id="confirmActionBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>
</head>