            </a>
            <nav class="nav-links">
                
                <a href="/organizer/dashboard" class="text-gradient" style="font-weight: 600;">Manage My Events</a>

                <div class="user-menu" style="position: relative;">
                    <!-- Circular Avatar Button -->
                    <button class="profile-avatar-btn" id="userMenuBtn" aria-label="Profile Menu">
                        <% if(organizer.avatar) {%>
                            <img src="<%= organizer.avatar %>" alt="Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                        <% }else{ %>
                            <% const initial = organizer.organizationName ? organizer.organizationName.charAt(0).toUpperCase() : 'O'; %>
                            <span><%= initial %></span>
                        <% } %>
                    </button>
                </div>           
            </nav>
        </div>
    </header>
    
    <div class="dropdown-menu glass-premium dynamic-card" id="userDropdown" style="position: fixed; display: none; z-index: 9999;">
        <div class="dropdown-header">
            <small class="text-dim d-block" style="font-size: 0.75rem;">Signed in as</small>
            <strong style="color: white; font-size: 0.95rem;"><%= organizer.organizationName || 'Organizer' %></strong>
        </div> <!-- FIXED: Closed dropdown-header -->
        
        <a href="/organizer/profile" class="dropdown-item">My Account</a>
        <hr style="border-color: var(--border); margin: 4px 0;">
        <a id="organizerLogoutButton" class="dropdown-item text-danger" style="cursor: pointer;">Logout</a>
    </div> <!-- FIXED: Closed dropdown-menu -->

<% }else if(admin) {%>
    <header class="navbar-sticky glass-premium dynamic-card">
        <div class="container nav-container">
            <a href="/" class="logo">
                Event<span class="text-gradient">Hub</span>
            </a>
            <nav class="nav-links">
                
                <!-- <a href="/organizer/dashboard" class="text-gradient" style="font-weight: 600;">Manage My Events</a> -->

                <div class="user-menu" style="position: relative;">
                    <!-- Circular Avatar Button -->
                    <button class="profile-avatar-btn" id="userMenuBtn" aria-label="Profile Menu">
                        <% if(admin.avatar) {%>
                            <img src="<%= admin.avatar %>" alt="Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                        <% }else{ %>
                            <% const initial = admin.fullName ? admin.fullName.charAt(0).toUpperCase() : 'O'; %>
                            <span><%= initial %></span>
                        <% } %>
                    </button>
                </div>           
            </nav>
        </div>
    </header>
    
    <div class="dropdown-menu glass-premium dynamic-card" id="userDropdown" style="position: fixed; display: none; z-index: 9999;">
        <div class="dropdown-header">
            <small class="text-dim d-block" style="font-size: 0.75rem;">Signed in as</small>
            <strong style="color: white; font-size: 0.95rem;"><%= admin.fullName || 'Admin' %></strong>
        </div> <!-- FIXED: Closed dropdown-header -->
        
        <a href="/organizer/profile" class="dropdown-item">My Account</a>
        <hr style="border-color: var(--border); margin: 4px 0;">
        <a id="adminLogoutButton" class="dropdown-item text-danger" style="cursor: pointer;">Logout</a>
    </div> <!-- FIXED: Closed dropdown-menu -->

<% } %>

<script>
    const btn = document.getElementById('userMenuBtn');
    const menu = document.getElementById('userDropdown');

    function positionMenu() {
        if (!btn || !menu) return;
        const rect = btn.getBoundingClientRect();
        menu.style.top = (rect.bottom + 12) + 'px';
        menu.style.right = (window.innerWidth - rect.right) + 'px';
        menu.style.left = 'auto';
    }

    document.addEventListener('click', (e) => {
        if (!btn || !menu) return;
        
        // 1. If they click the avatar button, toggle the menu
        if (btn === e.target || btn.contains(e.target)) {
            e.preventDefault();
            if (menu.style.display === 'flex') {
                menu.style.display = 'none';
            } else {
                positionMenu();
                menu.style.display = 'flex';
            }
        }
        // 2. If they click outside the menu entirely, close it
        else if (!menu.contains(e.target)) {
            menu.style.display = 'none';
        }
    });

    // Reposition on scroll/resize
    window.addEventListener('resize', () => {
        if (menu && menu.style.display === 'flex') positionMenu();
    });
</script>