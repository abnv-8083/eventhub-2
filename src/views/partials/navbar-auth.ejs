
<% if(user) {%>
    <header class="navbar-sticky glass-premium dynamic-card">
        <div class="container nav-container">
            <a href="/" class="logo">
                Event<span class="text-gradient">Hub</span>
            </a>
            <nav class="nav-links">
                
                <a href="/events">Browse Events</a>
                <a href="/user/tickets">My Tickets</a>

                <div class="user-menu" style="position: relative;">
                    <!-- Circular Avatar Button -->
                    <button class="profile-avatar-btn" id="userMenuBtn" aria-label="Profile Menu">
                        <% if(user.avatar) {%>
                            <img src="<%= user.avatar %>" alt="Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                        <% }else{ %>
                            <% const initial = user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U'; %>
                            <span><%= initial %></span>
                        <% } %>
                    </button>
                </div>           
            </nav>
        </div>
    </header>
    
    <div class="dropdown-menu glass-premium dynamic-card" id="userDropdown" style="position: fixed; display: none; z-index: 9999;">
        <div class="dropdown-header">
            <small class="text-dim d-block" style="font-size: 0.75rem;">Signed in as</small>
            <strong style="color: white; font-size: 0.95rem;"><%= user.fullName || 'User' %></strong>
        </div> <!-- FIXED: Closed dropdown-header -->
        
        <a href="/user/profile" class="dropdown-item">My Account</a>
        <a href="/user/tickets" class="dropdown-item">My Tickets</a>
        <hr style="border-color: var(--border); margin: 4px 0;">
        <a id="userLogoutButton" class="dropdown-item text-danger" style="cursor: pointer;">Logout</a>
    </div> <!-- FIXED: Closed dropdown-menu -->

<% } else if(organizer) {%>
    <header class="navbar-sticky glass-premium dynamic-card">
        <div class="container nav-container">
            <a href="/" class="logo">
