<!-- src/views/partials/admin-sidebar.ejs -->
<aside class="sidebar">
    <button class="sidebar-toggle-btn" id="adminSidebarToggleBtn" title="Toggle Sidebar">
        <i class="fi fi-rr-angle-left"></i>
    </button>
    
    <nav class="sidebar-nav px-2">
        <a href="/admin/dashboard" class="<%= title === 'Admin Dashboard' ? 'active' : '' %>">
            <i class="fi fi-rr-apps"></i> <span>Overview</span>
        </a>

        <a href="/admin/organizers" class="<%= title === 'Manage Organizers' ? 'active' : '' %>">
            <i class="fi fi-rr-users-alt"></i> <span>Organizers</span>
        </a>

        <a href="/admin/events" class="<%= title === 'All Events' ? 'active' : '' %>">
            <i class="fi fi-rr-calendar-lines"></i> <span>All Events</span>
        </a>

        <a href="/admin/users" class="<%= title === 'Manage Users' ? 'active' : '' %>">
            <i class="fi fi-rr-user"></i> <span>User Base</span>
        </a>

        <a href="/admin/categories" class="<%= title === 'Manage Categories' ? 'active' : '' %>">
            <i class="fi fi-rr-list"></i> <span>Categories</span>
        </a>

        <a href="/admin/payouts" class="<%= title === 'Manage Payouts' ? 'active' : '' %>">
            <i class="fi fi-rr-money"></i> <span>Payouts</span>
        </a>

        <a href="/admin/settings" class="<%= title === 'Admin Settings' ? 'active' : '' %>">
            <i class="fi fi-rr-settings"></i> <span>Settings</span>
        </a>
    </nav>

    <!-- mt-auto pushes this to the bottom, sidebar-footer adds the separator line -->
    <div class="sidebar-footer mt-auto px-2 pb-3">
        <a id="adminLogoutButton" class="text-danger d-flex align-center gap-2" style="font-weight: 600;">
            <i class="fi fi-rr-exit"></i> <span>Secure Logout</span>
        </a>
    </div>
</aside>

<script>

    document.getElementById('adminLogoutButton')?.addEventListener('click', async (e)=>{
        e.preventDefault()
        try {
            const response = await axios.post('/admin/logout')
            if (response.data.success) {
                window.location.href = '/admin/login';
            }
        } catch (error) {
            console.error('Logout failed', error);
        }
    } )
    // Sidebar Toggle Logic
    const layout = document.querySelector('.dashboard-layout');
    const toggleBtn = document.getElementById('adminSidebarToggleBtn');
    
    if (layout && toggleBtn) {
        if (localStorage.getItem('sidebar-collapsed') === 'true' && window.innerWidth > 1024) {
            layout.classList.add('sidebar-collapsed');
        }
        toggleBtn.addEventListener('click', () => {
            layout.classList.toggle('sidebar-collapsed');
            localStorage.setItem('sidebar-collapsed', layout.classList.contains('sidebar-collapsed'));
        });
    }

    // Mobile Sidebar Toggle
    const mobileToggle = document.getElementById('mobileSidebarToggle');
    if(mobileToggle && layout) {
        mobileToggle.addEventListener('click', () => {
            layout.classList.toggle('mobile-sidebar-open');
        });
    }
</script>