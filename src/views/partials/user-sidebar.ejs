<!-- src/views/partials/user-sidebar.ejs -->
<aside class="sidebar" id="userSidebar">
    <button class="sidebar-toggle-btn" id="userSidebarToggleBtn" title="Toggle Sidebar">
        <i class="fi fi-rr-angle-left"></i>
    </button>

    <!-- User Info Header -->
    <div class="sidebar-user-info">
        <div class="sidebar-avatar">
            <% if(user && user.avatar) { %>
                <img src="<%= user.avatar %>" alt="Avatar">
            <% } else { %>
                <%= user ? (user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U') : 'U' %>
            <% } %>
        </div>
        <div style="min-width:0;">
            <div class="sidebar-user-name"><%= user ? (user.fullName || 'User') : 'User' %></div>
            <div class="sidebar-user-role">Member</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="sidebar-section-label">Main</div>
        <a href="/user/dashboard" class="<%= locals.title === 'User Dashboard' ? 'active' : '' %>" title="Overview">
            <i class="fi fi-rr-apps"></i> <span>Overview</span>
        </a>

        <a href="/user/tickets" class="<%= locals.title === 'My Tickets' ? 'active' : '' %>" title="My Tickets">
            <i class="fi fi-rr-ticket"></i> <span>My Tickets</span>
        </a>

        <a href="/user/calendar" class="<%= locals.title === 'My Event Calendar' ? 'active' : '' %>" title="Calendar">
            <i class="fi fi-rr-calendar"></i> <span>Calendar</span>
        </a>

        <a href="/user/wishlist" class="<%= locals.title === 'My Wishlist' ? 'active' : '' %>" title="Wishlist">
            <i class="fi fi-rr-heart"></i> <span>Wishlist</span>
        </a>

        <div class="sidebar-section-label">Finance</div>
        <a href="/user/wallet" class="<%= locals.title === 'My Wallet' ? 'active' : '' %>" title="Wallet">
            <i class="fi fi-rr-wallet"></i> <span>Wallet</span>
        </a>

        <a href="/user/refer" class="<%= locals.title === 'Refer & Earn' ? 'active' : '' %>" title="Refer & Earn">
            <i class="fi fi-rr-gift"></i> <span>Refer &amp; Earn</span>
        </a>

        <div class="sidebar-section-label">Account</div>
        <a href="/user/profile" class="<%= locals.title === 'My Profile' ? 'active' : '' %>" title="Profile Settings">
            <i class="fi fi-rr-user"></i> <span>Profile Settings</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <a href="#" id="userSideLogoutBtn" title="Secure Logout">
            <i class="fi fi-rr-exit"></i> <span>Secure Logout</span>
        </a>
    </div>
</aside>

<script>
    document.getElementById('userSideLogoutBtn')?.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
            const response = await axios.post('/user/logout');
            if (response.data.success) {
                window.location.href = '/user/login?message=Logged out successfully';
            }
        } catch (error) {
            console.error("Logout failed", error);
        }
    });

    // Sidebar Toggle Logic
    const layout = document.querySelector('.dashboard-layout');
    const toggleBtn = document.getElementById('userSidebarToggleBtn');

    if (layout && toggleBtn) {
        if (localStorage.getItem('sidebar-collapsed') === 'true' && window.innerWidth > 1024) {
            layout.classList.add('sidebar-collapsed');
        }
        toggleBtn.addEventListener('click', () => {
            layout.classList.toggle('sidebar-collapsed');
            localStorage.setItem('sidebar-collapsed', layout.classList.contains('sidebar-collapsed'));
        });
    }

    // Mobile Sidebar Toggle & Backdrop Protection
    const mobileToggle = document.getElementById('mobileNavbarToggle');
    if (mobileToggle && layout) {
        let backdrop = layout.querySelector('.sidebar-backdrop');
        if (!backdrop) {
            backdrop = document.createElement('div');
            backdrop.className = 'sidebar-backdrop';
            layout.appendChild(backdrop);
        }
        mobileToggle.addEventListener('click', () => {
            layout.classList.toggle('mobile-sidebar-open');
        });
        backdrop.addEventListener('click', () => {
            layout.classList.remove('mobile-sidebar-open');
        });
        layout.querySelectorAll('.sidebar a').forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth <= 768) layout.classList.remove('mobile-sidebar-open');
            });
        });
    }
</script>