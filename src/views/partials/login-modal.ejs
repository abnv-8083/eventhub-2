<!-- ══════════════════════════════════════════════════════════════
     MODAL LOGIN PAGE (UNIVERSAL GLASSMORPHISM POPUP)
══════════════════════════════════════════════════════════════ -->
<div id="loginModalOverlay" class="login-modal-overlay" style="display: none;">
    <div class="login-modal-card animate-popup">
        <!-- Close Button -->
        <button type="button" class="login-modal-close" onclick="closeLoginModal()" title="Close">
            <i class="fi fi-rr-cross-small"></i>
        </button>

        <!-- Header -->
        <div class="text-center mb-4">
            <div class="login-modal-icon-glow mb-3">
                <i class="fi fi-rr-user-lock"></i>
            </div>
            <h3 class="fw-bold text-white mb-1" style="font-family: var(--font-display); letter-spacing: -0.5px;">Welcome Back</h3>
            <p class="text-dim small" id="loginModalSubText">Sign in to continue to your account</p>
        </div>

        <!-- Inline Error / Success Alert (Hidden by default) -->
        <div id="loginModalAlert" class="alert alert-danger d-none mb-3" style="border-radius: 12px; font-size: 0.85rem; padding: 10px 14px;"></div>

        <!-- Login Form -->
        <form id="loginModalForm" onsubmit="handleModalLogin(event)" novalidate>
            <!-- Email Input -->
            <div class="form-floating mb-3">
                <input type="email" class="form-control" id="modalLoginEmail" placeholder="name@example.com" required data-rule="email">
                <label for="modalLoginEmail"><i class="fi fi-rr-envelope me-2"></i>Email address</label>
            </div>

            <!-- Password Input -->
            <div class="form-floating mb-3 position-relative">
                <input type="password" class="form-control" id="modalLoginPassword" placeholder="Password" required data-rule="password">
                <label for="modalLoginPassword"><i class="fi fi-rr-lock me-2"></i>Password</label>
                <button type="button" class="password-toggle" onclick="toggleModalLoginPassword(this)" tabindex="-1">
                    <i class="fi fi-rr-eye"></i>
                </button>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="d-flex justify-content-between align-items-center mb-4 small">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="modalLoginRemember" name="remember">
                    <label class="form-check-label text-dim" for="modalLoginRemember">Remember me</label>
                </div>
                <a href="/user/forgot-password" class="text-primary fw-semibold" style="text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ff526f'" onmouseout="this.style.color='var(--primary)'">Forgot password?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="modalLoginSubmitBtn" class="btn btn-primary w-100 py-3 fw-bold d-flex align-items-center justify-content-center gap-2" style="border-radius: 14px; font-size: 1rem; box-shadow: 0 10px 25px rgba(230,57,70,0.35); transition: all 0.25s;">
                <span>Sign In</span>
                <i class="fi fi-rr-arrow-right"></i>
            </button>
        </form>

        <!-- Footer -->
        <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25 small text-dim">
            Don't have an account? <a href="/user/signup" class="text-white fw-bold ms-1" style="text-decoration: underline;">Create account</a>
        </div>
    </div>
</div>

<style>
/* ─── Modal Overlay ─── */
.login-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(10, 14, 23, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.login-modal-overlay.open {
    opacity: 1;
    pointer-events: auto;
}

/* ─── Modal Card ─── */
.login-modal-card {
    background: linear-gradient(135deg, rgba(24, 29, 44, 0.95) 0%, rgba(15, 18, 28, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 26px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65), 0 0 40px rgba(230, 57, 70, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    max-width: 440px;
    width: 100%;
    padding: 2.5rem 2.2rem;
    position: relative;
    transform: scale(0.92) translateY(20px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.login-modal-overlay.open .login-modal-card {
    transform: scale(1) translateY(0);
}

/* ─── Close Button ─── */
.login-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.2s;
}

.login-modal-close:hover {
    background: rgba(230, 57, 70, 0.2);
    border-color: #ff3b5c;
    color: #ffffff;
    transform: rotate(90deg) scale(1.08);
}

/* ─── Icon Glow ─── */
.login-modal-icon-glow {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(230, 57, 70, 0.2) 0%, rgba(131, 56, 236, 0.1) 100%);
    border: 1px solid rgba(230, 57, 70, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    font-size: 1.8rem;
    color: #ff3b5c;
    box-shadow: 0 0 25px rgba(230, 57, 70, 0.25);
    position: relative;
}

.login-modal-icon-glow::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230, 57, 70, 0.3) 0%, transparent 70%);
    filter: blur(8px);
    z-index: -1;
    animation: pulseGlow 2.5s infinite alternate;
}

#modalLoginSubmitBtn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(230, 57, 70, 0.5) !important;
    background: linear-gradient(135deg, #ff526f 0%, #ff3b5c 100%);
}
</style>

<script>
function openLoginModal(customMessage) {
    const overlay = document.getElementById('loginModalOverlay');
    const subText = document.getElementById('loginModalSubText');
    const alertBox = document.getElementById('loginModalAlert');
    
    if (customMessage && subText) {
        subText.textContent = customMessage;
        subText.style.color = '#ff526f';
    } else if (subText) {
        subText.textContent = 'Sign in to continue to your account';
        subText.style.color = 'var(--text-dim)';
    }

    if (alertBox) alertBox.classList.add('d-none');
    
    if (overlay) {
        overlay.style.display = 'flex';
        void overlay.offsetWidth; // force reflow
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
            const emailInp = document.getElementById('modalLoginEmail');
            if (emailInp) emailInp.focus();
        }, 150);
    }
}

function closeLoginModal() {
    const overlay = document.getElementById('loginModalOverlay');
    if (overlay) {
        overlay.classList.remove('open');
        setTimeout(() => {
            if (!overlay.classList.contains('open')) {
                overlay.style.display = 'none';
                document.body.style.overflow = '';
            }
        }, 300);
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('loginModalOverlay');
    if (overlay) {
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) closeLoginModal();
        });
    }
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const ov = document.getElementById('loginModalOverlay');
            if (ov && ov.classList.contains('open')) closeLoginModal();
        }
    });
});

function toggleModalLoginPassword(btn) {
    const inp = document.getElementById('modalLoginPassword');
    const icon = btn.querySelector('i');
    if (inp.type === 'password') {
        inp.type = 'text';
        icon.className = 'fi fi-rr-eye-crossed';
    } else {
        inp.type = 'password';
        icon.className = 'fi fi-rr-eye';
    }
}

async function handleModalLogin(e) {
    e.preventDefault();
    const emailInp = document.getElementById('modalLoginEmail');
    const passInp = document.getElementById('modalLoginPassword');
    const rememberInp = document.getElementById('modalLoginRemember');
    const submitBtn = document.getElementById('modalLoginSubmitBtn');
    const alertBox = document.getElementById('loginModalAlert');

    const email = emailInp ? emailInp.value.trim() : '';
    const password = passInp ? passInp.value : '';
    const remember = rememberInp ? (rememberInp.checked ? 'on' : 'off') : 'off';

    if (!email || !password) {
        if (!email && typeof showError === 'function') showError(emailInp, 'Email is required');
        if (!password && typeof showError === 'function') showError(passInp, 'Password is required');
        return;
    }

    if (typeof validateInput === 'function') {
        const isEmailValid = validateInput(emailInp);
        const isPassValid = validateInput(passInp);
        if (!isEmailValid || !isPassValid) return;
    }

    try {
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Signing in...';
        }
        if (alertBox) alertBox.classList.add('d-none');

        const res = await axios.post('/user/login', { email, password, remember }, {
            headers: { 'Accept': 'application/json' }
        });

        if (res.data && res.data.success) {
            if (window.Toast) Toast.success('Login successful! Welcome back.');
            setTimeout(() => {
                if (res.data.redirect && res.data.redirect !== '/') {
                    window.location.href = res.data.redirect;
                } else {
                    window.location.reload();
                }
            }, 800);
        } else {
            throw new Error(res.data?.message || 'Login failed');
        }
    } catch (err) {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Sign In</span><i class="fi fi-rr-arrow-right ms-2"></i>';
        }
        const msg = err.response?.data?.message || err.message || 'Invalid email or password. Please try again.';
        if (alertBox) {
            alertBox.textContent = msg;
            alertBox.classList.remove('d-none');
        } else if (window.Toast) {
            Toast.error(msg);
        } else {
            alert(msg);
        }
        if (passInp) {
            passInp.value = '';
            if (typeof showError === 'function') showError(passInp, msg);
        }
    }
}
</script>
