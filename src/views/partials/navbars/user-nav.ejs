<header class="navbar-sticky glass-dark">
    <div class="container nav-container">
        <a href="/" class="logo">Event<span class="text-gradient">Hub</span></a>
        <nav class="nav-links d-flex align-center gap-3">
            <a href="/events">Browse Events</a>
            <a href="/user/tickets">My Tickets</a>
            <button class="profile-avatar-btn" id="userMenuBtn">
                <% if(user.avatar) { %>
                    <img src="<%= user.avatar %>" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                <% } else { %>
                    <span><%= user.fullName.charAt(0).toUpperCase() %></span>
                <% } %>
            </button>
            <div class="dropdown" id="notificationDropdown">
                <button class="nav-bell-btn position-relative" type="button" id="notificationBell" style="width: 45px; height: 45px;">
    
                    <svg class="custom-nav-bell" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                    </svg>
                    
                    <span id="notificationDot" class="position-absolute border border-2 border-dark rounded-circle bg-danger" 
                        style="display: none; width: 10px; height: 10px; top: 8px; right: 8px;">
                    </span>
                </button>
                
                <ul class="dropdown-menu dropdown-menu-end mt-3 glass-notif-modal" id="notifMenuUI">
                    <div class="notif-header">
                        <h6 class="m-0 text-white fw-bold" style="font-size: 0.95rem;">Notifications</h6>
                        <button class="btn btn-link btn-sm text-dim p-0 text-decoration-none x-small" id="clearAllNotifications">Mark all read</button>
                    </div>
                    
                    <div id="notificationList">
                        <div class="p-5 text-center text-dim" id="emptyNotificationMsg">
                            <i class="fi fi-rr-envelope-open d-block mb-2 opacity-50" style="font-size: 2rem;"></i>
                            <p class="small m-0">All caught up!</p>
                        </div>
                    </div>
                </ul>
            </div>
        </nav>
    </div>
</header>

<div class="dropdown-menu glass-dark" id="userDropdown" style="position: fixed; display: none; z-index: 9999;">
    <div class="dropdown-header">
        <small class="text-dim d-block">Signed in as</small>
        <strong style="color: white;"><%= user.fullName %></strong>
    </div>
    <a href="/user/profile" class="dropdown-item">My Account</a>
    <a href="/user/tickets" class="dropdown-item">My Tickets</a>
    <a href="/user/wishlist" class="dropdown-item">
        <i class="fi fi-rr-heart me-2" style="color:var(--primary);"></i>Wishlist
    </a>
    <a href="/user/wallet" class="dropdown-item">
        <i class="fi fi-rr-wallet me-2" style="color:#3498db;"></i>Wallet
    </a>
    <hr style="border-color: var(--border); margin: 4px 0;">
    <a id="userLogoutButton" class="dropdown-item text-danger" style="cursor: pointer;">Logout</a>
</div>