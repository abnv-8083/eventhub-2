<header class="navbar-sticky glass-dark">
    <div class="container nav-container">
        <a href="/admin/dashboard" class="logo">Event<span class="text-gradient">Hub Admin</span></a>
        <nav class="nav-links d-flex align-center gap-3">
            <a href="/admin/dashboard">Command Center</a>
            <button class="profile-avatar-btn" id="userMenuBtn">
                <span><%= admin.fullName.charAt(0).toUpperCase() %></span>
            </button>
            <div class="dropdown" id="notificationDropdown">
                <button class="nav-bell-btn position-relative" type="button" id="notificationBell" style="width: 45px; height: 45px;">
    
                    <img src="/images/notification.png" alt="Notifications" style="width: 24px; height: 24px; object-fit: contain;">
                    
                    <span id="notificationDot" class="position-absolute border border-2 border-dark rounded-circle bg-danger" 
                        style="display: none; width: 10px; height: 10px; top: 8px; right: 8px;">
                    </span>
                </button>
                
                <ul class="dropdown-menu dropdown-menu-end shadow-lg mt-3" id="notifMenuUI">
                    <div class="notif-header">
                        <h6 class="m-0 text-white fw-bold" style="font-size: 0.95rem;">Notifications</h6>
                        <button class="btn btn-link btn-sm text-dim p-0 text-decoration-none x-small" id="clearAllNotifications">Mark all read</button>
                    </div>
                    
                    <div id="notificationList" style="max-height: 380px; overflow-y: auto;">
                        <div class="p-5 text-center text-dim" id="emptyNotificationMsg">
                            <i class="fi fi-rr-envelope-open d-block mb-2 opacity-50" style="font-size: 2rem;"></i>
                            <p class="small m-0">All caught up!</p>
                        </div>
                    </div>
                </ul>
            </div>
        </nav>
    </div>
</header>

<div class="dropdown-menu glass-dark" id="userDropdown" style="position: fixed; display: none; z-index: 9999;">
    <div class="dropdown-header">
        <small class="text-dim d-block">System Admin</small>
        <strong style="color: white;"><%= admin.fullName %></strong>
    </div>
    <a id="adminLogoutButton" class="dropdown-item text-danger" style="cursor: pointer;">Logout</a>
</div>