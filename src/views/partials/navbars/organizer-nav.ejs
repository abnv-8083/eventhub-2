<header class="navbar-sticky">
    <div class="nav-container container">
        <div style="display:flex; align-items:center; gap: 1rem;">
            <button class="mobile-menu-toggle" id="mobileSidebarToggle">
                <i class="fi fi-rr-menu-burger"></i>
            </button>
            <a href="/organizer/dashboard" class="logo" style="text-decoration:none;">Event<span>Hub</span>
                <span style="font-size:0.6rem;font-family:var(--font-body);font-weight:600;color:rgba(255,255,255,0.35);letter-spacing:0.12em;text-transform:uppercase;margin-left:6px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:4px;padding:2px 6px;-webkit-text-fill-color:rgba(255,255,255,0.35);">Organizer</span>
            </a>
        </div>

        <div style="display:flex;align-items:center;gap:10px;margin-left:auto;">
            <!-- Bell -->
            <div class="dropdown" id="notificationDropdown" style="position:relative;">
                <button class="nav-bell-btn" id="notificationBell" type="button" style="position:relative;">
                    <svg class="custom-nav-bell" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" style="width:20px;height:20px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
                    </svg>
                    <span id="notificationDot" style="display:none;position:absolute;top:2px;right:0px;width:7px;height:7px;border-radius:50%;background:#E63946;box-shadow:0 0 8px rgba(230,57,70,0.7);"></span>
                </button>
                <div class="dropdown-menu" id="notifMenuUI" style="position:absolute;top:calc(100% + 12px);right:0;flex-direction:column;">
                    <div class="notif-header" style="display:flex;align-items:center;justify-content:space-between;">
                        <h6 style="margin:0;font-size:0.88rem;font-weight:700;color:white;">Notifications</h6>
                        <button id="clearAllNotifications" style="background:none;border:none;color:rgba(255,255,255,0.4);font-size:0.75rem;cursor:pointer;padding:0;">Mark all read</button>
                    </div>
                    <div id="notificationList">
                        <div class="p-4 text-center" id="emptyNotificationMsg" style="color:rgba(255,255,255,0.35);">
                            <i class="fi fi-rr-envelope-open" style="display:block;font-size:1.6rem;margin-bottom:8px;opacity:0.4;"></i>
                            <p style="margin:0;font-size:0.82rem;">All caught up!</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Avatar -->
            <button class="profile-avatar-btn" id="userMenuBtn">
                <% if(organizer.avatar) { %>
                    <img src="<%= organizer.avatar %>" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">
                <% } else { %>
                    <span style="font-family:var(--font-display);font-size:0.85rem;font-weight:800;"><%= (organizer.organizationName || organizer.fullName).charAt(0).toUpperCase() %></span>
                <% } %>
            </button>
        </div>
    </div>
</header>

<!-- Organizer Dropdown -->
<div id="userDropdown" class="dropdown-menu" style="position:fixed;display:none;z-index:9999;flex-direction:column;">
    <div class="dropdown-header">
        <small class="text-dim">Organizer Portal</small>
        <strong style="color:white;font-size:0.92rem;"><%= organizer.organizationName || organizer.fullName %></strong>
    </div>
    <a href="/organizer/profile" class="dropdown-item"><i class="fi fi-rr-user" style="width:16px;opacity:0.6;"></i>My Profile</a>
    <a href="/organizer/events" class="dropdown-item"><i class="fi fi-rr-calendar-lines" style="width:16px;opacity:0.6;"></i>My Events</a>
    
    <% if (locals.user) { %>
    <div style="height:1px;background:rgba(255,255,255,0.06);margin:4px 0;"></div>
    <a href="/" class="dropdown-item"><i class="fi fi-rr-user" style="width:16px;color:#f1c40f;"></i>User Portal</a>
    <% } %>

    <% if (locals.admin) { %>
    <div style="height:1px;background:rgba(255,255,255,0.06);margin:4px 0;"></div>
    <a href="/admin/dashboard" class="dropdown-item"><i class="fi fi-rr-shield" style="width:16px;color:#e74c3c;"></i>Admin Dashboard</a>
    <% } %>

    <div style="height:1px;background:rgba(255,255,255,0.06);margin:4px 0;"></div>
    <a id="organizerLogoutButton" class="dropdown-item text-danger" style="cursor:pointer;"><i class="fi fi-rr-exit" style="width:16px;"></i>Sign Out</a>
</div>
