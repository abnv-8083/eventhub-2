<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <title>Manage Categories | EventHub</title>
</head>
<body class="bg-mesh">
    
    <%- include('../../partials/navbars/admin-nav') %>

    <div class="dashboard-layout">
        <%- include('../../partials/admin-sidebar', { title: 'Categories' }) %>
        
        <main class="dashboard-main">
            <!-- Page Header -->
            <div class="mb-4 animate stagger-1">
                <h2 class="fw-bold">Manage Categories</h2>
                <p class="text-dim">Block specific categories to prevent organizers from using them for new events.</p>
            </div>

            <div class="glass-premium dynamic-card p-4 rounded-3 mb-4 animate stagger-2">
                <form id="categoriesForm" novalidate>
                    <h5 class="fw-bold mb-3">Event Categories</h5>
                    <p class="text-dim small mb-4">Select the categories you wish to block.</p>
                    
                    <div class="row g-3 mb-4">
                        <% categories.forEach(cat => { %>
                            <div class="col-md-6 col-lg-4">
                                <div class="form-check modern-checkbox">
                                    <input class="form-check-input" type="checkbox" name="blockedCategories" value="<%= cat.id %>" id="cat_<%= cat.id %>" <%= blockedCategories.includes(cat.id) ? 'checked' : '' %>>
                                    <label class="form-check-label d-flex align-items-center gap-2" for="cat_<%= cat.id %>" style="cursor:pointer; color:var(--text-dim);">
                                        <i class="fi <%= cat.icon %> text-primary"></i> <%= cat.name %>
                                    </label>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary px-5">Save Category Blocks</button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById('categoriesForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const btn = form.querySelector('button[type="submit"]');
            
            const originalText = btn.innerText;
            btn.innerText = 'Saving...';
            btn.disabled = true;

            const formData = new FormData(form);
            const data = {
                blockedCategories: formData.getAll('blockedCategories')
            };

            try {
                const response = await axios.post('/admin/categories/block', data);
                if (response.data.success) {
                    Toast.success(response.data.message);
                }
            } catch (error) {
                Toast.error(error.response?.data?.message || 'Failed to update categories.');
            } finally {
                btn.innerText = originalText;
                btn.disabled = false;
            }
        });
    </script>
</body>
</html>
