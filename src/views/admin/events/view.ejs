<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <title>Review Event | EventHub Admin</title>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/admin-nav') %>
    <div class="dashboard-layout">
        <%
          function formatTime12(time24) {
              if (!time24) return '';
              let [h, m] = time24.split(':');
              h = parseInt(h);
              const ampm = h >= 12 ? 'PM' : 'AM';
              h = h % 12 || 12;
              return `${h}:${m} ${ampm}`;
          }
        %>
        <style>
            /* Admin Event View Styles */
            .ev-review-hero { position: relative; height: 320px; border-radius: 20px; overflow: hidden; margin-bottom: 1.5rem; background: #111; border: 1px solid rgba(255,255,255,0.05); }
            .ev-review-hero-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; }
            .ev-review-hero-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at center, #1a1a1a, #0a0a0a); }
            .ev-review-hero-overlay { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.1) 100%); padding: 2.5rem; display: flex; flex-direction: column; justify-content: flex-end; }
            
            .ev-detail-card { background: linear-gradient(145deg, rgba(30,30,30,0.6), rgba(20,20,20,0.8)); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; padding: 1.5rem; backdrop-filter: blur(10px); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
            .ev-detail-card-title { font-size: 1.1rem; font-weight: 700; color: white; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
            .ev-detail-card-title i { color: var(--primary); }
            
            .ev-detail-row { display: flex; flex-direction: column; gap: 1rem; }
            .ev-detail-item { display: flex; align-items: flex-start; gap: 1rem; }
            .ev-detail-item-icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; color: var(--primary); flex-shrink: 0; }
            .ev-detail-label { font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: rgba(255,255,255,0.4); margin-bottom: 2px; }
            .ev-detail-value { font-size: 0.95rem; color: white; }
            
            .ev-map-preview { height: 200px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); margin-top: 1.5rem; background: #000; overflow: hidden; z-index: 1; }
            
            .ev-org-avatar { width: 48px; height: 48px; border-radius: 12px; object-fit: cover; }
            .ev-org-avatar-fallback { width: 48px; height: 48px; border-radius: 12px; background: rgba(var(--primary-rgb), 0.15); border: 1px solid rgba(var(--primary-rgb), 0.3); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
            
            .ev-description-text { color: rgba(255,255,255,0.7); font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; }
            
            .ev-ticket-card { background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.04); border-radius: 12px; padding: 1rem; display: flex; align-items: center; justify-content: space-between; transition: all 0.3s; }
            .ev-ticket-card:hover { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.1); }
            .ev-ticket-badge { width: 40px; height: 40px; border-radius: 8px; background: rgba(var(--primary-rgb), 0.15); color: var(--primary); font-weight: 800; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
            .ev-ticket-name { font-weight: 700; color: white; margin-bottom: 2px; }
            .ev-ticket-meta { font-size: 0.8rem; color: rgba(255,255,255,0.5); }
            .ev-ticket-price { font-weight: 800; font-size: 1.1rem; color: #2ecc71; }
            .ev-ticket-price.free { color: #f39c12; }
            
            .ev-banner-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1rem; }
            .ev-banner-thumb { aspect-ratio: 16/9; border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); cursor: pointer; position: relative; }
            .ev-banner-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
            .ev-banner-thumb:hover img { transform: scale(1.05); }
            .ev-banner-thumb::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.3); opacity: 0; transition: opacity 0.3s; }
            .ev-banner-thumb:hover::after { opacity: 1; }
            
            .ev-action-bar { position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%); width: 90%; max-width: 800px; background: rgba(20,20,20,0.85); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.05) inset; padding: 1.25rem 2rem; z-index: 1000; animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards; animation-delay: 0.4s; }
            @keyframes slideUp { from { transform: translate(-50%, 100px); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }
            .ev-action-bar-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
            
            .ev-lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.95); z-index: 99999; align-items: center; justify-content: center; backdrop-filter: blur(10px); }
            .ev-lightbox.active { display: flex; }
            .ev-lightbox-img { max-width: 90vw; max-height: 85vh; border-radius: 12px; box-shadow: 0 30px 60px rgba(0,0,0,0.5); object-fit: contain; }
            .ev-lightbox-close { position: absolute; top: 2rem; right: 2rem; width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; color: white; cursor: pointer; font-size: 1.2rem; transition: background 0.3s; }
            .ev-lightbox-close:hover { background: rgba(255,255,255,0.2); }
        </style>
        <%- include('../../partials/admin-sidebar', { title: 'Manage Events' }) %>

        <main class="dashboard-main">

            <!-- ── Page Header ──────────────────────────────────────────── -->
            <div class="d-flex align-items-center gap-3 mb-4 animate stagger-1" style="flex-wrap: wrap;">
                <a href="/admin/events" class="btn btn-outline btn-sm px-3 flex-shrink-0" style="border-radius: 10px; height: 38px; line-height: 38px; padding-top: 0; padding-bottom: 0;">
                    <i class="fi fi-rr-arrow-left me-1"></i> Back
                </a>
                <div style="min-width: 0;">
                    <h2 class="fw-bold m-0" style="letter-spacing: -0.5px; font-size: clamp(1.1rem, 3.5vw, 1.55rem); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        Event Review
                    </h2>
                    <p class="text-dim m-0 small">Inspect all details before making a decision.</p>
                </div>
                <div class="ms-auto flex-shrink-0">
                    <% if(event.status === 'pending') { %>
                        <span class="status-badge status-pending"><i class="fi fi-rr-clock me-1"></i>Awaiting Review</span>
                    <% } else if(event.status === 'approved') { %>
                        <span class="status-badge status-approved"><i class="fi fi-rr-check me-1"></i>Approved</span>
                    <% } else { %>
                        <span class="status-badge status-rejected"><i class="fi fi-rr-cross me-1"></i>Rejected</span>
                    <% } %>
                </div>
            </div>

            <!-- ── Hero Banner ──────────────────────────────────────────── -->
            <div class="ev-review-hero animate stagger-2">
                <% if(event.banners && event.banners.length > 0) { %>
                    <img class="ev-review-hero-img" src="<%= event.banners[0] %>" alt="<%= event.title %>">
                <% } else { %>
                    <div class="ev-review-hero-fallback">
                        <i class="fi fi-rr-picture" style="font-size: 4rem; color: rgba(255,255,255,0.08);"></i>
                    </div>
                <% } %>
                <div class="ev-review-hero-overlay">
                    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--primary); margin-bottom: 6px;">
                        <%= event.category ? event.category.name : 'Uncategorised' %>
                    </div>
                    <h1 class="fw-bold m-0" style="font-size: clamp(1.3rem, 4vw, 2rem); color: white; line-height: 1.25;">
                        <%= event.title %>
                    </h1>
                    <% if(event.isFeatured) { %>
                    <div class="mt-2">
                        <span style="background: rgba(243,156,18,0.15); border: 1px solid rgba(243,156,18,0.35); color: #f39c12; border-radius: 100px; padding: 3px 12px; font-size: 0.73rem; font-weight: 700;">
                            <i class="fi fi-rr-star me-1"></i>Featured Event
                        </span>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- ── Row 1: Event Basics & Organizer ───────────────────────── -->
            <div class="row g-4 mb-4 animate stagger-3">
                <!-- Event Basics & Meta -->
                <div class="col-lg-6 d-flex flex-column">
                    <div class="ev-detail-card flex-grow-1">
                        <div class="ev-detail-card-title">
                            <i class="fi fi-rr-info"></i> Event Overview &amp; Meta
                        </div>
                        <div class="ev-detail-row">
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-category"></i></div>
                                <div>
                                    <div class="ev-detail-label">Category &amp; Subcategory</div>
                                    <div class="ev-detail-value">
                                        <strong><%= typeof event.category === 'object' && event.category ? event.category.name : (event.category || 'Uncategorised') %></strong>
                                        <%= event.subcategory ? ' · ' + event.subcategory : '' %>
                                    </div>
                                </div>
                            </div>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-language"></i></div>
                                <div>
                                    <div class="ev-detail-label">Language &amp; Age Restriction</div>
                                    <div class="ev-detail-value">
                                        <%= event.language || 'English' %> &nbsp;·&nbsp;
                                        <span class="badge bg-secondary"><%= event.ageRestriction || 'All Ages' %></span>
                                    </div>
                                </div>
                            </div>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-eye"></i></div>
                                <div>
                                    <div class="ev-detail-label">Visibility</div>
                                    <div class="ev-detail-value">
                                        <span class="badge <%= event.visibility === 'public' ? 'bg-success' : 'bg-warning text-dark' %>">
                                            <%= event.visibility ? event.visibility.toUpperCase() : 'PUBLIC' %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-tags"></i></div>
                                <div>
                                    <div class="ev-detail-label">Tags</div>
                                    <div class="ev-detail-value">
                                        <% if (event.tags && event.tags.length > 0) { %>
                                            <% event.tags.forEach(tag => { %>
                                                <span class="badge bg-dark border border-secondary me-1 mb-1"><%= tag %></span>
                                            <% }) %>
                                        <% } else { %>
                                            <span class="text-dim small">No tags defined</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-document-signed"></i></div>
                                <div>
                                    <div class="ev-detail-label">Short Summary</div>
                                    <div class="ev-detail-value small text-light"><%= event.shortSummary || 'No short summary provided.' %></div>
                                </div>
                            </div>
                            <% if (event.postStartRegistrationLimit !== null && event.postStartRegistrationLimit !== undefined) { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-alarm-clock"></i></div>
                                <div>
                                    <div class="ev-detail-label">Late Registration Limit</div>
                                    <div class="ev-detail-value"><%= event.postStartRegistrationLimit %> minutes after start</div>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Organizer & Brand Info -->
                <div class="col-lg-6 d-flex flex-column">
                    <div class="ev-detail-card flex-grow-1">
                        <div class="ev-detail-card-title">
                            <i class="fi fi-rr-building"></i> Organizer &amp; Brand
                        </div>
                        <!-- Organizer identity -->
                        <div class="d-flex align-items-center gap-3 mb-4 pb-4" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <% if(event.organizer.avatar) { %>
                                <img class="ev-org-avatar" src="<%= event.organizer.avatar %>" alt="<%= event.organizer.fullName %>">
                            <% } else { %>
                                <div class="ev-org-avatar-fallback"><i class="fi fi-rr-user"></i></div>
                            <% } %>
                            <div style="min-width: 0;">
                                <div class="fw-bold text-truncate" style="color: white; font-size: 0.98rem;"><%= event.organizer.fullName %></div>
                                <% if(event.organizer.organizationName) { %>
                                    <div class="text-dim small text-truncate"><%= event.organizer.organizationName %></div>
                                <% } %>
                            </div>
                        </div>
                        <div class="ev-detail-row">
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-envelope"></i></div>
                                <div style="min-width: 0;">
                                    <div class="ev-detail-label">Email</div>
                                    <div class="ev-detail-value" style="word-break: break-all;"><%= event.organizer.email %></div>
                                </div>
                            </div>
                            <% if(event.organizer.phone) { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-phone-call"></i></div>
                                <div>
                                    <div class="ev-detail-label">Phone</div>
                                    <div class="ev-detail-value"><%= event.organizer.phone %></div>
                                </div>
                            </div>
                            <% } %>
                            <% if(event.organizer.city) { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-city"></i></div>
                                <div>
                                    <div class="ev-detail-label">City</div>
                                    <div class="ev-detail-value"><%= event.organizer.city %></div>
                                </div>
                            </div>
                            <% } %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-time-add"></i></div>
                                <div>
                                    <div class="ev-detail-label">Submitted</div>
                                    <div class="ev-detail-value">
                                        <%= new Date(event.createdAt).toLocaleString('en-IN', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                                    </div>
                                </div>
                            </div>
                            <% if (event.organizerInfo && (event.organizerInfo.name || event.organizerInfo.supportEmail || event.organizerInfo.website || event.organizerInfo.supportPhone)) { %>
                            <div class="mt-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                                <div class="ev-detail-label mb-2" style="color: var(--primary);">Brand Override / Support Contact</div>
                                <div class="small text-light">
                                    <% if (event.organizerInfo.name) { %><div><strong>Brand:</strong> <%= event.organizerInfo.name %></div><% } %>
                                    <% if (event.organizerInfo.supportEmail) { %><div><strong>Support Email:</strong> <%= event.organizerInfo.supportEmail %></div><% } %>
                                    <% if (event.organizerInfo.supportPhone) { %><div><strong>Support Phone:</strong> <%= event.organizerInfo.supportPhone %></div><% } %>
                                    <% if (event.organizerInfo.website) { %><div><strong>Website:</strong> <a href="<%= event.organizerInfo.website %>" target="_blank" class="text-primary"><%= event.organizerInfo.website %></a></div><% } %>
                                    <% if (event.organizerInfo.instagram || event.organizerInfo.facebook || event.organizerInfo.twitter) { %>
                                    <div class="mt-1 d-flex gap-2">
                                        <% if (event.organizerInfo.instagram) { %><a href="<%= event.organizerInfo.instagram %>" target="_blank" class="text-secondary"><i class="fi fi-brands-instagram"></i></a><% } %>
                                        <% if (event.organizerInfo.facebook) { %><a href="<%= event.organizerInfo.facebook %>" target="_blank" class="text-secondary"><i class="fi fi-brands-facebook"></i></a><% } %>
                                        <% if (event.organizerInfo.twitter) { %><a href="<%= event.organizerInfo.twitter %>" target="_blank" class="text-secondary"><i class="fi fi-brands-twitter"></i></a><% } %>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Row 2: Schedule & Timings + Venue & Location ─────────── -->
            <div class="row g-4 mb-4 animate stagger-3">
                <!-- Schedule & Timings -->
                <div class="col-lg-6 d-flex flex-column">
                    <div class="ev-detail-card flex-grow-1">
                        <div class="ev-detail-card-title">
                            <i class="fi fi-rr-calendar-clock"></i> Schedule &amp; Timings
                        </div>
                        <div class="ev-detail-row">
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-play"></i></div>
                                <div>
                                    <div class="ev-detail-label">Starts</div>
                                    <div class="ev-detail-value">
                                        <%= event.startDate ? new Date(event.startDate).toLocaleDateString(undefined, { weekday:'short', day:'numeric', month:'long', year:'numeric' }) : 'N/A' %>
                                        &nbsp;·&nbsp;<strong><%= formatTime12(event.startTime) %></strong>
                                    </div>
                                </div>
                            </div>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-flag-checkered"></i></div>
                                <div>
                                    <div class="ev-detail-label">Ends</div>
                                    <div class="ev-detail-value">
                                        <%= event.endDate ? new Date(event.endDate).toLocaleDateString(undefined, { weekday:'short', day:'numeric', month:'long', year:'numeric' }) : 'N/A' %>
                                        &nbsp;·&nbsp;<strong><%= formatTime12(event.endTime) %></strong>
                                    </div>
                                </div>
                            </div>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-door-open"></i></div>
                                <div>
                                    <div class="ev-detail-label">Doors Open &amp; Booking Windows</div>
                                    <div class="ev-detail-value small">
                                        <div><strong>Doors Open:</strong> <%= event.doorsOpenTime ? formatTime12(event.doorsOpenTime) : 'Not specified' %></div>
                                        <div><strong>Booking Opens:</strong> <%= event.bookingOpenTime ? formatTime12(event.bookingOpenTime) : 'Immediate' %></div>
                                        <div><strong>Booking Closes:</strong> <%= event.bookingCloseTime ? formatTime12(event.bookingCloseTime) : 'At Event End' %></div>
                                    </div>
                                </div>
                            </div>
                            <% if (event.schedule && event.schedule.length > 0) { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-list-check"></i></div>
                                <div>
                                    <div class="ev-detail-label">Additional Day Schedules (<%= event.schedule.length %>)</div>
                                    <div class="ev-detail-value small">
                                        <% event.schedule.forEach((slot, idx) => { %>
                                            <div class="mb-1 pb-1" style="border-bottom: 1px dashed rgba(255,255,255,0.05);">
                                                <strong>Day <%= idx + 2 %>:</strong> <%= slot.date ? new Date(slot.date).toLocaleDateString() : 'N/A' %>
                                                (<%= formatTime12(slot.startTime) %> - <%= formatTime12(slot.endTime) %>)
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Venue & Location -->
                <div class="col-lg-6 d-flex flex-column">
                    <div class="ev-detail-card flex-grow-1">
                        <div class="ev-detail-card-title">
                            <i class="fi fi-rr-marker"></i> Venue &amp; Location
                        </div>
                        <div class="ev-detail-row">
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-globe"></i></div>
                                <div>
                                    <div class="ev-detail-label">Event Type</div>
                                    <div class="ev-detail-value">
                                        <% if (event.location?.isOnline) { %>
                                            <span class="badge bg-info text-dark">🌐 Online Event (<%= event.location.onlinePlatform || 'Custom Link' %>)</span>
                                        <% } else { %>
                                            <span class="badge bg-primary">🏢 Offline Physical Venue</span>
                                            <% if (event.venueLayout) { %>
                                                <span class="badge bg-dark border border-secondary ms-1">Layout: <%= event.venueLayout.toUpperCase() %></span>
                                            <% } %>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <% if (event.location?.isOnline) { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-link"></i></div>
                                <div>
                                    <div class="ev-detail-label">Stream URL</div>
                                    <div class="ev-detail-value">
                                        <% if (event.location.onlineLink) { %>
                                            <a href="<%= event.location.onlineLink %>" target="_blank" class="text-primary"><%= event.location.onlineLink %></a>
                                        <% } else { %>
                                            <span class="text-dim small">Link will be provided by organizer</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <% } else { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-map-marker-home"></i></div>
                                <div>
                                    <div class="ev-detail-label">Venue Address</div>
                                    <div class="ev-detail-value">
                                        <strong><%= event.location?.venueName || '' %></strong><br>
                                        <%= event.location?.address || '' %><br>
                                        <% if (event.location?.landmark) { %><span class="text-dim small">Landmark: <%= event.location.landmark %></span><br><% } %>
                                        <%= event.location?.city || '' %>, <%= event.location?.state || '' %> - <strong><%= event.location?.pincode || '' %></strong>
                                    </div>
                                </div>
                            </div>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-sparkles"></i></div>
                                <div>
                                    <div class="ev-detail-label">Amenities</div>
                                    <div class="ev-detail-value d-flex gap-2">
                                        <span class="badge <%= event.location?.parkingAvailable ? 'bg-success' : 'bg-dark text-secondary border' %>">🚗 Parking: <%= event.location?.parkingAvailable ? 'Yes' : 'No' %></span>
                                        <span class="badge <%= event.location?.wheelchairAccessible ? 'bg-success' : 'bg-dark text-secondary border' %>">♿ Wheelchair: <%= event.location?.wheelchairAccessible ? 'Yes' : 'No' %></span>
                                    </div>
                                </div>
                            </div>
                            <!-- Mini Map -->
                            <div class="ev-map-preview" id="adminEventMap"></div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Row 3: Ticket Tiers ───────────────────────────────────── -->
            <div class="ev-detail-card mb-4 animate stagger-4">
                <div class="d-flex align-items-center justify-content-between mb-4" style="flex-wrap: wrap; gap: 0.5rem;">
                    <div class="ev-detail-card-title m-0">
                        <i class="fi fi-rr-ticket"></i> Ticket Tiers Configuration (<%= (event.tickets || []).length %>)
                    </div>
                    <span class="text-dim" style="font-size: 0.78rem;">
                        Total capacity: <strong style="color: rgba(255,255,255,0.6);"><%= (event.tickets || []).reduce((s, t) => s + t.capacity, 0).toLocaleString('en-IN') %></strong> seats
                    </span>
                </div>
                <% if(event.tickets && event.tickets.length > 0) { %>
                <div class="d-flex flex-column gap-3">
                    <% event.tickets.forEach((ticket, i) => { %>
                    <div class="ev-ticket-card d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="ev-ticket-badge" style="background: <%= ticket.colourBadge || '#E63946' %>33; color: <%= ticket.colourBadge || '#E63946' %>;">T<%= i + 1 %></div>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <span class="ev-ticket-name"><%= ticket.name %></span>
                                    <span class="badge bg-dark border border-secondary small"><%= ticket.seatType ? ticket.seatType.toUpperCase() : 'GENERAL' %></span>
                                    <% if (ticket.stadiumSide && ticket.stadiumSide !== 'general') { %>
                                        <span class="badge bg-info text-dark small">Side: <%= ticket.stadiumSide.toUpperCase() %></span>
                                    <% } %>
                                    <% if (ticket.refundable) { %>
                                        <span class="badge bg-success small">✅ Refundable</span>
                                    <% } %>
                                </div>
                                <div class="ev-ticket-meta mb-2">
                                    <i class="fi fi-rr-users me-1"></i>Capacity: <strong><%= ticket.capacity.toLocaleString('en-IN') %></strong> (Sold: <%= ticket.sold || 0 %>)
                                    &nbsp;&bull;&nbsp;
                                    <i class="fi fi-rr-user me-1"></i>Min/Max per user: <strong><%= ticket.minPerUser || 1 %> - <%= ticket.maxPerUser %></strong>
                                    <% if (ticket.saleStart || ticket.saleEnd) { %>
                                        &nbsp;&bull;&nbsp; <i class="fi fi-rr-calendar me-1"></i>Sale: <%= ticket.saleStart ? new Date(ticket.saleStart).toLocaleDateString() : 'Now' %> - <%= ticket.saleEnd ? new Date(ticket.saleEnd).toLocaleDateString() : 'Event End' %>
                                    <% } %>
                                </div>
                                <% if (ticket.description) { %>
                                    <div class="small text-light mb-2"><%= ticket.description %></div>
                                <% } %>
                                <% if (ticket.benefits && ticket.benefits.length > 0) { %>
                                    <div class="d-flex flex-wrap gap-1">
                                        <% ticket.benefits.forEach(b => { %>
                                            <span class="badge" style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.8); font-size: 0.72rem;">✨ <%= b %></span>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        <div class="ev-ticket-price ms-md-auto <%= ticket.price === 0 ? 'free' : '' %>">
                            <%= ticket.price === 0 ? 'FREE' : '₹' + ticket.price.toLocaleString('en-IN') %>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                <p class="text-dim m-0 small">No ticket tiers defined.</p>
                <% } %>
            </div>

            <!-- ── Row 4: Description & Rich Sections + Policies ─────────── -->
            <div class="row g-4 mb-4 animate stagger-4">
                <!-- Description & Rich Sections -->
                <div class="col-lg-6 d-flex flex-column">
                    <div class="ev-detail-card flex-grow-1">
                        <div class="ev-detail-card-title"><i class="fi fi-rr-document"></i> Description &amp; Event Details</div>
                        <div class="mb-4">
                            <div class="ev-detail-label mb-2">Main Description</div>
                            <p class="ev-description-text m-0"><%= event.description || 'No description provided.' %></p>
                        </div>
                        <% if (event.aboutEvent) { %>
                        <div class="mb-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <div class="ev-detail-label mb-1">About Event</div>
                            <div class="small text-light" style="white-space: pre-wrap;"><%= event.aboutEvent %></div>
                        </div>
                        <% } %>
                        <% if (event.agenda) { %>
                        <div class="mb-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <div class="ev-detail-label mb-1">Agenda / Schedule Breakdown</div>
                            <div class="small text-light" style="white-space: pre-wrap;"><%= event.agenda %></div>
                        </div>
                        <% } %>
                        <% if (event.artists) { %>
                        <div class="mb-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <div class="ev-detail-label mb-1">Artists / Performers</div>
                            <div class="small text-light" style="white-space: pre-wrap;"><%= event.artists %></div>
                        </div>
                        <% } %>
                        <% if (event.guests) { %>
                        <div class="mb-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <div class="ev-detail-label mb-1">Special Guests / Speakers</div>
                            <div class="small text-light" style="white-space: pre-wrap;"><%= event.guests %></div>
                        </div>
                        <% } %>
                        <% if (event.faqs) { %>
                        <div class="mb-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <div class="ev-detail-label mb-1">FAQs</div>
                            <div class="small text-light" style="white-space: pre-wrap;"><%= event.faqs %></div>
                        </div>
                        <% } %>
                        <% if (event.thingsToCarry || event.notAllowedItems) { %>
                        <div class="row g-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <% if (event.thingsToCarry) { %>
                            <div class="col-md-6">
                                <div class="ev-detail-label mb-1 text-success">✅ Things to Carry</div>
                                <div class="small text-light" style="white-space: pre-wrap;"><%= event.thingsToCarry %></div>
                            </div>
                            <% } %>
                            <% if (event.notAllowedItems) { %>
                            <div class="col-md-6">
                                <div class="ev-detail-label mb-1 text-danger">🚫 Prohibited Items</div>
                                <div class="small text-light" style="white-space: pre-wrap;"><%= event.notAllowedItems %></div>
                            </div>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Policies & Guidelines -->
                <div class="col-lg-6 d-flex flex-column">
                    <div class="ev-detail-card flex-grow-1">
                        <div class="ev-detail-card-title"><i class="fi fi-rr-shield-check"></i> Policies &amp; Guidelines</div>
                        <div class="ev-detail-row">
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-refresh"></i></div>
                                <div>
                                    <div class="ev-detail-label">Cancellation &amp; Refund Policy</div>
                                    <div class="ev-detail-value">
                                        <% if (event.policies?.cancellation === '100_before_48') { %>
                                            <span class="badge bg-success">✅ 100% Refund (Before 48h)</span>
                                        <% } else if (event.policies?.cancellation === 'partial') { %>
                                            <span class="badge bg-warning text-dark">⚠️ Partial Refund</span>
                                        <% } else { %>
                                            <span class="badge bg-danger">🚫 Non-Refundable</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-camera"></i></div>
                                <div>
                                    <div class="ev-detail-label">Photography Consent</div>
                                    <div class="ev-detail-value">
                                        <%= event.policies?.photographyConsent !== false ? '✅ Consent Granted / Permitted' : '❌ No Photography Permitted' %>
                                    </div>
                                </div>
                            </div>
                            <% if (event.policies?.terms) { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-file-check"></i></div>
                                <div>
                                    <div class="ev-detail-label">Terms &amp; Conditions</div>
                                    <div class="ev-detail-value small text-light" style="max-height: 100px; overflow-y: auto; white-space: pre-wrap;"><%= event.policies.terms %></div>
                                </div>
                            </div>
                            <% } %>
                            <% if (event.policies?.privacyPolicy) { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-lock"></i></div>
                                <div>
                                    <div class="ev-detail-label">Privacy Policy</div>
                                    <div class="ev-detail-value small text-light" style="max-height: 100px; overflow-y: auto; white-space: pre-wrap;"><%= event.policies.privacyPolicy %></div>
                                </div>
                            </div>
                            <% } %>
                            <% if (event.policies?.covidGuidelines) { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-shield-plus"></i></div>
                                <div>
                                    <div class="ev-detail-label">COVID / Health Guidelines</div>
                                    <div class="ev-detail-value small text-light"><%= event.policies.covidGuidelines %></div>
                                </div>
                            </div>
                            <% } %>
                            <% if (event.policies?.foodPolicy || event.policies?.parkingPolicy || event.policies?.childrenPolicy) { %>
                            <div class="ev-detail-item">
                                <div class="ev-detail-item-icon"><i class="fi fi-rr-info"></i></div>
                                <div>
                                    <div class="ev-detail-label">Other Facility Policies</div>
                                    <div class="ev-detail-value small text-light">
                                        <% if (event.policies.foodPolicy) { %><div><strong>Food:</strong> <%= event.policies.foodPolicy %></div><% } %>
                                        <% if (event.policies.parkingPolicy) { %><div><strong>Parking:</strong> <%= event.policies.parkingPolicy %></div><% } %>
                                        <% if (event.policies.childrenPolicy) { %><div><strong>Children:</strong> <%= event.policies.childrenPolicy %></div><% } %>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Row 5: Media, Banners & Gallery ───────────────────────── -->
            <div class="ev-detail-card mb-4 animate stagger-4">
                <div class="ev-detail-card-title"><i class="fi fi-rr-picture"></i> Media, Banners &amp; Gallery</div>
                <div class="row g-4">
                    <% if(event.banners && event.banners.length > 0) { %>
                    <div class="col-md-6">
                        <div class="ev-detail-label mb-2">Main Banners (<%= event.banners.length %>)</div>
                        <div class="ev-banner-grid">
                            <% event.banners.forEach((banner, i) => { %>
                            <div class="ev-banner-thumb" onclick="openLightbox('<%= banner %>')" title="Click to enlarge">
                                <img src="<%= banner %>" alt="Banner <%= i + 1 %>">
                            </div>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>
                    <% if(event.galleryImages && event.galleryImages.length > 0) { %>
                    <div class="col-md-6">
                        <div class="ev-detail-label mb-2">Gallery Images (<%= event.galleryImages.length %>)</div>
                        <div class="ev-banner-grid">
                            <% event.galleryImages.forEach((img, i) => { %>
                            <div class="ev-banner-thumb" onclick="openLightbox('<%= img %>')" title="Click to enlarge">
                                <img src="<%= img %>" alt="Gallery <%= i + 1 %>">
                            </div>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>
                    <% if(event.promoVideo) { %>
                    <div class="col-12 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
                        <div class="ev-detail-label mb-2">Promo Video</div>
                        <a href="<%= event.promoVideo %>" target="_blank" class="btn btn-outline-light btn-sm"><i class="fi fi-rr-play-alt me-2"></i>Watch Promo Video</a>
                    </div>
                    <% } %>
                    <% if ((!event.banners || event.banners.length === 0) && (!event.galleryImages || event.galleryImages.length === 0) && !event.promoVideo) { %>
                    <div class="col-12"><p class="text-dim m-0 small">No media files or banners uploaded.</p></div>
                    <% } %>
                </div>
                <p class="text-dim small mt-3 mb-0"><i class="fi fi-rr-zoom-in me-1"></i>Click any image to view full size.</p>
            </div>

            <!-- ── Sticky Action Bar ────────────────────────────────────── -->
            <div class="ev-action-bar animate stagger-4">
                <div class="ev-action-bar-inner">
                    <div>
                        <% if(event.status === 'pending') { %>
                            <p class="fw-bold m-0" style="color: white; font-size: 0.95rem;">Ready to decide?</p>
                            <p class="text-dim m-0 small">The organizer will be notified immediately after your decision.</p>
                        <% } else { %>
                            <p class="fw-bold m-0" style="color: white; font-size: 0.95rem;">Event already processed</p>
                            <p class="text-dim m-0 small">
                                Current status:
                                <strong style="color: <%= event.status === 'approved' ? '#2ecc71' : '#E63946' %>;">
                                    <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
                                </strong>. You can still change this decision.
                            </p>
                        <% } %>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        <% if(event.status !== 'rejected') { %>
                        <button id="rejectBtn" class="btn btn-outline px-4" style="border-radius: 10px; height: 42px; border-color: rgba(230,57,70,0.45) !important; color: #E63946 !important; font-weight: 600;">
                            <i class="fi fi-rr-cross me-2"></i><%= event.status === 'approved' ? 'Revoke & Reject' : 'Reject' %>
                        </button>
                        <% } %>
                        <% if(event.status !== 'approved') { %>
                        <button id="approveBtn" class="btn btn-primary px-4" style="border-radius: 10px; height: 42px; font-weight: 700;">
                            <i class="fi fi-rr-check me-2"></i><%= event.status === 'rejected' ? 'Re-approve' : 'Approve Event' %>
                        </button>
                        <% } %>
                        <% if(event.status === 'approved') { %>
                        <button onclick="toggleEventBlock('<%= event._id %>', '<%= event.isBlocked ? 'unblock' : 'block' %>')" class="btn <%= event.isBlocked ? 'btn-outline' : 'btn-outline border-danger text-danger' %> px-4" style="border-radius: 10px; height: 42px; font-weight: 700;">
                            <i class="fi <%= event.isBlocked ? 'fi-rr-check' : 'fi-rr-ban' %> me-2"></i><%= event.isBlocked ? 'Unblock Event' : 'Block Event' %>
                        </button>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Bottom spacer so sticky bar doesn't clip content -->
            <div style="height: 4rem;"></div>

        </main>
    </div>

    <!-- Lightbox -->
    <div class="ev-lightbox" id="evLightbox" onclick="closeLightbox()">
        <div class="ev-lightbox-close" onclick="closeLightbox()">
            <i class="fi fi-rr-cross-small"></i>
        </div>
        <img class="ev-lightbox-img" id="evLightboxImg" src="" alt="Banner preview">
    </div>

    <script>
        // ── Mini Map (read-only) ────────────────────────────────────────────────
        const isOnlineEvent = <%= event.location?.isOnline ? 'true' : 'false' %>;
        const eventLat = <%= event.location?.lat || 0 %>;
        const eventLng = <%= event.location?.lng || 0 %>;

        if (!isOnlineEvent && eventLat && eventLng && document.getElementById('adminEventMap')) {
            const map = L.map('adminEventMap', {
                zoomControl: false,
                scrollWheelZoom: false,
                dragging: false,
                doubleClickZoom: false,
                boxZoom: false,
                keyboard: false,
                touchZoom: false
            }).setView([eventLat, eventLng], 15);

            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',
                subdomains: 'abcd',
                maxZoom: 20
            }).addTo(map);

            const pinIcon = L.divIcon({
                className: '',
                html: `<div style="
                    width: 28px; height: 28px;
                    border-radius: 50% 50% 50% 0;
                    background: var(--primary);
                    transform: rotate(-45deg);
                    border: 2px solid rgba(255,255,255,0.9);
                    box-shadow: 0 4px 14px rgba(230,57,70,0.55);
                "></div>`,
                iconSize: [28, 28],
                iconAnchor: [14, 28]
            });
            L.marker([eventLat, eventLng], { icon: pinIcon }).addTo(map);

            setTimeout(() => map.invalidateSize(), 250);
        }

        // ── Lightbox ───────────────────────────────────────────────────────────
        function openLightbox(src) {
            const lb  = document.getElementById('evLightbox');
            const img = document.getElementById('evLightboxImg');
            img.src = src;
            lb.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        function closeLightbox() {
            const lb  = document.getElementById('evLightbox');
            const img = document.getElementById('evLightboxImg');
            lb.classList.remove('active');
            img.src = '';
            document.body.style.overflow = '';
        }
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });

        // ── Approve / Reject ───────────────────────────────────────────────────
        const eventId = '<%= event._id %>';

        async function updateStatus(status) {
            const label = status === 'approved' ? 'Approve' : 'Reject';
            const confirmed = await CustomConfirm.show({
                title: `${label} Event?`,
                message: `Are you sure you want to ${status} "<%= event.title %>"? The organizer will be notified right away.`,
                confirmText: `Yes, ${label}`,
                actionType: status === 'approved' ? 'primary' : 'danger',
                icon: status === 'approved' ? 'fi-rr-check' : 'fi-rr-cross'
            });
            if (!confirmed) return;

            Loader.show('PROCESSING...');
            try {
                const res = await axios.post('/admin/events/update-status', { eventId, status });
                if (res.data.success) {
                    Toast.success(res.data.message);
                    setTimeout(() => window.location.reload(), 1200);
                }
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to update event status');
            } finally {
                Loader.hide();
            }
        }

        async function toggleEventBlock(eventId, action) {
            if (action === 'block') {
                const isConfirmed = await CustomConfirm.show({
                    title: "Block Event?",
                    message: "This event will be removed from public view and users will not be able to book it.",
                    confirmText: "Block Event",
                    actionType: "danger",
                    icon: "fi-rr-ban"
                });
                if (!isConfirmed) return;
            }

            Loader.show(action === 'block' ? 'BLOCKING EVENT...' : 'UNBLOCKING EVENT...');
            try {
                const response = await axios.post('/admin/events/toggle-block', { eventId });
                if (response.data.success) {
                    Toast.success(response.data.message);
                    setTimeout(() => location.reload(), 1000);
                }
            } catch (error) {
                Toast.error(error.response?.data?.message || `Failed to ${action} event.`);
            } finally {
                Loader.hide();
            }
        }

        document.getElementById('approveBtn')?.addEventListener('click', () => updateStatus('approved'));
        document.getElementById('rejectBtn')?.addEventListener('click',  () => updateStatus('rejected'));
    </script>
</body>
</html>
