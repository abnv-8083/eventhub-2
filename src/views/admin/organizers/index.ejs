<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <title>Manage Organizers | EventHub Admin</title>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/admin-nav') %>
    <div class="dashboard-layout">
        <%- include('../../partials/admin-sidebar', { title: 'Manage Organizers' }) %>
        
        <main class="dashboard-main">
            <div class="mb-5 animate stagger-1">
                <h2 class="fw-bold">Event Organizers</h2>
                <p class="text-dim m-0">Manage organizations and professional hosts.</p>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 gap-3 animate stagger-2">
                <div class="search-wrapper flex-grow-1" style="position: relative; max-width: 400px;">
                    <i class="fi fi-rr-search text-dim" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%);"></i>
                    <input type="text" id="orgSearch" class="input ps-5" placeholder="Search organization or email..." 
                           value="<%= filters.search %>" style="height: 45px;">
                </div>
                
                <div class="d-flex gap-2">
                    <select id="statusFilter" class="input px-3">
                        <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Status</option>
                        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                        <option value="blocked" <%= filters.status === 'blocked' ? 'selected' : '' %>>Banned</option>
                        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                        <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                        <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                    </select>

                    <select id="orgSort" class="input px-3">
                        <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest Joined</option>
                        <option value="name-asc" <%= filters.sort === 'name-asc' ? 'selected' : '' %>>Name (A-Z)</option>
                    </select>

                    <button type="button" id="clearFilters" class="action-btn" title="Clear Filters" style="height: 45px; width: 45px;">
                        <i class="fi fi-rr-refresh"></i>
                    </button>

                    <button type="button" onclick="applyFilters()" class="btn btn-primary" style="height: 45px; padding: 0 20px;">
                        Apply
                    </button>
                </div>
            </div>

            <div class="glass-premium dynamic-card p-4 rounded-3 animate stagger-3">
                <div style="overflow-x: auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Organization</th>
                                <th>Contact</th>
                                <th>Joined</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (organizers && organizers.length > 0) { %>
                                <% organizers.forEach(org => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-center gap-3">
                                                <div class="org-avatar">
                                                    <%= org.organizationName ? org.organizationName.charAt(0).toUpperCase() : 'O' %>
                                                </div>
                                                <div>
                                                    <strong class="text-white"><%= org.organizationName || org.fullName %></strong>
                                                    <p class="text-dim m-0 small">ID: <%= org._id.toString().substring(0,8) %>...</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-white"><%= org.email %></span><br>
                                            <span class="text-dim small"><%= org.phone || 'No phone' %></span>
                                        </td>
                                        <td class="text-dim">
                                            <%= new Date(org.createdAt).toLocaleDateString() %>
                                        </td>
                                        <td>
                                            <% if (!org.isBlocked) { %>
                                                <span class="status-badge status-approved">Active</span>
                                            <% } else { %>
                                                <span class="status-badge status-rejected">Banned</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a href="/admin/organizers/<%= org._id %>" class="action-btn icon-only" title="View Details">
                                                    <i class="fi fi-rr-eye"></i>
                                                </a>
                                                <% if(org.status == 'pending'){ %>
                                                    <button onclick="approveOrganizer('<%= org._id %>')" class="action-btn action-btn-unblock icon-only">
                                                        <i class="fi fi-rr-check"></i>
                                                    </button>
                                                    <button onclick="rejectOrganizer('<%= org._id %>')" class="action-btn action-btn-delete icon-only">
                                                        <i class="fi fi-rr-cross"></i>
                                                    </button>
                                                <% }else{ %>
                                                    <button onclick="confirmDeleteUser('<%= org._id %>', this)" class="action-btn action-btn-delete icon-only">
                                                        <i class="fi fi-rr-trash"></i>
                                                    </button>
                                                    <button onclick="toggleBlockStatus('<%= org._id %>', '<%= org.isBlocked ? 'unblock' : 'block' %>', this)" 
                                                            class="action-btn <%= org.isBlocked ? 'action-btn-unblock' : 'action-btn-block' %>">
                                                        <i class="fi <%= org.isBlocked ? 'fi-rr-check' : 'fi-rr-ban' %>"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center p-5">
                                        <p class="text-muted m-0">No Organizer found.</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 px-3">
                <p class="text-dim mb-0">Page <%= currentPage %> of <%= totalPages %></p>
                <div class="pagination d-flex gap-2">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <button class="action-btn <%= i == currentPage ? 'active-page' : '' %>" onclick="changePage(<%= i %>)">
                            <%= i %>
                        </button>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Use the exact same global functions you used for users
        function applyFilters() {
            const search = document.getElementById('orgSearch').value.trim();
            const status = document.getElementById('statusFilter').value;
            const sort = document.getElementById('orgSort').value;
            const url = new URL(window.location.href);
            
            if (search) url.searchParams.set('search', search); else url.searchParams.delete('search');
            url.searchParams.set('status', status);
            url.searchParams.set('sort', sort);
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        }

        function changePage(page) {
            const url = new URL(window.location.href);
            url.searchParams.set('page', page);
            window.location.href = url.toString();
        }

        document.getElementById('clearFilters').onclick = () => window.location.href = window.location.pathname;

        // --- 2. ADMIN ACTIONS (Block/Delete) ---

        async function toggleBlockStatus(userId, action, btnElement) {
            if (action === 'block') {
                const isConfirmed = await CustomConfirm.show({
                    title: "Block Organizer?",
                    message: "This user will lose all access to the platform immediately.",
                    confirmText: "Block Organizer",
                    actionType: "danger",
                    icon: "fi-rr-ban"
                });
                if (!isConfirmed) return;
            }

            Loader.show(action === 'block' ? 'BLOCKING ORGANIZER...' : 'UNBLOCKING ORGANIZER...');
            try {
                const response = await axios.post('/admin/organizers/toggle-block', { orgId: userId });
                if (response.data.success) {
                    Toast.success(response.data.message);
                    const row = btnElement.closest('tr');
                    const statusBadge = row.querySelector('.status-badge');

                    if (action === 'block') {
                        statusBadge.className = 'status-badge status-rejected';
                        statusBadge.innerHTML = '<i class="fi fi-rr-ban"></i>';
                        btnElement.className = 'action-btn action-btn-unblock';
                        btnElement.title = 'Unblock User';
                        btnElement.setAttribute('onclick', `toggleBlockStatus('${userId}', 'unblock', this)`);
                        btnElement.innerHTML = '<i class="fi fi-rr-check"></i>';
                    } else {
                        statusBadge.className = 'status-badge status-approved';
                        statusBadge.innerHTML = '<i class="fi fi-rr-check-circle"></i> Active';
                        btnElement.className = 'action-btn action-btn-block';
                        btnElement.title = 'Block User';
                        btnElement.setAttribute('onclick', `toggleBlockStatus('${userId}', 'block', this)`);
                        btnElement.innerHTML = '<i class="fi fi-rr-ban"></i>';
                    }
                }
            } catch (error) {
                Toast.error(error.response?.data?.message || `Failed to ${action} user.`);
            } finally {
                Loader.hide();
            }
        }

        async function confirmDeleteUser(userId, btnElement) {
            const isConfirmed = await CustomConfirm.show({
                title: "Delete Organizer?",
                message: "This action is permanent and cannot be undone.",
                confirmText: "Permanently Delete",
                actionType: "danger",
                icon: "fi-rr-trash"
            });
            if (!isConfirmed) return;

            Loader.show('DELETING ORGANIZER...');
            try {
                const response = await axios.post('/admin/users/delete', { userId });
                if (response.data.success) {
                    Toast.success(response.data.message);
                    const row = btnElement.closest('tr');
                    row.style.transition = 'all 0.4s ease';
                    row.style.opacity = '0';
                    row.style.transform = 'translateX(20px)';
                    setTimeout(() => {
                        row.remove();
                        const totalUsersEl = document.querySelector('.stat-card h3');
                        if (totalUsersEl) totalUsersEl.innerText = parseInt(totalUsersEl.innerText) - 1;
                    }, 400);
                }
            } catch (error) {
                Toast.error(error.response?.data?.message || "Failed to delete user.");
            } finally {
                Loader.hide();
            }
        }

        async function rejectOrganizer(orgId) {
            const isConfirmed = await CustomConfirm.show({
                title: "Reject Organizer?",
                message: "This will reject the organizer to access. ",
                confirmText: "Reject",
                actionType: "danger",
                icon: "fi-rr-check"
            });

            if (!isConfirmed) return;

            Loader.show('REJECTING...');
            try {
                // Ensure this route matches your adminRoutes.js setup
                const response = await axios.post('/admin/organizers/update-status', { 
                    orgId: orgId, 
                    status: 'rejected' 
                });

                if (response.data.success) {
                    Toast.success(response.data.message);
                    // Reload page to move them out of the 'pending' filter
                    setTimeout(() => window.location.reload(), 1500);
                }
            } catch (error) {
                Toast.error(error.response?.data?.message || "Failed to approve organizer.");
            } finally {
                Loader.hide();
            }
        }

        async function approveOrganizer(orgId) {
            const isConfirmed = await CustomConfirm.show({
                title: "Approve Organizer?",
                message: "This will grant the organizer full access to the dashboard.",
                confirmText: "Approve",
                actionType: "success",
                icon: "fi-rr-check"
            });

            if (!isConfirmed) return;

            Loader.show('APPROVING...');
            try {
                // Ensure this route matches your adminRoutes.js setup
                const response = await axios.post('/admin/organizers/update-status', { 
                    orgId: orgId, 
                    status: 'approved' 
                });

                if (response.data.success) {
                    Toast.success(response.data.message);
                    // Reload page to move them out of the 'pending' filter
                    setTimeout(() => window.location.reload(), 1500);
                }
            } catch (error) {
                Toast.error(error.response?.data?.message || "Failed to approve organizer.");
            } finally {
                Loader.hide();
            }
        }

        // --- 3. DOM LISTENERS ---
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('applyFilters')?.addEventListener('click', applyFilters);
            document.getElementById('clearFilters')?.addEventListener('click', () => {
                window.location.href = window.location.pathname;
            });
            document.getElementById('orgSearch')?.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') applyFilters();
            });
        });
    </script>
</body>
</html>