<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <title>Manage Organizers | EventHub Admin</title>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/admin-nav') %>

    <div class="dashboard-layout">
        <%- include('../../partials/admin-sidebar', { title: 'Manage Organizers' }) %>
        
        <main class="dashboard-main">
            <div class="mb-5 animate stagger-1">
                <h2 class="fw-bold">Event Organizers</h2>
                <p class="text-dim m-0">Review applications and manage active hosts.</p>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 gap-3 animate stagger-2">
                <div class="search-wrapper flex-grow-1" style="position: relative; max-width: 400px;">
                    <i class="fi fi-rr-search text-dim" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%);"></i>
                    <input type="text" id="orgSearch" class="input ps-5" placeholder="Search organization..." 
                           value="<%= filters.search %>" style="height: 45px;">
                </div>
                
                <div class="d-flex gap-2">
                    <select id="statusFilter" class="input px-3">
                        <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Status</option>
                        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                        <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                    </select>

                    <select id="orgSort" class="input px-3">
                        <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
                        <option value="name-asc" <%= filters.sort === 'name-asc' ? 'selected' : '' %>>Name (A-Z)</option>
                    </select>

                    <button type="button" id="clearFilters" class="action-btn" style="height: 45px; width: 45px;">
                        <i class="fi fi-rr-refresh"></i>
                    </button>

                    <button type="button" onclick="applyFilters()" class="btn btn-primary" style="height: 45px; padding: 0 20px;">
                        Apply
                    </button>
                </div>
            </div>

            <div class="glass-dark p-4 rounded-3 animate stagger-3">
                <div style="overflow-x: auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Organization</th>
                                <th>Contact Info</th>
                                <th>Events</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (organizers && organizers.length > 0) { %>
                                <% organizers.forEach(org => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-center gap-3">
                                                <div class="org-icon">🏢</div>
                                                <div>
                                                    <strong class="text-white"><%= org.organizationName %></strong>
                                                    <p class="text-dim m-0 small">Rep: <%= org.fullName %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-white"><%= org.email %></span><br>
                                            <span class="text-dim small"><%= org.phone %></span>
                                        </td>
                                        <td class="text-white fw-bold"><%= org.eventCount || 0 %></td>
                                        <td>
                                            <span class="status-badge status-<%= org.status %>">
                                                <%= org.status.toUpperCase() %>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <button onclick="updateStatus('<%= org._id %>', 'active')" class="action-btn action-btn-unblock icon-only" title="Approve">
                                                    <i class="fi fi-rr-check"></i>
                                                </button>
                                                <button onclick="updateStatus('<%= org._id %>', 'suspended')" class="action-btn action-btn-block icon-only" title="Suspend">
                                                    <i class="fi fi-rr-ban"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="5" class="text-center p-5 text-dim">No organizers found.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 px-3">
                <p class="text-dim mb-0">Page <%= currentPage %> of <%= totalPages %></p>
                <div class="pagination d-flex gap-2">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <button class="action-btn <%= i == currentPage ? 'active-page' : '' %>" onclick="changePage(<%= i %>)">
                            <%= i %>
                        </button>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <script>
        function applyFilters() {
            const search = document.getElementById('orgSearch').value.trim();
            const status = document.getElementById('statusFilter').value;
            const sort = document.getElementById('orgSort').value;
            const url = new URL(window.location.href);
            
            if (search) url.searchParams.set('search', search);
            else url.searchParams.delete('search');
            
            url.searchParams.set('status', status);
            url.searchParams.set('sort', sort);
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        }

        function changePage(page) {
            const url = new URL(window.location.href);
            url.searchParams.set('page', page);
            window.location.href = url.toString();
        }

        document.getElementById('clearFilters').onclick = () => window.location.href = window.location.pathname;

        async function updateStatus(orgId, newStatus) {
            const confirmed = await CustomConfirm.show({
                title: "Update Status?",
                message: `Are you sure you want to set this organizer to ${newStatus}?`,
                confirmText: "Update",
                actionType: newStatus === 'active' ? 'success' : 'danger'
            });

            if (!confirmed) return;

            Loader.show('UPDATING...');
            try {
                const res = await axios.post('/admin/organizers/update-status', { orgId, status: newStatus });
                if (res.data.success) {
                    Toast.success(res.data.message);
                    setTimeout(() => window.location.reload(), 1000);
                }
            } catch (err) {
                Toast.error("Update failed");
            } finally {
                Loader.hide();
            }
        }
    </script>
</body>
</html>