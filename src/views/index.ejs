<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventHub | Discover & Book Premium Events</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-mesh">
    <div class="floating-blob"></div>

    <% if (locals.user) { %>
        <%- include('partials/navbar-auth') %>
    <% } else { %>
        <%- include('partials/navbar-guest') %>
    <% } %>

    <main>
        <section class="section container text-center" style="padding-top: 8rem; padding-bottom: 6rem;">
            <h1 class="animate stagger-1" style="font-size: 4rem; line-height: 1.1; margin-bottom: 1.5rem;">
                Unforgettable Experiences,<br>
                <span class="text-gradient">Just a Tap Away.</span>
            </h1>
            <p class="text-muted animate stagger-2" style="max-width: 600px; margin: 0 auto 2.5rem; font-size: 1.1rem;">
                Discover exclusive tech summits, local football tournaments, and live workshops. Secure your digital ticket with instant QR validation.
            </p>
            <div class="d-flex justify-center gap-3 animate stagger-3">
                <a href="/events" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Explore Events</a>
                <a href="/organizer/apply" class="btn btn-outline" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Host an Event</a>
            </div>
        </section>

        <section class="container animate stagger-4 mb-5">
            <div class="glass-dark p-3 d-flex gap-2 align-center justify-between flex-wrap" style="border-radius: var(--radius-lg);">
                <input type="text" class="input flex-grow-1" placeholder="Search by event name or keyword..." style="background: rgba(255,255,255,0.02); border: none;">
                <select class="input" style="width: 200px; background-color: rgba(255,255,255,0.02); border: none;">
                    <option value="">All Categories</option>
                    <option value="tech">Technology</option>
                    <option value="sports">Sports & Fitness</option>
                    <option value="music">Live Music</option>
                </select>
                <button class="btn btn-primary">Search</button>
            </div>
        </section>

        <section class="container section pt-0">
            <div class="d-flex justify-between align-center mb-4">
                <h2>Trending <span class="text-gradient">This Week</span></h2>
                <a href="/events" class="text-muted">View all &rarr;</a>
            </div>

            <div class="footer-grid" style="gap: 2rem;">
                
                <div class="card">
                    <div class="card-img" style="background-image: url('https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800&q=80');">
                        <div class="card-badge">Tech</div>
                    </div>
                    <div class="card-content">
                        <div class="card-meta">
                            <span>📅 Oct 15, 2026</span>
                            <span>📍 Kozhikode IT Park</span>
                        </div>
                        <h3 class="card-title">MERN Stack Architecture Summit</h3>
                        <p class="text-dim mb-3" style="font-size: 0.9rem;">Deep dive into building scalable backend systems with Node.js and MongoDB.</p>
                        <div class="d-flex justify-between align-center">
                            <span class="text-gradient" style="font-weight: 700; font-size: 1.2rem;">₹ 499</span>
                            <a href="/events/1" class="btn btn-outline" style="padding: 0.4rem 1rem;">Get Ticket</a>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-img" style="background-image: url('https://images.unsplash.com/photo-1579952363873-27f3bade9f55?w=800&q=80');">
                        <div class="card-badge" style="background: #2E86AB;">Sports</div>
                    </div>
                    <div class="card-content">
                        <div class="card-meta">
                            <span>📅 Oct 18, 2026</span>
                            <span>📍 Greenfield Turf</span>
                        </div>
                        <h3 class="card-title">Midnight 5v5 Football Clash</h3>
                        <p class="text-dim mb-3" style="font-size: 0.9rem;">Register your squad for the ultimate knockout tournament. Cash prizes for the winners.</p>
                        <div class="d-flex justify-between align-center">
                            <span class="text-gradient" style="font-weight: 700; font-size: 1.2rem;">₹ 1,200 / Team</span>
                            <a href="/events/2" class="btn btn-outline" style="padding: 0.4rem 1rem;">Register</a>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-img" style="background-image: url('https://images.unsplash.com/photo-1475721025505-c31da16c60e5?w=800&q=80');">
                        <div class="card-badge" style="background: #E6A822;">Workshop</div>
                    </div>
                    <div class="card-content">
                        <div class="card-meta">
                            <span>📅 Nov 02, 2026</span>
                            <span>📍 Digital Hub</span>
                        </div>
                        <h3 class="card-title">Freelance Mastery Workshop</h3>
                        <p class="text-dim mb-3" style="font-size: 0.9rem;">Learn how to price IT services, write winning proposals, and secure international clients.</p>
                        <div class="d-flex justify-between align-center">
                            <span class="text-gradient" style="font-weight: 700; font-size: 1.2rem;">Free</span>
                            <a href="/events/3" class="btn btn-outline" style="padding: 0.4rem 1rem;">Book Seat</a>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <footer>
        <div class="container footer-bottom">
            <p>&copy; 2026 EventHub Platform. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>