<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>


<body class="bg-mesh">
    <!-- ── Dynamic Animated Background Orbs ── -->
    <div class="hero-orb-container">
        <div class="hero-glow-orb hero-glow-orb-1"></div>
        <div class="hero-glow-orb hero-glow-orb-2"></div>
        <div class="hero-glow-orb hero-glow-orb-3"></div>
    </div>
    <div class="floating-blob" style="top: -100px; left: -100px; opacity: 0.18;"></div>
    <div class="floating-blob" style="bottom: -100px; right: -100px; width: 300px; height: 300px; animation-delay: -7s; opacity: 0.12;"></div>

    <% if (user) { %>
        <%- include('partials/navbars/user-nav') %>
    <% } else { %>
        <%- include('partials/navbar-guest') %>
    <% } %>

    <main style="position: relative; z-index: 1;">

        <!-- ── Hero Section ───────────────────────────────────────── -->
        <section class="container text-center" style="padding-top: 9rem; padding-bottom: 6rem; position: relative;">

            <!-- Glow orb -->
            <div style="position: absolute; top: 10%; left: 50%; transform: translate(-50%, 0); width: 700px; height: 400px; background: radial-gradient(ellipse, rgba(230,57,70,0.12) 0%, transparent 70%); pointer-events: none; z-index: -1; filter: blur(20px);"></div>

            <!-- Badge -->
            <div data-aos="fade-down" data-aos-delay="100" class="d-inline-flex align-items-center gap-2 mb-4 hero-badge-shimmer" style="border-radius: 100px; padding: 7px 20px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.9);">
                <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--primary); box-shadow: 0 0 8px var(--primary); animation: pulseDot 2s infinite; flex-shrink: 0;"></span>
                Kozhikode's Premier Event Platform
            </div>

            <!-- Hero headline -->
            <h1 data-aos="fade-up" data-aos-delay="200" style="font-size: clamp(2.2rem, 8vw, 5.5rem); line-height: 1.08; margin-bottom: 1.5rem; letter-spacing: -3px; font-weight: 800;">
                Unforgettable Experiences,<br>
                <span class="animated-gradient-text glow-text">Just a Tap Away.</span>
            </h1>

            <!-- Sub-headline -->
            <p data-aos="fade-up" data-aos-delay="300" class="text-muted" style="max-width: 600px; margin: 0 auto 3rem; font-size: 1.15rem; line-height: 1.7; opacity: 0.75;">
                Tech summits, sports tournaments &amp; live workshops — discover and book with instant QR validation.
            </p>

            <!-- CTA Buttons -->
            <div data-aos="fade-up" data-aos-delay="400" class="d-flex justify-center gap-3 flex-wrap mb-5">
                <% if (user) { %>
                    <a href="/user/events" class="btn btn-primary" style="height: 52px; padding: 0 2rem; font-size: 1rem; border-radius: 12px;">
                        <i class="fi fi-rr-search me-2"></i>Browse Events
                    </a>
                <% } else { %>
                    <a href="/user/signup" class="btn btn-primary" style="height: 52px; padding: 0 2rem; font-size: 1rem; border-radius: 12px;">
                        Get Started &rarr;
                    </a>
                    <a href="/user/login" class="btn btn-outline" style="height: 52px; padding: 0 2rem; font-size: 1rem; border-radius: 12px;">
                        Sign In
                    </a>
                <% } %>
            </div>

            <!-- Stats row -->
            <div data-aos="fade-up" data-aos-delay="500" class="d-flex justify-center gap-4 flex-wrap" style="opacity: 0.85;">
                <div class="text-center stat-item" style="cursor: default; padding: 0.5rem 1.2rem; border-radius: 12px; transition: background 0.3s ease;" onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background='transparent'">
                    <div class="stat-number-glow" style="font-size: 1.8rem; font-weight: 800; font-family: var(--font-display);"><span class="counter-val" data-target="500">0</span>+</div>
                    <div style="font-size: 0.78rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;">Events Hosted</div>
                </div>
                <div style="width: 1px; background: var(--border); margin: auto 0; height: 40px;"></div>
                <div class="text-center stat-item" style="cursor: default; padding: 0.5rem 1.2rem; border-radius: 12px; transition: background 0.3s ease;" onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background='transparent'">
                    <div class="stat-number-glow" style="font-size: 1.8rem; font-weight: 800; font-family: var(--font-display);"><span class="counter-val" data-target="12">0</span>k+</div>
                    <div style="font-size: 0.78rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;">Happy Attendees</div>
                </div>
                <div style="width: 1px; background: var(--border); margin: auto 0; height: 40px;"></div>
                <div class="text-center stat-item" style="cursor: default; padding: 0.5rem 1.2rem; border-radius: 12px; transition: background 0.3s ease;" onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background='transparent'">
                    <div class="stat-number-glow" style="font-size: 1.8rem; font-weight: 800; font-family: var(--font-display);"><span class="counter-val" data-target="99">0</span>%</div>
                    <div style="font-size: 0.78rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;">Satisfaction Rate</div>
                </div>
            </div>
        </section>

        <!-- ── Search Bar ──────────────────────────────────────────── -->
        <style>
            .hero-search-bar {
                border-radius: 100px;
                padding: 0.6rem 0.6rem 0.6rem 1.8rem;
                box-shadow: 0 20px 60px rgba(0,0,0,0.6);
                border: 1px solid rgba(255,255,255,0.09);
                background: rgba(15,15,15,0.6);
                backdrop-filter: blur(20px);
                transition: all 0.3s ease;
            }
            .hero-search-bar:focus-within {
                border-color: rgba(230, 57, 70, 0.4);
                box-shadow: 0 20px 60px rgba(230, 57, 70, 0.15);
            }
            .hero-search-input {
                width: 100%;
                background: transparent;
                border: none;
                color: white;
                outline: none;
                font-size: 1rem;
                height: 48px;
                padding: 0;
            }
            .hero-search-input::placeholder { color: rgba(255,255,255,0.5); font-weight: 400; }
            .hero-search-select {
                width: 180px;
                background: transparent;
                border: none;
                color: white;
                outline: none;
                font-size: 0.95rem;
                height: 48px;
                cursor: pointer;
                padding-right: 1.5rem;
                -moz-appearance: none;
                -webkit-appearance: none;
                appearance: none;
                background-image: url('data:image/svg+xml;utf8,<svg fill="%23ffffff" height="20" viewBox="0 0 24 24" width="20" xmlns="http://www.w3.org/2000/svg"><path d="M7 10l5 5 5-5z"/></svg>');
                background-repeat: no-repeat;
                background-position-x: 100%;
                background-position-y: 50%;
                font-weight: 500;
            }
            .hero-search-select option { background: #111; color: white; padding: 10px; }
            .hero-search-divider {
                width: 1px; height: 32px; background: rgba(255,255,255,0.15); margin: 0 1.2rem; flex-shrink: 0;
            }
            @media (max-width: 768px) {
                .hero-search-bar {
                    flex-direction: column;
                    border-radius: 20px;
                    padding: 1.2rem;
                    gap: 1rem;
                }
                .hero-search-divider { display: none; }
                .hero-search-select { width: 100%; }
                .hero-search-bar .btn { width: 100%; border-radius: 12px !important; }
            }
        </style>

        <section data-aos="fade-up" data-aos-delay="600" class="container" style="margin-top: -2rem; position: relative; z-index: 10; margin-bottom: 5rem;">
            <form action="/user/events" method="GET" class="hero-search-bar d-flex align-items-center">
                <div class="flex-grow-1 d-flex align-items-center gap-3 w-100">
                    <i class="fi fi-rr-search text-dim" style="font-size: 1.2rem; flex-shrink: 0; margin-top: 2px;"></i>
                    <input type="text" name="search" class="hero-search-input" placeholder="Search events, organizers, locations...">
                </div>
                
                <div class="hero-search-divider"></div>
                
                <select name="category" class="hero-search-select">
                    <option value="all">All Categories</option>
                    <option value="Music">Music</option>
                    <option value="Business">Business</option>
                    <option value="Sports">Sports</option>
                    <option value="Workshop">Workshops</option>
                    <option value="Tech">Technology</option>
                    <option value="Art">Art</option>
                    <option value="Food">Food</option>
                </select>
                
                <button type="submit" class="btn btn-primary ms-md-3 mt-3 mt-md-0" style="border-radius: 100px; padding: 0 2.2rem; height: 54px; font-weight: 600; font-size: 1.05rem; white-space: nowrap;">
                    Find Events
                </button>
            </form>
        </section>

        <!-- ── Latest Events ─────────────────────────────────────────── -->
        <section class="container section" style="padding-top: 4rem; padding-bottom: 2rem;">
            <div data-aos="fade-up" class="d-flex justify-between align-center mb-5">
                <div>
                    <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--primary); font-weight: 700; margin-bottom: 6px;">
                        <span style="display: inline-block; width: 20px; height: 2px; background: var(--primary); vertical-align: middle; margin-right: 8px;"></span>
                        New Arrivals
                    </p>
                    <h2 style="font-size: 2rem; letter-spacing: -1px; margin: 0;">Latest <span class="text-gradient">Events</span></h2>
                </div>
                <a href="/events?sort=newest" style="display: inline-flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: 0.88rem; font-weight: 500; border: 1px solid rgba(255,255,255,0.08); border-radius: 100px; padding: 7px 18px; transition: all 0.25s ease;"
                   onmouseover="this.style.borderColor='rgba(230,57,70,0.4)'; this.style.color='white';"
                   onmouseout="this.style.borderColor='rgba(255,255,255,0.08)'; this.style.color='';">
                    View all <i class="fi fi-rr-arrow-right" style="font-size: 0.8rem;"></i>
                </a>
            </div>

            <div class="event-grid" style="gap: 2rem;">
                <% if (locals.latestEvents && latestEvents.length > 0) { %>
                    <% latestEvents.forEach(event => { %>
                        <%- include('partials/event-card', { event: event }) %>
                    <% }) %>
                <% } else { %>
                    <div class="glass-premium p-5 text-center" style="border-radius: 20px; border-style: dashed; border-color: rgba(255,255,255,0.1); grid-column: 1 / -1;">
                        <p class="text-dim mb-0" style="font-size: 0.9rem;">No new events added recently.</p>
                    </div>
                <% } %>
            </div>
        </section>



        <!-- ── Feature Highlights ──────────────────────────────────── -->
        <section class="container section" style="padding-top: 0; padding-bottom: 6rem;">
            <div data-aos="fade-up" class="text-center mb-5">
                <h2 style="font-size: 2rem; letter-spacing: -1px;">Why <span class="text-gradient">EventHub?</span></h2>
                <p class="text-dim" style="font-size: 0.95rem; margin-top: 0.5rem;">Everything you need for a seamless event experience.</p>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
                <% const features = [
                    { icon: 'fi-rr-ticket', color: '#E63946', title: 'Instant Booking', desc: 'Reserve your spot in seconds. No waiting, no hassle.' },
                    { icon: 'fi-rr-qr-scan', color: '#4ECDC4', title: 'QR Validation', desc: 'Digital tickets with secure QR codes for entry.' },
                    { icon: 'fi-rr-wallet', color: '#F4A261', title: 'EventHub Wallet', desc: 'Store credits and pay faster at checkout.' },
                    { icon: 'fi-rr-calendar-star', color: '#2ECC71', title: 'Event Calendar', desc: 'Never miss an event with your personal calendar.' }
                ]; %>
                <% features.forEach((f, index) => { %>
                <div data-aos="fade-up" data-aos-delay="<%= index * 100 %>" class="feature-card-interactive" style="border-radius: 16px; padding: 2rem 1.75rem; --feature-color: <%= f.color %>; --feature-color-glow: <%= f.color %>33;">
                    <div class="feature-icon-box" style="width: 52px; height: 52px; border-radius: 14px; background: <%= f.color %>1a; border: 1px solid <%= f.color %>33; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; font-size: 1.35rem; color: <%= f.color %>;">
                        <i class="fi <%= f.icon %>"></i>
                    </div>
                    <h4 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.6rem; letter-spacing: -0.3px; color: #fff;"><%= f.title %></h4>
                    <p style="font-size: 0.88rem; color: var(--text-dim); line-height: 1.6; margin: 0;"><%= f.desc %></p>
                </div>
                <% }) %>
            </div>
        </section>

        <!-- ── CTA Section ─────────────────────────────────────────── -->
        <section class="container section" style="padding-top: 0; padding-bottom: 8rem;">
            <div data-aos="zoom-in" class="glass-premium cta-banner-card" style="border-radius: 24px; padding: 4.5rem 2rem; text-align: center; background: linear-gradient(135deg, rgba(230,57,70,0.18) 0%, rgba(15,15,15,0.85) 100%); border: 1px solid rgba(230,57,70,0.25); position: relative; overflow: hidden;">
                <!-- Decorative BG elements -->
                <div style="position: absolute; top: -60px; left: -60px; width: 250px; height: 250px; background: var(--primary); filter: blur(100px); opacity: 0.2; animation: floatOrb1 15s infinite alternate;"></div>
                <div style="position: absolute; bottom: -60px; right: -60px; width: 250px; height: 250px; background: #4ECDC4; filter: blur(100px); opacity: 0.15; animation: floatOrb2 18s infinite alternate;"></div>
                
                <h2 style="font-size: clamp(1.8rem, 5vw, 2.8rem); letter-spacing: -1px; margin-bottom: 1rem; position: relative; z-index: 1; font-weight: 800;">Ready to Host Your Own Event?</h2>
                <p class="text-dim" style="max-width: 540px; margin: 0 auto 2.5rem; font-size: 1.1rem; line-height: 1.7; position: relative; z-index: 1;">Join hundreds of organizers who use EventHub to sell tickets, manage attendees, and grow their community effortlessly.</p>
                
                <a href="/organizer/apply" class="btn btn-primary btn-pulse-glow" style="position: relative; z-index: 1; height: 56px; padding: 0 3.2rem; font-size: 1.1rem; border-radius: 100px; font-weight: 600; display: inline-flex; align-items: center; gap: 10px;">
                    Become an Organizer <i class="fi fi-rr-arrow-small-right" style="font-size: 1.3rem;"></i>
                </a>
            </div>
        </section>

    </main>

    <footer>
        <div class="container footer-bottom">
            <p style="font-size: 0.85rem; color: var(--text-dim);">&copy; 2026 EventHub Platform &mdash; All rights reserved.</p>
        </div>
    </footer>
    <script>
        const IS_LOGGED_IN = <%= locals.user ? 'true' : 'false' %>;

        async function toggleWishlist(e, eventId, btn) {
            e.stopPropagation();
            if (!IS_LOGGED_IN) {
                window.location.href = '/user/login?message=Please login to save events';
                return;
            }
            try {
                const res = await axios.post(`/user/events/${eventId}/wishlist`, {}, {
                    headers: { 'Accept': 'application/json' }
                });
                if (res.data.success) {
                    const active = res.data.wishlisted;
                    btn.classList.toggle('wishlisted', active);
                    btn.querySelector('i').className = active ? 'fi fi-sr-heart' : 'fi fi-rr-heart';
                    btn.title = active ? 'Remove from wishlist' : 'Add to wishlist';
                    if (window.Toast) {
                        Toast[active ? 'success' : 'info'](res.data.message);
                    } else {
                        alert(res.data.message);
                    }
                }
            } catch (err) {
                if (err.response?.status === 401) {
                    window.location.href = '/user/login?message=Please login to save events';
                } else {
                    if (window.Toast) Toast.error('Could not update wishlist. Try again.');
                    else alert('Could not update wishlist. Try again.');
                }
            }
        }

        // ── Number Counter Animation when scrolled into view ──
        document.addEventListener('DOMContentLoaded', () => {
            const counters = document.querySelectorAll('.counter-val');
            const speed = 150;

            const animateCounter = (counter) => {
                const target = +counter.getAttribute('data-target');
                let count = 0;
                const inc = Math.max(1, Math.ceil(target / speed));

                const updateCount = () => {
                    count += inc;
                    if (count < target) {
                        counter.innerText = count;
                        setTimeout(updateCount, 20);
                    } else {
                        counter.innerText = target;
                    }
                };
                updateCount();
            };

            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateCounter(entry.target);
                        obs.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.5 });

            counters.forEach(counter => observer.observe(counter));
        });
    </script>
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>AOS.init({ duration: 800, once: true, offset: 50 });</script>
</body>
</html>