<%- include('../../partials/head') %>
<body class="bg-mesh">
    
    <div id="custom-loader" class="loader-overlay" style="display: none;">
        <div class="loader-spinner"></div>
        <div class="loader-text">UPDATING PASSWORD...</div>
    </div>

    <div class="auth-split-layout">
        <!-- Left Side Image -->
        <div class="auth-image-side" style="background-image: url('https://images.unsplash.com/photo-1492684223066-81342ee5ff30?q=80&w=2000');">
            <div class="auth-image-overlay">
                <a href="/" class="logo mb-4" style="font-size: 2.5rem;">
                    Event<span class="text-gradient">Hub</span>
                </a>
                <h1 style="font-size: 3.5rem; line-height: 1.1; margin-bottom: 1rem; color: #fff;">
                    Secure your<br>account.
                </h1>
                <p class="text-muted" style="font-size: 1.2rem; max-width: 400px;">
                    Enter a strong new password for <span class="text-gradient" id="user-email" style="font-weight: 700;"><%= email %></span>.
                </p>
            </div>
        </div>

        <!-- Right Side Form -->
        <div class="auth-form-side">
            <div class="floating-blob" style="top: 20%; left: 10%;"></div>
            
            <div class="auth-form-container w-100" style="max-width: 400px; margin: 0 auto;">
                <div class="text-center mb-5 animate stagger-1">
                    <h2 style="font-size: 2rem; margin-bottom: 0.5rem;">New Password</h2>
                    <p class="text-muted">Make sure it's at least 6 characters long.</p>
                </div>

                <form id="resetPasswordForm" class="animate stagger-2" novalidate>
                    
                    <!-- New Password Field -->
                    <div class="form-floating position-relative mb-4">
                        <input type="password" class="form-control input" id="newPassword" placeholder=" " required>
                        <label for="newPassword">New Password</label>
                        <button type="button" class="password-toggle" onclick="togglePassword('newPassword', this)">
                            <i class="fi fi-rr-eye"></i>
                        </button>
                    </div>

                    <!-- Confirm New Password Field -->
                    <div class="form-floating position-relative mb-4">
                        <input type="password" class="form-control input" id="confirmPassword" placeholder=" " required>
                        <label for="confirmPassword">Confirm Password</label>
                        <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword', this)">
                            <i class="fi fi-rr-eye"></i>
                        </button>
                    </div>

                    <button type="submit" class="btn btn-primary mt-2" style="width: 100%; height: 3.5rem;">
                        Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Eye icon toggle logic
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fi-rr-eye', 'fi-rr-eye-crossed'); // Changes to the crossed-out eye
            } else {
                input.type = 'password';
                icon.classList.replace('fi-rr-eye-crossed', 'fi-rr-eye'); // Changes back to normal eye
            }
        }

        // Form submission via Axios
        const form = document.getElementById('resetPasswordForm');
        const loader = document.getElementById('custom-loader');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            // Basic frontend validation
            if (!newPassword || !confirmPassword) {
                return Toast.error('Please fill in both password fields.');
            }
            if (newPassword.length < 6) {
                return Toast.error('Password must be at least 6 characters.');
            }
            if (newPassword !== confirmPassword) {
                return Toast.error('Passwords do not match.');
            }

            loader.style.display = 'flex';

            const email = document.getElementById("user-email").textContent;

            try {
                const response = await axios.post('/user/reset-password', {
                    newPassword,
                    confirmPassword,
                    email
                });

                if (response.data.success) {
                    loader.style.display = 'none';
                    Toast.success(response.data.message);
                    
                    // Disable button to prevent double-clicks during redirect delay
                    form.querySelector('button[type="submit"]').disabled = true;

                    // Redirect to login after 2 seconds so they can see the success Toast
                    setTimeout(() => {
                        window.location.href = response.data.redirect;
                    }, 2000);
                }
            } catch (error) {
                loader.style.display = 'none';
                Toast.error(error.response?.data?.message || 'Failed to reset password.');
            }
        });
    </script>
</body>