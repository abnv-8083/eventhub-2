<%- include('../../partials/head') %>

<body class="bg-mesh">
    <div class="floating-blob"></div>

    <%- include('../../partials/navbar-guest') %>

    <main class="section container d-flex justify-center align-center" style="min-height: 70vh;">
        <div class="glass-dark p-5 animate" style="border-radius: var(--radius-lg); width: 100%; max-width: 450px;">
            <div class="text-center mb-4">
                <h2>Reset Password</h2>
                <p class="text-muted mt-2" style="font-size: 0.95rem;">
                    Enter the email address associated with your account, and we'll send you a link to reset your password.
                </p>
            </div>

            <form id="forgot-password-form">
                <div class="form-group stagger-1">
                    <label class="label" for="email">Email Address</label>
                    <input type="email" id="email" name="email" class="input" placeholder="name@example.com" required>
                </div>

                <button type="submit" class="btn btn-primary mt-2 stagger-2" style="width: 100%;">
                    Send Reset Link
                </button>
                
                <div class="text-center mt-4 stagger-3">
                    <a href="/user/login" class="text-muted" style="font-size: 0.9rem;">
                        <span style="margin-right: 5px;">&larr;</span> Back to Login
                    </a>
                </div>
            </form>
        </div>
    </main>

    <script>
        const forgotPasswordForm = document.getElementById('forgot-password-form')
        forgotPasswordForm.addEventListener('submit', async (e)=>{
            e.preventDefault()

            
            Loader.show()

            const formData = new FormData(forgotPasswordForm)
            const data = Object.fromEntries(formData.entries())

            try {
                const response = await axios.post('/user/forgot-password',data)
                if(response.data.success){
                    Toast.success(response.data.message)
                    setTimeout(()=>window.location.href = '/user/verify-otp?action=forgotPassword', 1800)
                }
            } catch (error) {
                Loader.hide()
                Toast.error(error.response?.data?.message||'Server Error')
            }
        })
    </script>
</body>
</html>