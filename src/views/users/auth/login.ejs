<%- include('../../partials/head') %>


<body class="bg-mesh">
    
    <div class="auth-split-layout">
        
        <div class="auth-image-side" style="background-image: url('https://images.unsplash.com/photo-1540575467063-178a50c2df87?q=80&w=2000');">
            <div class="auth-image-overlay">
                <a href="/" class="logo mb-4" style="font-size: 2.5rem;">
                    Event<span class="text-gradient">Hub</span>
                </a>
                <h1 style="font-size: 3.5rem; line-height: 1.1; margin-bottom: 1rem; color: #fff;">
                    Manage your<br>events effortlessly.
                </h1>
                <p class="text-muted" style="font-size: 1.2rem; max-width: 400px;">
                    Access your personalized dashboard to track ticket sales, manage attendees, and discover new experiences.
                </p>
            </div>
        </div>

        <div class="auth-form-side">
            <div class="floating-blob" style="top: 20%; left: 10%;"></div>

            <a href="/" class="auth-back-btn">&larr; Back to Home</a>

            <div class="auth-form-container w-100" style="max-width: 400px; margin: 0 auto;">
                <div class="text-center mb-5">
                    <h2 style="font-size: 2rem; margin-bottom: 0.5rem;">Welcome Back</h2>
                    <p class="text-muted">Enter your details to access your account.</p>
                </div>

                <form id="loginForm" novalidate>
                    
                    <div class="form-floating animate stagger-1">
                        <input type="email" id="email" name="email" class="input" placeholder=" " data-rule="required, email">
                        <label for="email">Email Address</label>
                    </div>

                    <div class="form-floating position-relative mb-4">
                        <!-- 1. Make sure this input has id="password" -->
                        <input type="password" class="form-control input" name="password" id="password" placeholder=" " data-rule="required">
                        <label for="password">Password</label>
                        
                        <!-- 2. Add the onclick event to the button -->
                        <button type="button" class="password-toggle" onclick="togglePassword('password', this)">
                            <i class="fi fi-rr-eye"></i>
                        </button>
                    </div>

                    <div class="d-flex justify-between align-center mb-4 animate stagger-3">
                        <label class="d-flex align-center cursor-pointer">
                            <div class="modern-switch">
                                <input type="checkbox" name="remember" id="remember">
                                <span class="slider"></span>
                            </div>
                            <span class="text-muted" style="font-size: 0.85rem; user-select: none;">Remember me</span>
                        </label>
                        <a href="/user/forgot-password" style="color: var(--primary); font-size: 0.85rem; font-weight: 500;">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary animate stagger-4" style="width: 100%; height: 3.5rem; font-size: 1rem;">
                        Sign In
                    </button>
                    
                    <div class="text-center mt-4 animate stagger-4">
                        <p class="text-muted" style="font-size: 0.9rem;">
                            Don't have an account? <a href="/user/signup" style="color: var(--primary); font-weight: 600;">Create one</a>
                        </p>
                    </div>

                    <div class="d-flex align-center gap-3 mt-4 mb-4 animate stagger-4">
                        <hr style="flex-grow: 1; border-color: var(--border); margin: 0;">
                        <span class="text-dim" style="font-size: 0.8rem;">OR CONTINUE WITH</span>
                        <hr style="flex-grow: 1; border-color: var(--border); margin: 0;">
                    </div>

                    <a href="/user/auth/google" class="btn btn-google animate stagger-4" style="width: 100%; height: 3.5rem;">
                        <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        Sign in with Google
                    </a>
                </form>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="statusModal">
        <div class="modal-container glass-premium dynamic-card" style="max-width: 420px; text-align: center;">
            <div class="modal-header border-bottom-0 pb-0 justify-content-end">
                <i class="fi fi-rr-cross modal-close" onclick="closeStatusModal()"></i>
            </div>
            <div class="modal-body pt-0 pb-4">
                <div id="statusModalIcon" class="mb-3 mx-auto d-flex align-items-center justify-content-center" 
                    style="width: 70px; height: 70px; border-radius: 50%;">
                    </div>
                <h4 class="text-white mb-2" id="statusModalTitle">Account Status</h4>
                <p class="text-dim m-0" id="statusModalMessage" style="font-size: 0.95rem; line-height: 1.5;"></p>
            </div>
            <div class="modal-footer border-top-0 justify-content-center pt-0">
                <button class="btn btn-primary w-100" onclick="closeStatusModal()">I Understand</button>
            </div>
        </div>
    </div>

    <script>
        // Add this inside your <script> tag in login.ejs

            function togglePassword(inputId, btn) {
                const input = document.getElementById(inputId);
                const icon = btn.querySelector('i');
                
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.replace('fi-rr-eye', 'fi-rr-eye-crossed'); // Changes to the crossed-out eye
                } else {
                    input.type = 'password';
                    icon.classList.replace('fi-rr-eye-crossed', 'fi-rr-eye'); // Changes back to normal eye
                }
            }

        const loginForm = document.getElementById('loginForm')

        loginForm.addEventListener('submit', async (e)=>{
            e.preventDefault()

            if(!EV.validateForm(loginForm)){
                return
            }
            Loader.show()

            const formData = new FormData(loginForm)
            const data = Object.fromEntries(formData.entries())

            try {
                const response = await axios.post('/user/login',data)
                if(response.data.success){
                    Toast.success(response.data.message)
                    setTimeout(()=>{
                        window.location.href = response.data.redirect 
                    },2000)
                }
            } catch (error) {
                Loader.hide()
                Toast.error(error.response?.data?.message || 'Invalid Credintails');
            }
        })

        // Modal Logic
        function showStatusModal(status, message) {
            const modal = document.getElementById('statusModal');
            const iconContainer = document.getElementById('statusModalIcon');
            const title = document.getElementById('statusModalTitle');
            const msg = document.getElementById('statusModalMessage');

            // Configure visuals based on status
            if (status === 'pending') {
                iconContainer.style.background = 'rgba(241, 196, 15, 0.15)';
                iconContainer.style.color = '#f1c40f';
                iconContainer.innerHTML = '<i class="fi fi-sr-time-check" style="font-size: 2rem;"></i>';
                title.innerText = 'Application Pending';
            } else if (status === 'rejected') {
                iconContainer.style.background = 'rgba(230, 57, 70, 0.15)';
                iconContainer.style.color = '#E63946';
                iconContainer.innerHTML = '<i class="fi fi-sr-ban" style="font-size: 2rem;"></i>';
                title.innerText = 'Application Rejected';
            }

            msg.innerText = message;
            
            // Show Modal
            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('active'), 10);
        }

        function closeStatusModal() {
            const modal = document.getElementById('statusModal');
            modal.classList.remove('active');
            setTimeout(() => modal.style.display = 'none', 300);
        }

        // Check for URL query messages (e.g., from blocked Google Auth)
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const message = urlParams.get('message');
            if (message) {
                // Ensure Toast exists (assumes your layout has it)
                if (typeof Toast !== 'undefined' && Toast.error) {
                    Toast.error(message);
                } else {
                    alert(message);
                }
                // Optional: remove the query param from URL without reloading
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        });

    </script>
</body>
</html>