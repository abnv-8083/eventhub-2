<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="bg-mesh">
    <%- include('../partials/navbars/user-nav') %>

    <div class="dashboard-layout">
        <%- include('../partials/user-sidebar', { title: 'My Wishlist' }) %>
        <main class="dashboard-main">

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-5 animate stagger-1">
                <div>
                    <p class="page-label">Saved Events</p>
                    <h2 class="fw-bold mb-1">My Wishlist</h2>
                    <p class="text-dim m-0"><%= events.length %> saved event<%= events.length !== 1 ? 's' : '' %></p>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <% if(events.length > 0) { %>
                    <button id="wishClear" class="btn btn-outline" style="height:40px; border-radius:10px; font-size:0.85rem; border-color:rgba(231,76,60,0.4); color:#e74c3c;">
                        <i class="fi fi-rr-trash me-2"></i>Clear All
                    </button>
                    <% } %>
                    <a href="/user/events" class="btn btn-primary" style="height:40px; border-radius:10px;">
                        <i class="fi fi-rr-search me-2"></i>Discover Events
                    </a>
                </div>
            </div>

            <% if(events && events.length > 0) { %>
            <div class="row g-4 animate stagger-2" id="wishlistGrid">
                <% events.forEach(event => { %>
                <div class="col-md-6 col-lg-4" id="wcard-<%= event._id %>">
                    <div class="wishlist-card" onclick="window.location.href='/user/events/<%= event._id %>'">
                        <% if(event.banners && event.banners.length > 0) { %>
                            <img src="<%= event.banners[0] %>" class="wishlist-img" alt="<%= event.title %>">
                        <% } else { %>
                            <div class="wishlist-img-ph">
                                <i class="fi fi-rr-picture" style="font-size:2rem;color:rgba(255,255,255,0.15);"></i>
                            </div>
                        <% } %>

                        <div class="wishlist-body">
                            <span class="cat-tag mb-2 d-inline-block"><%= event.category?.name %></span>
                            <h6 class="fw-bold text-white mb-2" style="font-size:0.95rem; line-height:1.3; flex:1;">
                                <%= event.title %>
                            </h6>
                            <p class="text-dim mb-3" style="font-size:0.8rem;">
                                <i class="fi fi-rr-calendar me-1"></i>
                                <%= new Date(event.startDate).toLocaleDateString(undefined,{day:'numeric',month:'short',year:'numeric'}) %>
                                <span style="margin:0 6px; opacity:0.4;">&middot;</span>
                                <i class="fi fi-rr-marker me-1"></i>
                                <%= event.location?.address?.split(',')[0] %>
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2" style="border-top:1px solid rgba(255,255,255,0.06);">
                                <span class="event-price-badge">
                                    <% if(event.minPrice === 0) { %><span style="color:#2ecc71;">Free</span><% } else { %>From &#8377;<%= event.minPrice.toLocaleString('en-IN') %><% } %>
                                </span>
                                <button class="rm-btn" title="Remove from Wishlist"
                                    onclick="event.stopPropagation(); removeFromWishlist('<%= event._id %>', this)">
                                    <i class="fi fi-rr-heart-crack"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>

            <% } else { %>
            <div class="empty-box animate stagger-2">
                <div class="empty-icon">
                    <i class="fi fi-rr-heart"></i>
                </div>
                <h5 class="text-white mb-2">Your Wishlist is Empty</h5>
                <p class="text-dim mb-4">Browse events and tap the heart icon to save them here.</p>
                <a href="/user/events" class="btn btn-primary px-5">Discover Events</a>
            </div>
            <% } %>
        </main>
    </div>

    <script>
        async function removeFromWishlist(eventId, btn) {
            try {
                const res = await axios.post(`/user/events/${eventId}/wishlist`);
                if (res.data.success && !res.data.wishlisted) {
                    const card = document.getElementById(`wcard-${eventId}`);
                    if(card) {
                        card.style.transition = 'all 0.3s ease';
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.9)';
                        setTimeout(() => card.remove(), 300);
                    }
                    Toast.info(res.data.message);
                }
            } catch (err) {
                Toast.error('Could not remove from wishlist.');
            }
        }

        document.getElementById('wishClear')?.addEventListener('click', async () => {
            if (!confirm('Remove all events from your wishlist?')) return;
            const cards = document.querySelectorAll('[id^="wcard-"]');
            for (const card of cards) {
                const id = card.id.replace('wcard-', '');
                await axios.post(`/user/events/${id}/wishlist`).catch(() => {});
                card.style.transition = 'all 0.3s ease';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.9)';
                await new Promise(r => setTimeout(r, 100));
            }
            setTimeout(() => window.location.reload(), 500);
        });
    </script>
</body>
</html>
