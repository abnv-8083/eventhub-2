<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/user-nav') %>

    <div class="dashboard-layout">
        <%- include('../../partials/user-sidebar', { title: 'My Tickets' }) %>

        <main class="dashboard-main">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 animate stagger-1">
                <div>
                    <p class="page-label">Bookings</p>
                    <h2 class="fw-bold mb-1">My Tickets</h2>
                    <p class="text-dim m-0">Manage your upcoming and past event bookings.</p>
                </div>
                <a href="/user/events" class="btn btn-primary px-4">
                    <i class="fi fi-rr-search me-2"></i>Browse Events
                </a>
            </div>

            <!-- Filter Tabs -->
            <div class="filter-tabs mb-5 animate stagger-2">
                <a href="?filter=all" class="filter-tab <%= filter === 'all' ? 'active' : '' %>">All</a>
                <a href="?filter=upcoming" class="filter-tab <%= filter === 'upcoming' ? 'active' : '' %>">Upcoming</a>
                <a href="?filter=past" class="filter-tab <%= filter === 'past' ? 'active' : '' %>">Past</a>
                <a href="?filter=cancelled" class="filter-tab <%= filter === 'cancelled' ? 'active' : '' %>">Cancelled</a>
            </div>

            <!-- Tickets Grid -->
            <div class="row g-4 animate stagger-3">
                <% if(bookings && bookings.length > 0) { %>
                    <% bookings.forEach(booking => { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="ticket-card-modern status-<%= booking.status === 'active' ? 'active' : booking.status === 'on_hold' ? 'upcoming' : 'cancelled' %>-card p-4"
                                 onclick="window.location.href='/user/tickets/<%= booking._id %>'">

                                <!-- Status Badge -->
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <% if(booking.event) { %>
                                    <div class="ticket-card-date">
                                        <%= new Date(booking.event.startDate).toLocaleDateString(undefined, {day:'numeric', month:'short', year:'numeric'}) %>
                                    </div>
                                    <% } else { %>
                                    <div class="ticket-card-date" style="color: var(--text-dim);">Event Removed</div>
                                    <% } %>

                                    <% if(booking.status === 'active') { %>
                                        <span class="status-badge status-active">
                                            <i class="fi fi-sr-check-circle"></i> Active
                                        </span>
                                    <% } else if(booking.status === 'on_hold') { %>
                                        <span class="status-badge status-on-hold">
                                            <i class="fi fi-sr-clock"></i> On Hold
                                        </span>
                                    <% } else { %>
                                        <span class="status-badge status-cancelled">
                                            <i class="fi fi-sr-ban"></i> Cancelled
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Event Title -->
                                <h5 class="ticket-card-title">
                                    <%= booking.event ? booking.event.title : 'Event Unavailable' %>
                                </h5>

                                <!-- Ticket Types -->
                                <% if(booking.tickets && booking.tickets.length > 0) { %>
                                <div class="ticket-badge-list">
                                    <% booking.tickets.forEach(t => { %>
                                        <span class="ticket-badge">
                                            <i class="fi fi-rr-ticket me-1"></i><%= t.quantity %>× <%= t.ticketName %>
                                        </span>
                                    <% }) %>
                                </div>
                                <% } %>

                                <!-- Footer -->
                                <div class="ticket-card-footer">
                                    <div class="ticket-amount">
                                        Total Paid<br>
                                        <strong>&#8377;<%= booking.totalAmount.toLocaleString('en-IN') %></strong>
                                    </div>
                                    <button class="btn btn-outline btn-sm px-3" style="font-size:0.82rem;">
                                        View Details <i class="fi fi-rr-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12">
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fi fi-rr-ticket"></i>
                            </div>
                            <h5 class="text-white mb-2">No tickets found</h5>
                            <p class="text-dim mb-4">You haven't booked any events matching this filter.</p>
                            <a href="/events" class="btn btn-primary px-5">Browse Events</a>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Pagination -->
            <% if(totalPages > 1) { %>
                <div class="pagination-wrap">
                    <p class="text-dim small m-0">Page <strong class="text-white"><%= currentPage %></strong> of <%= totalPages %></p>
                    <div class="page-btns">
                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <a href="?filter=<%= filter %>&page=<%= i %>" class="action-btn <%= i == currentPage ? 'active-page' : '' %>">
                                <%= i %>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>

        </main>
    </div>

    <script>
        if (window.socket) {
            window.socket.on('bookingStatusUpdate', () => {
                setTimeout(() => window.location.reload(), 2000);
            });
        }
    </script>
</body>
</html>