<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/user-nav') %>

    <div class="browse-page">

        <!-- Modern Hero Section -->
        <div class="browse-hero animate stagger-1">
            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                <span class="badge-glow"><i class="fi fi-rr-sparkles me-2"></i>Discover Live Experiences</span>
                <span class="live-count-pill"><span class="pulse-dot"></span> <%= total %> Events Live</span>
            </div>
            <h1 class="hero-title">Find Your Next <span class="gradient-text">Experience</span></h1>
            <p class="hero-subtitle">Explore concerts, tech summits, workshops, and nightlife happening near you.</p>
            <div class="hero-search-wrap">
                <i class="fi fi-rr-search search-icon"></i>
                <input type="text" id="evtSearch" placeholder="Search by event name, artist, or keyword..." value="<%= filters.search %>">
                <button id="searchBtn" class="btn-hero-search">
                    <span>Search</span>
                    <i class="fi fi-rr-arrow-right"></i>
                </button>
            </div>
        </div>

        <!-- Modern Filter Dock -->
        <div class="filter-toolbar animate stagger-2">
            <div class="filter-label">
                <i class="fi fi-rr-filter"></i>
                <span>Filters</span>
            </div>

            <div class="filter-controls">
                <div class="select-wrap">
                    <i class="fi fi-rr-apps select-icon"></i>
                    <select id="evtCategory" class="filter-select" aria-label="Filter by Category">
                        <option value="all" <%= filters.category === 'all' ? 'selected' : '' %>>All Categories</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>" <%= filters.category === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="select-wrap">
                    <i class="fi fi-rr-calendar select-icon"></i>
                    <select id="evtDate" class="filter-select" aria-label="Filter by Date">
                        <option value="all" <%= filters.dateRange === 'all' ? 'selected' : '' %>>Any Date</option>
                        <option value="today" <%= filters.dateRange === 'today' ? 'selected' : '' %>>Today</option>
                        <option value="weekend" <%= filters.dateRange === 'weekend' ? 'selected' : '' %>>This Weekend</option>
                        <option value="month" <%= filters.dateRange === 'month' ? 'selected' : '' %>>This Month</option>
                    </select>
                </div>

                <div class="select-wrap">
                    <i class="fi fi-rr-tag select-icon"></i>
                    <select id="evtPrice" class="filter-select" aria-label="Filter by Price">
                        <option value="all" <%= filters.priceRange === 'all' ? 'selected' : '' %>>Any Price</option>
                        <option value="free" <%= filters.priceRange === 'free' ? 'selected' : '' %>>Free</option>
                        <option value="under500" <%= filters.priceRange === 'under500' ? 'selected' : '' %>>Under &#8377;500</option>
                        <option value="500-2000" <%= filters.priceRange === '500-2000' ? 'selected' : '' %>>&#8377;500 – &#8377;2000</option>
                        <option value="above2000" <%= filters.priceRange === 'above2000' ? 'selected' : '' %>>Above &#8377;2000</option>
                    </select>
                </div>

                <div class="select-wrap">
                    <i class="fi fi-rr-sort-alt select-icon"></i>
                    <select id="evtSort" class="filter-select" aria-label="Sort Events">
                        <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                        <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                        <option value="date-asc" <%= filters.sort === 'date-asc' ? 'selected' : '' %>>Upcoming First</option>
                        <option value="date-desc" <%= filters.sort === 'date-desc' ? 'selected' : '' %>>Furthest First</option>
                        <option value="price-asc" <%= filters.sort === 'price-asc' ? 'selected' : '' %>>Price: Low → High</option>
                        <option value="price-desc" <%= filters.sort === 'price-desc' ? 'selected' : '' %>>Price: High → Low</option>
                    </select>
                </div>
            </div>

            <div class="filter-actions">
                <button id="applyBtn" class="btn-filter-apply">
                    <i class="fi fi-rr-check me-1"></i> Apply
                </button>
                <button id="clearBtn" class="btn-filter-clear">
                    <i class="fi fi-rr-refresh me-1"></i> Reset
                </button>
            </div>

            <div class="filter-results-badge">
                <i class="fi fi-rr-chart-pie me-2"></i>
                <span><strong><%= total %></strong> result<%= total !== 1 ? 's' : '' %></span>
            </div>
        </div>

        <!-- Events Grid -->
        <% if(events && events.length > 0) { %>
        <div class="event-grid animate stagger-3">
            <% events.forEach(event => { %>
                <%- include('../../partials/event-card', { event: event }) %>
            <% }) %>
        </div>

        <!-- Pagination -->
        <% if(totalPages > 1) { %>
        <div class="pagination-wrap">
            <p class="text-dim mb-0 small">Page <strong class="text-white"><%= currentPage %></strong> of <%= totalPages %></p>
            <div class="page-btns">
                <% if(currentPage > 1) { %><button class="action-btn" onclick="changePage(<%= currentPage-1 %>)"><i class="fi fi-rr-angle-left"></i></button><% } %>
                <% for(let i=1;i<=totalPages;i++) { %><button class="action-btn <%= i==currentPage?'active-page':'' %>" onclick="changePage(<%= i %>)"><%= i %></button><% } %>
                <% if(currentPage < totalPages) { %><button class="action-btn" onclick="changePage(<%= currentPage+1 %>)"><i class="fi fi-rr-angle-right"></i></button><% } %>
            </div>
        </div>
        <% } %>

        <% } else { %>
        <div class="empty-state animate stagger-3">
            <div class="empty-icon-glow">
                <div class="icon-circle">
                    <i class="fi fi-rr-search-alt"></i>
                </div>
            </div>
            <h4 class="fw-bold text-white mb-2">No Matching Events Found</h4>
            <p class="text-dim mb-4" style="max-width: 420px; margin: 0 auto;">We couldn't find any events matching your current filters. Try widening your search criteria or resetting the filters to discover more experiences!</p>
            <button onclick="window.location.href=window.location.pathname" class="btn-reset-filters">
                <i class="fi fi-rr-refresh me-2"></i> Reset All Filters
            </button>
        </div>
        <% } %>

    </div><!-- /browse-page -->

    <script>
        const IS_LOGGED_IN = <%= isLoggedIn %>;

        async function toggleWishlist(e, eventId, btn) {
            e.stopPropagation();
            if (!IS_LOGGED_IN) {
                if (typeof openLoginModal === 'function') openLoginModal('Please login to save events to your wishlist');
                else window.location.href = '/user/login?message=Please login to save events';
                return;
            }
            try {
                const res = await axios.post(`/user/events/${eventId}/wishlist`, {}, {
                    headers: { 'Accept': 'application/json' }
                });
                if (res.data.success) {
                    const active = res.data.wishlisted;
                    btn.classList.toggle('wishlisted', active);
                    btn.querySelector('i').className = active ? 'fi fi-sr-heart' : 'fi fi-rr-heart';
                    btn.title = active ? 'Remove from wishlist' : 'Add to wishlist';
                    Toast[active ? 'success' : 'info'](res.data.message);
                }
            } catch (err) {
                if (err.response?.status === 401) {
                    if (typeof openLoginModal === 'function') openLoginModal('Please login to save events to your wishlist');
                    else window.location.href = '/user/login?message=Please login to save events';
                } else {
                    Toast.error('Could not update wishlist. Try again.');
                }
            }
        }

        function changePage(p) {
            const url = new URL(window.location.href);
            url.searchParams.set('page', p);
            window.location.href = url.toString();
        }
        function applyFilters() {
            const search = document.getElementById('evtSearch').value.trim();
            const category = document.getElementById('evtCategory').value;
            const sort = document.getElementById('evtSort').value;
            const dateRange = document.getElementById('evtDate').value;
            const priceRange = document.getElementById('evtPrice').value;
            const url = new URL(window.location.origin + window.location.pathname);

            if (search) url.searchParams.set('search', search);
            if (category !== 'all') url.searchParams.set('category', category);
            if (sort !== 'newest') url.searchParams.set('sort', sort);
            if (dateRange !== 'all') url.searchParams.set('dateRange', dateRange);
            if (priceRange !== 'all') url.searchParams.set('priceRange', priceRange);

            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        }
        document.addEventListener('DOMContentLoaded', () => {
            const applyBtn = document.getElementById('applyBtn');
            const clearBtn = document.getElementById('clearBtn');
            const searchBtn = document.getElementById('searchBtn');
            const evtSearch = document.getElementById('evtSearch');
            if (applyBtn) applyBtn.addEventListener('click', applyFilters);
            if (clearBtn) clearBtn.addEventListener('click', () => window.location.href = window.location.pathname);
            if (searchBtn) searchBtn.addEventListener('click', applyFilters);
            if (evtSearch) evtSearch.addEventListener('keypress', e => { if(e.key==='Enter') applyFilters(); });
        });
    </script>
</body>
</html>
