<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/user-nav') %>

    <!-- â”€â”€ Full-Width Hero Banner â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="event-hero">
        <% if(event.banners && event.banners.length > 0) { %>
            <img src="<%= event.banners[0] %>" class="event-hero-img" id="mainBanner" alt="<%= event.title %>">
        <% } else { %>
            <div class="event-hero-placeholder">
                <i class="fi fi-rr-picture" style="font-size:5rem;color:rgba(255,255,255,0.07);"></i>
            </div>
        <% } %>
        <div class="event-hero-overlay"></div>
        <div class="event-hero-content animate stagger-1">
            <span class="event-category-pill"><%= event.category?.name %></span>
            <h1 class="event-hero-title"><%= event.title %></h1>
            <p class="event-hero-organizer">
                Hosted by <strong style="color:rgba(255,255,255,0.85)"><%= event.organizer?.organizationName || event.organizer?.fullName %></strong>
            </p>
        </div>
    </div>

    <!-- Banner thumbnails (only if multiple banners) -->
    <% if(event.banners && event.banners.length > 1) { %>
    <div class="banner-thumbs-bar">
        <% event.banners.forEach((b, i) => { %>
            <img src="<%= b %>" class="banner-thumb <%= i===0?'active':'' %>" onclick="switchBanner(this,'<%= b %>')">
        <% }) %>
    </div>
    <% } %>

    <!-- â”€â”€ Main Content â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="detail-container">

        <!-- Back Link + Wishlist Row -->
        <div class="d-flex justify-content-between align-items-center mb-4 animate stagger-1">
            <a href="/user/events" style="color:rgba(255,255,255,0.4);font-size:0.85rem;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:color 0.2s;"
               onmouseover="this.style.color='white'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">
                <i class="fi fi-rr-arrow-left"></i> Back to Events
            </a>
            <% if(locals.user) { %>
            <button id="wishlistBtn" onclick="toggleWishlist('<%= event._id %>')" class="wishlist-btn <%= isWishlisted ? 'wishlisted' : '' %>">
                <i class="fi fi-rr-heart"></i>
                <span><%= isWishlisted ? 'Wishlisted' : 'Add to Wishlist' %></span>
            </button>
            <% } %>
        </div>

        <!-- Quick Stats Bar -->
        <div class="quick-stats animate stagger-2">
            <div class="stat-item">
                <div class="stat-icon"><i class="fi fi-rr-calendar-clock"></i></div>
                <div>
                    <p class="stat-label mb-0">Start</p>
                    <p class="stat-value mb-0"><%= new Date(event.startDate).toLocaleDateString(undefined,{day:'numeric',month:'short',year:'numeric'}) %> &middot; <%= formatTime12(event.startTime) %></p>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon"><i class="fi fi-rr-calendar-check"></i></div>
                <div>
                    <p class="stat-label mb-0">End</p>
                    <p class="stat-value mb-0"><%= new Date(event.endDate).toLocaleDateString(undefined,{day:'numeric',month:'short',year:'numeric'}) %> &middot; <%= formatTime12(event.endTime) %></p>
                </div>
            </div>
            <div class="stat-item" style="flex:2;">
                <div class="stat-icon"><i class="fi fi-rr-marker"></i></div>
                <div>
                    <p class="stat-label mb-0">Venue</p>
                    <p class="stat-value mb-0"><%= event.location.address %></p>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- â”€â”€ Left Column â”€â”€ -->
            <div class="col-lg-8">

                <!-- About -->
                <div class="info-card animate stagger-3">
                    <p class="section-label">About This Event</p>
                    <p class="text-dim mb-0" style="line-height:1.9;white-space:pre-wrap;font-size:0.93rem;"><%= event.description %></p>
                </div>

                <% if(event.schedule && event.schedule.length > 0) { %>
                <!-- Schedule / Itinerary -->
                <div class="info-card animate stagger-3">
                    <p class="section-label"><i class="fi fi-rr-calendar-clock me-1 text-primary"></i> Schedule & Itinerary</p>
                    <div class="schedule-timeline d-flex flex-column gap-3">
                        <% event.schedule.forEach((item, idx) => { %>
                        <div class="schedule-item d-flex gap-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                            <div class="schedule-time text-end" style="min-width: 100px; flex-shrink: 0; border-right: 2px solid var(--primary); padding-right: 1rem;">
                                <% if(item.date) { %>
                                <div style="font-size: 0.75rem; color: var(--primary); font-weight: 700; text-transform: uppercase;"><%= new Date(item.date).toLocaleDateString(undefined, {month:'short', day:'numeric'}) %></div>
                                <% } %>
                                <div style="font-size: 0.9rem; color: white; font-weight: 600;"><%= item.startTime ? formatTime12(item.startTime) : '' %> <%= item.endTime ? '- ' + formatTime12(item.endTime) : '' %></div>
                            </div>
                            <div class="schedule-info">
                                <h6 class="text-white fw-bold mb-1" style="font-size: 0.95rem;"><%= item.title || 'Event Session' %></h6>
                                <% if(item.description) { %>
                                <p class="text-dim mb-0" style="font-size: 0.85rem; line-height: 1.5;"><%= item.description %></p>
                                <% } %>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <% if(event.artists || event.guests) { %>
                <!-- Lineup -->
                <div class="info-card animate stagger-3">
                    <p class="section-label"><i class="fi fi-rr-star me-1 text-warning"></i> Artist & Guest Lineup</p>
                    <div class="row g-3">
                        <% if(event.artists) { %>
                        <div class="col-md-6">
                            <h6 class="text-white small fw-bold mb-2"><i class="fi fi-rr-mic me-1 text-primary"></i> Featured Artists</h6>
                            <p class="text-dim mb-0" style="font-size: 0.9rem; white-space: pre-wrap;"><%= event.artists %></p>
                        </div>
                        <% } %>
                        <% if(event.guests) { %>
                        <div class="col-md-6">
                            <h6 class="text-white small fw-bold mb-2"><i class="fi fi-rr-user-star me-1 text-warning"></i> Special Guests</h6>
                            <p class="text-dim mb-0" style="font-size: 0.9rem; white-space: pre-wrap;"><%= event.guests %></p>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } %>

                <% if(event.agenda || event.thingsToCarry || event.notAllowedItems || event.aboutEvent) { %>
                <!-- Event Guide -->
                <div class="info-card animate stagger-3">
                    <p class="section-label"><i class="fi fi-rr-book-open-cover me-1 text-info"></i> Event Guide & Instructions</p>
                    <% if(event.aboutEvent) { %>
                        <div class="mb-4">
                            <h6 class="text-white small fw-bold mb-1">Overview</h6>
                            <p class="text-dim mb-0" style="font-size: 0.9rem; white-space: pre-wrap;"><%= event.aboutEvent %></p>
                        </div>
                    <% } %>
                    <% if(event.agenda) { %>
                        <div class="mb-4">
                            <h6 class="text-white small fw-bold mb-1"><i class="fi fi-rr-list-check me-1 text-success"></i> Detailed Agenda</h6>
                            <p class="text-dim mb-0" style="font-size: 0.9rem; white-space: pre-wrap;"><%= event.agenda %></p>
                        </div>
                    <% } %>
                    <div class="row g-3">
                        <% if(event.thingsToCarry) { %>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3" style="background: rgba(46, 204, 113, 0.05); border: 1px solid rgba(46, 204, 113, 0.15); height: 100%;">
                                <h6 class="small fw-bold mb-2" style="color: #2ecc71;"><i class="fi fi-rr-check-circle me-1"></i> Things To Carry</h6>
                                <p class="text-dim mb-0" style="font-size: 0.85rem; white-space: pre-wrap;"><%= event.thingsToCarry %></p>
                            </div>
                        </div>
                        <% } %>
                        <% if(event.notAllowedItems) { %>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3" style="background: rgba(230, 57, 70, 0.05); border: 1px solid rgba(230, 57, 70, 0.15); height: 100%;">
                                <h6 class="small fw-bold mb-2" style="color: #e63946;"><i class="fi fi-rr-ban me-1"></i> Prohibited Items</h6>
                                <p class="text-dim mb-0" style="font-size: 0.85rem; white-space: pre-wrap;"><%= event.notAllowedItems %></p>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } %>

                <% if(event.faqs) { %>
                <!-- FAQs -->
                <div class="info-card animate stagger-3">
                    <p class="section-label"><i class="fi fi-rr-interrogation me-1 text-primary"></i> Frequently Asked Questions</p>
                    <p class="text-dim mb-0" style="font-size: 0.9rem; white-space: pre-wrap; line-height: 1.7;"><%= event.faqs %></p>
                </div>
                <% } %>

                <% if(event.policies || event.ageRestriction) { %>
                <!-- Policies -->
                <div class="info-card animate stagger-4">
                    <p class="section-label"><i class="fi fi-rr-shield-check me-1 text-primary"></i> Policies & Terms</p>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6 col-md-4">
                            <div class="p-2 rounded-2" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); font-size: 0.82rem;">
                                <span class="text-dim d-block" style="font-size: 0.72rem; text-transform: uppercase;">Age Limit</span>
                                <strong class="text-white"><%= event.ageRestriction || 'All Ages' %></strong>
                            </div>
                        </div>
                        <% if(event.policies && event.policies.cancellation) { %>
                        <div class="col-sm-6 col-md-4">
                            <div class="p-2 rounded-2" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); font-size: 0.82rem;">
                                <span class="text-dim d-block" style="font-size: 0.72rem; text-transform: uppercase;">Refund Policy</span>
                                <strong class="text-white">
                                    <%= event.policies.cancellation === 'no_refund' ? 'Non-Refundable' : (event.policies.cancellation === '100_before_48' ? '100% Refund (48h prior)' : 'Partial Refund') %>
                                </strong>
                            </div>
                        </div>
                        <% } %>
                        <% if(event.policies && event.policies.photographyConsent !== undefined) { %>
                        <div class="col-sm-6 col-md-4">
                            <div class="p-2 rounded-2" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); font-size: 0.82rem;">
                                <span class="text-dim d-block" style="font-size: 0.72rem; text-transform: uppercase;">Photography</span>
                                <strong class="text-white"><%= event.policies.photographyConsent ? 'Allowed / Consent' : 'Restricted' %></strong>
                            </div>
                        </div>
                        <% } %>
                    </div>
                    <% if(event.policies && event.policies.terms) { %>
                        <div class="mt-3">
                            <h6 class="text-white small fw-bold mb-1">Terms & Conditions</h6>
                            <p class="text-dim mb-2" style="font-size: 0.85rem; white-space: pre-wrap;"><%= event.policies.terms %></p>
                        </div>
                    <% } %>
                    <% if(event.policies && event.policies.covidGuidelines) { %>
                        <div class="mt-3">
                            <h6 class="text-white small fw-bold mb-1">Safety & Health Guidelines</h6>
                            <p class="text-dim mb-0" style="font-size: 0.85rem; white-space: pre-wrap;"><%= event.policies.covidGuidelines %></p>
                        </div>
                    <% } %>
                </div>
                <% } %>

                <!-- Organizer Info -->
                <div class="info-card animate stagger-4">
                    <p class="section-label"><i class="fi fi-rr-user me-1 text-primary"></i> About The Organizer</p>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div style="width: 50px; height: 50px; border-radius: 50%; background: rgba(230,57,70,0.15); border: 1px solid rgba(230,57,70,0.3); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; color: var(--primary); font-weight: 700; overflow: hidden; flex-shrink: 0;">
                            <% if(event.organizerInfo && event.organizerInfo.logo) { %>
                                <img src="<%= event.organizerInfo.logo %>" alt="Logo" style="width:100%; height:100%; object-fit:cover;">
                            <% } else { %>
                                <%= (event.organizerInfo?.name || event.organizer?.organizationName || event.organizer?.fullName || 'O').charAt(0).toUpperCase() %>
                            <% } %>
                        </div>
                        <div>
                            <h6 class="text-white fw-bold mb-1"><%= event.organizerInfo?.name || event.organizer?.organizationName || event.organizer?.fullName || 'Event Organizer' %></h6>
                            <% if(event.organizerInfo?.email || event.organizer?.email) { %>
                            <p class="text-dim mb-0 small"><i class="fi fi-rr-envelope me-1"></i><%= event.organizerInfo?.email || event.organizer?.email %></p>
                            <% } %>
                        </div>
                    </div>
                    <% if(event.organizerInfo && (event.organizerInfo.website || event.organizerInfo.instagram || event.organizerInfo.facebook || event.organizerInfo.twitter)) { %>
                    <div class="d-flex gap-3 pt-2 border-top border-white border-opacity-10">
                        <% if(event.organizerInfo.website) { %>
                        <a href="<%= event.organizerInfo.website.startsWith('http') ? event.organizerInfo.website : 'https://' + event.organizerInfo.website %>' target="_blank" class="text-dim text-decoration-none small" onmouseover="this.style.color='white'" onmouseout="this.style.color='rgba(255,255,255,0.6)'"><i class="fi fi-rr-globe me-1"></i>Website</a>
                        <% } %>
                        <% if(event.organizerInfo.instagram) { %>
                        <a href="https://instagram.com/<%= event.organizerInfo.instagram.replace('@','') %>" target="_blank" class="text-dim text-decoration-none small" onmouseover="this.style.color='white'" onmouseout="this.style.color='rgba(255,255,255,0.6)'"><i class="fi fi-brands-instagram me-1"></i>Instagram</a>
                        <% } %>
                        <% if(event.organizerInfo.twitter) { %>
                        <a href="https://twitter.com/<%= event.organizerInfo.twitter.replace('@','') %>" target="_blank" class="text-dim text-decoration-none small" onmouseover="this.style.color='white'" onmouseout="this.style.color='rgba(255,255,255,0.6)'"><i class="fi fi-brands-twitter me-1"></i>Twitter</a>
                        <% } %>
                    </div>
                    <% } %>
                </div>

                <!-- Map -->
                <div class="info-card animate stagger-4">
                    <p class="section-label">Venue Location</p>
                    <p class="text-dim small mb-3"><i class="fi fi-rr-marker me-1"></i><%= event.location.address %></p>
                    <div id="eventMap"></div>
                </div>
            </div>

            <!-- ── Right Column: Ticket Panel ── -->
            <div class="col-lg-4 animate stagger-3">
                <div class="ticket-panel text-center p-4">
                    <h5 class="text-white fw-bold mb-3" style="font-size: 1.4rem;">Ready to join?</h5>
                    <p class="text-dim mb-4" style="font-size: 0.9rem;">Secure your spot before tickets sell out.</p>
                    
                    <% 
                        let isClosed = false;
                        let closedTitle = 'Event Finished';
                        let closedMessage = 'Bookings are now closed.';
                        if (event.status === 'cancelled') {
                            isClosed = true;
                            closedTitle = 'Event Cancelled';
                            closedMessage = 'This event has been cancelled by the organizer.';
                        } else if (event.endDate) {
                            const endDateObj = new Date(event.endDate);
                            if (event.endTime) {
                                const [hours, minutes] = event.endTime.split(':');
                                endDateObj.setHours(parseInt(hours, 10), parseInt(minutes, 10), 0, 0);
                            } else {
                                endDateObj.setHours(23, 59, 59, 999);
                            }
                            if (new Date() > endDateObj) {
                                isClosed = true;
                            }
                        }
                        if (!isClosed && event.postStartRegistrationLimit !== null && event.postStartRegistrationLimit !== undefined) {
                            const startDateObj = new Date(event.startDate);
                            if (event.startTime) {
                                const [startHours, startMinutes] = event.startTime.split(':');
                                startDateObj.setHours(parseInt(startHours, 10), parseInt(startMinutes, 10), 0, 0);
                            } else {
                                startDateObj.setHours(0, 0, 0, 0);
                            }
                            const cutoff = new Date(startDateObj.getTime() + event.postStartRegistrationLimit * 60000);
                            if (new Date() > cutoff) {
                                isClosed = true;
                                closedTitle = 'Registration Closed';
                                closedMessage = event.postStartRegistrationLimit === 0 
                                    ? 'Ticket sales ended when the event started.' 
                                    : `Ticket sales ended ${event.postStartRegistrationLimit} minutes after event start.`;
                            }
                        }
                        if (!isClosed && event.bookingCloseTime) {
                            const closeDateStr = new Date(event.endDate || event.startDate).toISOString().split('T')[0];
                            const closeDateObj = new Date(`${closeDateStr}T${event.bookingCloseTime}:00+05:30`);
                            if (new Date() > closeDateObj) {
                                isClosed = true;
                                closedTitle = 'Booking Closed';
                                closedMessage = `Ticket sales for this event closed at ${event.bookingCloseTime}.`;
                            }
                        }
                        let isBookingNotOpen = false;
                        let bookingOpenDateObj = null;
                        if (!isClosed && event.bookingOpenTime) {
                            const startDateStr = new Date(event.startDate).toISOString().split('T')[0];
                            bookingOpenDateObj = new Date(`${startDateStr}T${event.bookingOpenTime}:00+05:30`);
                            if (new Date() < bookingOpenDateObj) {
                                isBookingNotOpen = true;
                            }
                        }
                    %>
                    
                    <% if (isClosed) { %>
                        <div class="p-3 mb-3" style="background: rgba(230, 57, 70, 0.1); border: 1px dashed rgba(230, 57, 70, 0.3); border-radius: 12px;">
                            <h5 class="fw-bold mb-1" style="color: #e63946;"><%= closedTitle %></h5>
                            <p class="text-dim mb-0" style="font-size: 0.85rem;"><%= closedMessage %></p>
                        </div>
                    <% } else if (isBookingNotOpen) { %>
                        <div class="p-3 mb-3 text-center" style="background: rgba(255, 193, 7, 0.08); border: 1px dashed rgba(255, 193, 7, 0.4); border-radius: 16px; backdrop-filter: blur(10px);">
                            <h6 class="fw-bold mb-3 d-flex align-items-center justify-content-center gap-2" style="color: #ffc107; font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">
                                <i class="fi fi-rr-clock"></i> Booking Opens In
                            </h6>
                            <div id="bookingCountdown" class="d-flex justify-content-center gap-2 mb-3" data-target="<%= bookingOpenDateObj.toISOString() %>">
                                <div class="p-2 rounded-3 text-white shadow-sm" style="background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); min-width: 55px;">
                                    <span class="fs-4 fw-bold d-block lh-1 mb-1" id="cd-days" style="color: #ffc107;">00</span>
                                    <span style="font-size: 0.65rem; letter-spacing: 1px;" class="text-dim fw-semibold">DAYS</span>
                                </div>
                                <div class="p-2 rounded-3 text-white shadow-sm" style="background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); min-width: 55px;">
                                    <span class="fs-4 fw-bold d-block lh-1 mb-1" id="cd-hours" style="color: #ffc107;">00</span>
                                    <span style="font-size: 0.65rem; letter-spacing: 1px;" class="text-dim fw-semibold">HOURS</span>
                                </div>
                                <div class="p-2 rounded-3 text-white shadow-sm" style="background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); min-width: 55px;">
                                    <span class="fs-4 fw-bold d-block lh-1 mb-1" id="cd-mins" style="color: #ffc107;">00</span>
                                    <span style="font-size: 0.65rem; letter-spacing: 1px;" class="text-dim fw-semibold">MINS</span>
                                </div>
                                <div class="p-2 rounded-3 text-white shadow-sm" style="background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); min-width: 55px;">
                                    <span class="fs-4 fw-bold d-block lh-1 mb-1" id="cd-secs" style="color: #ffc107;">00</span>
                                    <span style="font-size: 0.65rem; letter-spacing: 1px;" class="text-dim fw-semibold">SECS</span>
                                </div>
                            </div>
                            <p class="text-dim mb-0" style="font-size: 0.85rem;">Sales open on <strong class="text-white"><%= bookingOpenDateObj.toLocaleDateString(undefined, {month:'short', day:'numeric'}) %></strong> at <strong class="text-white"><%= formatTime12(event.bookingOpenTime) %></strong></p>
                        </div>
                        <button disabled class="btn btn-secondary w-100 shadow-sm" style="height: 3.2rem; display: flex; align-items: center; justify-content: center; border-radius: 12px; font-size: 1.05rem; font-weight: 600; opacity: 0.6; cursor: not-allowed; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.6);">
                            <i class="fi fi-rr-lock me-2"></i> Booking Not Open Yet
                        </button>
                    <% } else { %>
                        <a href="/user/events/<%= event._id %>/buy-tickets" class="btn btn-primary w-100 shadow-sm" style="height: 3.2rem; display: flex; align-items: center; justify-content: center; border-radius: 12px; font-size: 1.05rem; font-weight: 600;">
                            Get Tickets
                        </a>

                        <div class="text-center mt-4">
                            <p class="text-dim mb-0" style="font-size:0.75rem;"><i class="fi fi-rr-shield-check me-1"></i> Secure booking &middot; Instant confirmation</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div><!-- /detail-container -->

    <!-- â”€â”€ Booking Modal â”€â”€ -->
    <div class="booking-overlay" id="bookingOverlay">
        <div class="booking-modal-box">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <p class="text-dim small mb-0">Book Ticket</p>
                    <h5 class="fw-bold text-white mb-0" id="modalTicketName"></h5>
                </div>
                <button class="close-modal-btn" onclick="closeBookingModal()">Ã—</button>
            </div>

            <p class="text-dim small mb-2">Quantity</p>
            <div class="qty-row">
                <button class="qty-btn" onclick="changeQty(-1)">âˆ’</button>
                <span class="qty-display" id="qtyDisplay">1</span>
                <button class="qty-btn" onclick="changeQty(1)">+</button>
            </div>
            <p class="text-dim text-center mb-3" style="font-size:0.78rem; margin-top:-0.5rem;">
                Max <span id="maxQtyDisplay">1</span> per person
            </p>

            <div class="modal-total">
                <span class="text-dim">Total</span>
                <span class="fw-bold text-white" style="font-size:1.3rem;" id="modalTotal">₹0</span>
            </div>

            <button class="btn btn-primary w-100" style="height:3rem;border-radius:10px;font-size:0.97rem;font-weight:600;" onclick="proceedToCheckout()">
                <i class="fi fi-rr-shopping-cart me-2"></i>Proceed to Checkout
            </button>
            <p class="text-dim text-center mt-2 mb-0" style="font-size:0.76rem;"><i class="fi fi-rr-shield-check me-1"></i> No hidden fees</p>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Map
        const map = L.map('eventMap').setView([<%= event.location.lat %>, <%= event.location.lng %>], 15);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap &copy; CARTO', subdomains: 'abcd', maxZoom: 20
        }).addTo(map);
        const customIcon = L.divIcon({
            html: '<div style="width:14px;height:14px;background:#E63946;border-radius:50%;border:3px solid white;box-shadow:0 0 14px rgba(230,57,70,0.7);"></div>',
            iconSize: [14,14], iconAnchor: [7,7]
        });
        L.marker([<%= event.location.lat %>, <%= event.location.lng %>], { icon: customIcon }).addTo(map)
            .bindPopup(`<b><%= event.title %></b><br><small><%= event.location.address %></small>`).openPopup();

        // Banner switch
        function switchBanner(thumb, src) {
            document.getElementById('mainBanner').src = src;
            document.querySelectorAll('.banner-thumb').forEach(t => t.classList.remove('active'));
            thumb.classList.add('active');
        }

        // Modal state
        let curTicketId = '', curPrice = 0, curQty = 1, curMax = 1;

        function openBookingModal(tid, name, price, maxQty) {
            <% if(!locals.user) { %> if (typeof openLoginModal === 'function') { openLoginModal('Please login to book tickets'); } else { window.location.href = '/user/login'; } return; <% } %>
            curTicketId = tid; curPrice = price; curQty = 1; curMax = maxQty;
            document.getElementById('modalTicketName').textContent = name;
            document.getElementById('maxQtyDisplay').textContent = maxQty;
            updateModalQty();
            document.getElementById('bookingOverlay').classList.add('open');
        }
        function closeBookingModal() { document.getElementById('bookingOverlay').classList.remove('open'); }
        function updateModalQty() {
            document.getElementById('qtyDisplay').textContent = curQty;
            const total = curPrice * curQty;
            document.getElementById('modalTotal').textContent = total === 0 ? 'Free' : '₹' + total.toLocaleString('en-IN');
        }
        function changeQty(d) {
            curQty = Math.max(1, Math.min(curMax, curQty + d));
            updateModalQty();
        }
        function proceedToCheckout() {
            window.location.href = `/user/events/<%= event._id %>/checkout?ticketId=${curTicketId}&quantity=${curQty}`;
        }
        document.getElementById('bookingOverlay').addEventListener('click', e => {
            if (e.target.id === 'bookingOverlay') closeBookingModal();
        });

        // Wishlist
        async function toggleWishlist(eventId) {
            try {
                const res = await axios.post(`/user/events/${eventId}/wishlist`);
                if (res.data.success) {
                    Toast.success(res.data.message);
                    const btn = document.getElementById('wishlistBtn');
                    if (res.data.wishlisted) {
                        btn.classList.add('wishlisted');
                        btn.querySelector('span').textContent = 'Wishlisted';
                    } else {
                        btn.classList.remove('wishlisted');
                        btn.querySelector('span').textContent = 'Add to Wishlist';
                    }
                }
            } catch (err) {
                if (err.response?.status === 401) {
                    if (typeof openLoginModal === 'function') openLoginModal('Please login to save events to your wishlist');
                    else window.location.href = '/user/login';
                } else Toast.error('Failed to update wishlist');
            }
        }

        // Booking Open Countdown Timer
        document.addEventListener('DOMContentLoaded', function() {
            const cdEl = document.getElementById('bookingCountdown');
            if (cdEl) {
                const target = new Date(cdEl.getAttribute('data-target')).getTime();
                const timer = setInterval(function() {
                    const now = new Date().getTime();
                    const distance = target - now;
                    if (distance <= 0) {
                        clearInterval(timer);
                        window.location.reload(); // Reload page when countdown reaches zero so user can buy instantly!
                        return;
                    }
                    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                    
                    const daysEl = document.getElementById('cd-days');
                    const hoursEl = document.getElementById('cd-hours');
                    const minsEl = document.getElementById('cd-mins');
                    const secsEl = document.getElementById('cd-secs');
                    if (daysEl) daysEl.innerText = String(days).padStart(2, '0');
                    if (hoursEl) hoursEl.innerText = String(hours).padStart(2, '0');
                    if (minsEl) minsEl.innerText = String(minutes).padStart(2, '0');
                    if (secsEl) secsEl.innerText = String(seconds).padStart(2, '0');
                }, 1000);
            }
        });
    </script>
</body>
</html>
