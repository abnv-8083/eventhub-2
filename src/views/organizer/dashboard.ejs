<%- include('../partials/head') %>
<body class="bg-mesh">
    <%- include('../partials/navbars/organizer-nav') %>
    <div class="dashboard-layout">
        <%- include('../partials/organizer-sidebar') %>
        <main class="dashboard-main">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-5 animate stagger-1">
                <div>
                    <h2 class="fw-bold">Overview</h2>
                    <p class="text-dim m-0">Welcome back, <strong style="color:rgba(255,255,255,0.8)"><%= organizer.organizationName || organizer.fullName %></strong></p>
                </div>
                <a href="/organizer/events/new" class="btn btn-primary">
                    <i class="fi fi-rr-plus me-2"></i>Create Event
                </a>
            </div>

            <!-- Stats Grid -->
            <div class="row g-4 mb-5 animate stagger-2">
                <div class="col-sm-6 col-lg-3">
                    <div class="glass-dark p-4 rounded-3" style="border:1px solid rgba(255,255,255,0.07);">
                        <p class="text-dim small text-uppercase fw-bold mb-2" style="letter-spacing:0.07em;">Total Revenue</p>
                        <h3 class="fw-bold text-white m-0" style="font-size:2rem;">₹<%= totalRevenue.toLocaleString('en-IN') %></h3>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="glass-dark p-4 rounded-3" style="border:1px solid rgba(255,255,255,0.07);">
                        <p class="text-dim small text-uppercase fw-bold mb-2" style="letter-spacing:0.07em;">Tickets Sold</p>
                        <h3 class="fw-bold text-white m-0" style="font-size:2rem;"><%= totalTicketsSold %></h3>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="glass-dark p-4 rounded-3" style="border:1px solid rgba(255,255,255,0.07); border-left: 3px solid #2ecc71;">
                        <p class="text-dim small text-uppercase fw-bold mb-2" style="letter-spacing:0.07em;">Active Events</p>
                        <h3 class="fw-bold text-white m-0" style="font-size:2rem;"><%= activeEvents %></h3>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="glass-dark p-4 rounded-3" style="border:1px solid rgba(255,255,255,0.07);">
                        <p class="text-dim small text-uppercase fw-bold mb-2" style="letter-spacing:0.07em;">Total Events</p>
                        <h3 class="fw-bold text-white m-0" style="font-size:2rem;"><%= totalEvents %></h3>
                    </div>
                </div>
            </div>

            <!-- Recent Events Table -->
            <div class="glass-dark p-4 rounded-3 animate stagger-3" style="border:1px solid rgba(255,255,255,0.07);">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold m-0">Recent Events</h5>
                    <a href="/organizer/events" class="text-dim small" style="text-decoration:none;">View all →</a>
                </div>
                <div style="overflow-x:auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(recentEvents && recentEvents.length > 0) { %>
                                <% recentEvents.forEach(event => { %>
                                <tr style="cursor:pointer;" onclick="window.location.href='/organizer/events'">
                                    <td>
                                        <p class="fw-bold text-white mb-0" style="font-size:0.9rem;"><%= event.title %></p>
                                        <p class="text-dim mb-0" style="font-size:0.77rem;"><%= event.category?.name %></p>
                                    </td>
                                    <td class="text-dim" style="font-size:0.85rem;">
                                        <%= new Date(event.startDate).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                                    </td>
                                    <td>
                                        <span class="status-badge status-<%= event.status %>"><%= event.status %></span>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="3" class="text-center p-5 text-dim">No events yet. <a href="/organizer/events/new" style="color:var(--primary);">Create your first event →</a></td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</body>
</html>