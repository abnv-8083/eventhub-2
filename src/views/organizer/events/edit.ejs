<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/organizer-nav') %>
    <div class="dashboard-layout">
        <%- include('../../partials/organizer-sidebar', { title: 'Manage Events' }) %>
        <main class="dashboard-main">

            <div class="d-flex align-items-center mb-4 animate stagger-1">
                <a href="/organizer/events/<%= event._id %>" class="btn btn-outline btn-sm me-3 px-3" style="border-radius:10px;">
                    <i class="fi fi-rr-arrow-left me-1"></i> Back
                </a>
                <div>
                    <h2 class="fw-bold m-0" style="letter-spacing:-0.5px;">Edit Event</h2>
                    <p class="text-dim m-0 small"><%= event.title %></p>
                </div>
            </div>

            <form id="editEventForm" novalidate>
                <div class="row g-4 animate stagger-2">

                    <!-- LEFT: Main Details -->
                    <div class="col-lg-8">
                        <div class="glass-premium-panel mb-4">
                            <p class="section-title"><i class="fi fi-rr-info"></i> Basic Information</p>

                            <div class="form-floating mb-4">
                                <input type="text" id="title" name="title" class="form-control input" placeholder=" " value="<%= event.title %>" data-rule="required, min5">
                                <label>Event Title</label>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-12">
                                    <label class="form-label text-dim mb-3 d-block">Select Category</label>
                                    <div class="category-selector">
                                        <% categories.forEach(cat => { %>
                                            <label class="category-option">
                                                <input type="radio" name="category" value="<%= cat.id %>" required <%= event.category === cat.id ? 'checked' : '' %>>
                                                <div class="category-card">
                                                    <i class="fi <%= cat.icon %>"></i>
                                                    <span><%= cat.name %></span>
                                                </div>
                                            </label>
                                        <% }) %>
                                    </div>
                                </div>
                                <div class="col-md-12 mt-3">
                                    <div class="d-flex justify-content-between align-items-center px-4 rounded-3"
                                        style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.08);height:3.6rem;border-radius:12px!important;">
                                        <span style="font-weight:500;color:white;">Feature Event?</span>
                                        <label class="modern-switch m-0">
                                            <input type="checkbox" id="isFeatured" name="isFeatured" value="true" <%= event.isFeatured?'checked':'' %>>
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <p class="section-title"><i class="fi fi-rr-calendar"></i> Date & Time</p>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input type="date" id="startDate" name="startDate" class="form-control input" placeholder=" " value="<%= event.startDate ? event.startDate.toISOString().split('T')[0] : '' %>" data-rule="required, date">
                                        <label>Start Date</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input type="time" id="startTime" name="startTime" class="form-control input" placeholder=" " value="<%= event.startTime || '' %>" data-rule="required">
                                        <label>Start Time</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input type="date" id="endDate" name="endDate" class="form-control input" placeholder=" " value="<%= event.endDate ? event.endDate.toISOString().split('T')[0] : '' %>" data-rule="required, date">
                                        <label>End Date</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input type="time" id="endTime" name="endTime" class="form-control input" placeholder=" " value="<%= event.endTime || '' %>" data-rule="required">
                                        <label>End Time</label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-floating mb-4">
                                <textarea id="description" name="description" class="form-control input" placeholder=" " style="height:130px;resize:none;padding-top:1.5rem;border-radius:12px;" data-rule="required, min20"><%= event.description %></textarea>
                                <label>Event Description</label>
                            </div>

                            <p class="section-title"><i class="fi fi-rr-marker"></i> Venue</p>
                            <p class="text-dim small mb-2">Click on the map to change the venue location.</p>
                            <div id="eventMap" style="height:280px;width:100%;border-radius:14px;border:1px solid rgba(255,255,255,0.08);margin-bottom:1rem;"></div>
                            <div class="form-floating">
                                <input type="text" id="address" name="address" class="form-control input" placeholder=" " value="<%= event.location.address %>" readonly>
                                <label>Detected Address</label>
                            </div>
                            <input type="hidden" id="lat" name="lat" value="<%= event.location.lat %>">
                            <input type="hidden" id="lng" name="lng" value="<%= event.location.lng %>">
                        </div>
                    </div>

                    <!-- RIGHT: Tickets + Banners -->
                    <div class="col-lg-4 d-flex flex-column gap-4">

                        <!-- Tickets Panel -->
                        <div class="glass-premium-panel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <p class="section-title m-0"><i class="fi fi-rr-ticket"></i> Ticket Tiers</p>
                                <button type="button" class="btn btn-outline btn-sm" style="border-radius:8px;font-size:0.8rem;" onclick="addTicketVariant()">
                                    <i class="fi fi-rr-plus me-1"></i> Add
                                </button>
                            </div>
                            <div id="ticketsContainer" class="d-flex flex-column gap-3"></div>
                        </div>

                        <!-- Banners Panel -->
                        <div class="glass-premium-panel">
                            <p class="section-title mb-3"><i class="fi fi-rr-picture"></i> Banners</p>
                            <p class="text-dim mb-4 text-start small">Upload high-quality images. Recommended resolution is 1920×1080px.</p>
                            
                            <div class="d-flex flex-column gap-3 mb-3">
                                <div class="banner-slot w-100" id="banner1Slot" onclick="openCropper(1)" style="min-height: 160px; border-radius: 12px; border: 2px dashed rgba(255,255,255,0.1); position: relative; overflow: hidden; cursor: pointer; background: rgba(0,0,0,0.2);">
                                    <% if(event.banners && event.banners[0]) { %>
                                        <img src="<%= event.banners[0] %>" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;">
                                    <% } else { %>
                                        <div class="placeholder-content" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:4px;padding: 2rem;">
                                            <i class="fi fi-rr-cloud-upload-alt" style="font-size: 2rem; color: rgba(255,255,255,0.5);"></i>
                                            <span style="font-weight: 600; color: rgba(255,255,255,0.5); font-size:0.9rem;">Primary Banner</span>
                                        </div>
                                    <% } %>
                                    <div class="banner-slot-overlay" style="position:absolute;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s;">
                                        <i class="fi fi-rr-edit" style="font-size: 1.5rem; color: white;"></i>
                                    </div>
                                </div>

                                <div class="banner-slot w-100" id="banner2Slot" onclick="openCropper(2)" style="min-height: 160px; border-radius: 12px; border: 2px dashed rgba(255,255,255,0.1); position: relative; overflow: hidden; cursor: pointer; background: rgba(0,0,0,0.2);">
                                    <% if(event.banners && event.banners[1]) { %>
                                        <img src="<%= event.banners[1] %>" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;">
                                    <% } else { %>
                                        <div class="placeholder-content" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:4px;padding: 2rem;">
                                            <i class="fi fi-rr-cloud-upload-alt" style="font-size: 2rem; color: rgba(255,255,255,0.5);"></i>
                                            <span style="font-weight: 600; color: rgba(255,255,255,0.5); font-size:0.9rem;">Secondary Banner</span>
                                        </div>
                                    <% } %>
                                    <div class="banner-slot-overlay" style="position:absolute;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s;">
                                        <i class="fi fi-rr-edit" style="font-size: 1.5rem; color: white;"></i>
                                    </div>
                                </div>
                            </div>
                            <input type="file" id="bannerInput1" accept="image/*" style="display:none;" onchange="onFileSelected(1)">
                            <input type="file" id="bannerInput2" accept="image/*" style="display:none;" onchange="onFileSelected(2)">
                            
                            <input type="hidden" id="existingBanner1" name="existingBanners[]" value="<%= event.banners && event.banners[0] ? event.banners[0] : '' %>">
                            <input type="hidden" id="existingBanner2" name="existingBanners[]" value="<%= event.banners && event.banners[1] ? event.banners[1] : '' %>">
                        </div>

                        <!-- Submit -->
                        <div class="d-flex flex-column gap-2">
                            <button type="submit" class="btn btn-primary w-100" style="height:3.2rem;border-radius:14px;font-weight:700;letter-spacing:0.5px;box-shadow:0 8px 25px rgba(230,57,70,0.3);">
                                <i class="fi fi-rr-check me-2"></i> Save & Publish
                            </button>
                            <button type="button" class="btn btn-outline w-100" onclick="submitDraft()" style="height:3.2rem;border-radius:14px;font-weight:600; border-color: rgba(255,255,255,0.2);">
                                <i class="fi fi-rr-disk me-2"></i> Save as Draft
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </main>
    </div>

    <div id="cropperModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 9999; align-items: center; justify-content: center;">
        <div class="cropper-modal-box glass-premium-panel" style="width: 100%; max-width: 800px; padding: 2rem; max-height: 90vh; overflow-y: auto;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold m-0" id="cropperTitle">Crop Banner</h4>
                <button type="button" onclick="closeCropper()" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius: 50%; width: 36px; height: 36px; color:white; cursor:pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
                    <i class="fi fi-rr-cross-small"></i>
                </button>
            </div>
            <div class="cropper-img-wrap mb-4" style="border: 2px dashed rgba(255,255,255,0.1); padding: 5px; border-radius: 12px; max-height: 50vh;">
                <img id="cropperImg" src="" alt="Crop" style="max-width: 100%;">
            </div>
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-end">
                <button type="button" class="btn btn-outline px-4" style="border-radius: 10px;" onclick="closeCropper()">Cancel</button>
                <button type="button" class="btn btn-primary px-5" style="border-radius: 10px; font-weight: 600;" onclick="applyCrop()">
                    Apply Crop <i class="fi fi-rr-check ms-2"></i>
                </button>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <style>
        .banner-slot:hover .banner-slot-overlay { opacity: 1 !important; }
    </style>
    <script>
        // ─── MAP ─────────────────────────────────────────────────────────────
        const initLatLng = [<%= event.location.lat %>, <%= event.location.lng %>];
        const map = L.map('eventMap').setView(initLatLng, 14);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 20 }).addTo(map);
        let marker = L.marker(initLatLng, { draggable: true }).addTo(map);

        async function updateAddress(lat, lng) {
            document.getElementById('lat').value = lat;
            document.getElementById('lng').value = lng;
            try {
                const r = await axios.get(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);
                document.getElementById('address').value = r.data.display_name || 'Custom Location';
            } catch { document.getElementById('address').value = `${lat.toFixed(4)}, ${lng.toFixed(4)}`; }
        }
        map.on('click', e => { marker.setLatLng(e.latlng); updateAddress(e.latlng.lat, e.latlng.lng); });
        marker.on('dragend', () => { const p = marker.getLatLng(); updateAddress(p.lat, p.lng); });
        setTimeout(() => map.invalidateSize(), 300);

        // ─── FILE UPLOAD & CROPPER ───────────────────────────────────────────
        let cropperInstance = null;
        let currentBannerSlot = 1;
        const croppedBlobs = { 1: null, 2: null };

        function openCropper(slot) {
            currentBannerSlot = slot;
            document.getElementById('bannerInput' + slot).click();
        }

        function onFileSelected(slot) {
            const input = document.getElementById('bannerInput' + slot);
            if (!input.files || !input.files[0]) return;
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('cropperTitle').textContent = `Crop Banner ${slot}`;
                const img = document.getElementById('cropperImg');
                img.src = e.target.result;
                document.getElementById('cropperModal').style.display = 'flex';

                if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
                setTimeout(() => {
                    cropperInstance = new Cropper(img, {
                        aspectRatio: 16 / 9,
                        viewMode: 1,
                        dragMode: 'move',
                        autoCropArea: 1,
                        restore: false,
                        guides: true,
                        center: true,
                        highlight: false,
                        cropBoxMovable: true,
                        cropBoxResizable: true,
                        toggleDragModeOnDblclick: false,
                    });
                }, 100);
            };
            reader.readAsDataURL(input.files[0]);
            input.value = ''; 
        }

        function closeCropper() {
            document.getElementById('cropperModal').style.display = 'none';
            if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
        }

        function applyCrop() {
            if (!cropperInstance) return;
            cropperInstance.getCroppedCanvas({ width: 1920, height: 1080 }).toBlob(blob => {
                croppedBlobs[currentBannerSlot] = blob;

                const url = URL.createObjectURL(blob);
                const slot = document.getElementById('banner' + currentBannerSlot + 'Slot');
                
                // Clear existing banner logic if replaced
                document.getElementById('existingBanner' + currentBannerSlot).value = '';

                const oldImg = slot.querySelector('img');
                const oldPlaceholder = slot.querySelector('.placeholder-content');
                if (oldImg) oldImg.remove();
                if (oldPlaceholder) oldPlaceholder.style.display = 'none';
                
                const img = document.createElement('img');
                img.src = url;
                img.style.width = '100%';
                img.style.height = '100%';
                img.style.objectFit = 'cover';
                img.style.position = 'absolute';
                img.style.inset = '0';
                slot.appendChild(img);
                
                closeCropper();
            }, 'image/jpeg', 0.92);
        }

        // ─── TICKETS ─────────────────────────────────────────────────────────
        const existingTickets = <%- JSON.stringify(tickets) %>;
        let ticketCount = 0;
        const ticketsContainer = document.getElementById('ticketsContainer');

        function addTicketVariant(t = { name:'', price:'', capacity:'', maxPerUser: 5 }) {
            ticketCount++;
            const div = document.createElement('div');
            div.className = 'ticket-variant';
            div.innerHTML = `
                <div class="ticket-variant-header">
                    <span class="badge" style="background:rgba(230,57,70,0.15);color:var(--primary);padding:5px 10px;font-weight:700;letter-spacing:1px;font-size:0.7rem;">TIER ${ticketCount}</span>
                    <button type="button" class="remove-ticket-btn" onclick="this.closest('.ticket-variant').remove()"><i class="fi fi-rr-trash"></i></button>
                </div>
                <div class="ticket-variant-body">
                    <input type="hidden" class="ticket-id" value="${t._id || ''}">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control input ticket-name" placeholder=" " value="${t.name}" data-rule="required">
                        <label>Ticket Name</label>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6"><div class="form-floating">
                            <input type="number" class="form-control input ticket-price" placeholder=" " value="${t.price}" data-rule="required, number" data-min="0">
                            <label>Price (₹)</label>
                        </div></div>
                        <div class="col-6"><div class="form-floating">
                            <input type="number" class="form-control input ticket-capacity" placeholder=" " value="${t.capacity}" data-rule="required, number" data-min="1">
                            <label>Capacity</label>
                        </div></div>
                    </div>
                    <div class="form-floating">
                        <input type="number" class="form-control input ticket-max" placeholder=" " value="${t.maxPerUser}" data-rule="required, number" data-min="1">
                        <label>Max Per User</label>
                    </div>
                </div>`;
            ticketsContainer.appendChild(div);
        }

        existingTickets.length > 0 ? existingTickets.forEach(t => addTicketVariant(t)) : addTicketVariant();

        // ─── DRAFT SUBMIT ────────────────────────────────────────────────────
        async function submitDraft() {
            const title = document.getElementById('title').value.trim();
            if (!title) {
                return Toast.error('Event title is required to save as draft.');
            }

            const ticketEls = ticketsContainer.querySelectorAll('.ticket-variant');
            const tickets = [];
            for (const el of ticketEls) {
                const id = el.querySelector('.ticket-id').value;
                const name = el.querySelector('.ticket-name').value.trim();
                const price = parseFloat(el.querySelector('.ticket-price').value);
                const capacity = parseInt(el.querySelector('.ticket-capacity').value);
                const max = parseInt(el.querySelector('.ticket-max').value);
                if (name) {
                    tickets.push({ 
                        _id: id ? id : undefined,
                        name: name,  
                        price: isNaN(price) ? 0 : price, 
                        capacity: isNaN(capacity) ? 1 : capacity, 
                        maxPerUser: isNaN(max) ? 1 : max 
                    });
                }
            }

            const formData = new FormData(document.getElementById('editEventForm'));
            formData.append('tickets', JSON.stringify(tickets));
            formData.append('action', 'draft');
            if (croppedBlobs[1]) formData.append('banners', croppedBlobs[1], 'banner1.jpg');
            if (croppedBlobs[2]) formData.append('banners', croppedBlobs[2], 'banner2.jpg');

            Loader.show('SAVING DRAFT...');
            try {
                const res = await axios.post('/organizer/events/<%= event._id %>/update', formData, {
                    headers: { 'Content-Type': 'multipart/form-data' }
                });
                if (res.data.success) {
                    Toast.success('Draft saved successfully!');
                    setTimeout(() => window.location.reload(), 1000);
                }
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to save draft.');
            } finally { Loader.hide(); }
        }

        // ─── SUBMIT ──────────────────────────────────────────────────────────
        document.getElementById('editEventForm').addEventListener('submit', async e => {
            e.preventDefault();

            // ── Date & Time Validation ──────────────────────────────────────────
            const startDate = document.getElementById('startDate').value;
            const startTime = document.getElementById('startTime').value;
            const endDate   = document.getElementById('endDate').value;
            const endTime   = document.getElementById('endTime').value;

            if (!startDate) return Toast.error('Start date is required.');
            if (!startTime) return Toast.error('Start time is required.');
            if (!endDate)   return Toast.error('End date is required.');
            if (!endTime)   return Toast.error('End time is required.');

            if (endDate < startDate) {
                return Toast.error('End date must be the same or after the start date.');
            }

            if (startDate === endDate && endTime <= startTime) {
                return Toast.error('End time must be after start time when the event starts and ends on the same day.');
            }

            // ── Ticket Validation ───────────────────────────────────────────────
            const ticketEls = ticketsContainer.querySelectorAll('.ticket-variant');
            if (!ticketEls.length) return Toast.error('Add at least one ticket tier.');

            const tickets = [];
            for (const el of ticketEls) {
                const id         = el.querySelector('.ticket-id').value;
                const name       = el.querySelector('.ticket-name').value.trim();
                const price      = parseFloat(el.querySelector('.ticket-price').value);
                const capacity   = parseInt(el.querySelector('.ticket-capacity').value);
                const maxPerUser = parseInt(el.querySelector('.ticket-max').value);
                if (!name || isNaN(price) || price < 0 || !capacity || capacity < 1)
                    return Toast.error('Please fill all ticket fields correctly.');
                tickets.push({ _id: id ? id : undefined, name, price, capacity, maxPerUser });
            }

            const formData = new FormData(document.getElementById('editEventForm'));
            formData.append('tickets', JSON.stringify(tickets));
            formData.append('action', 'publish');
            if (croppedBlobs[1]) formData.append('banners', croppedBlobs[1], 'banner1.jpg');
            if (croppedBlobs[2]) formData.append('banners', croppedBlobs[2], 'banner2.jpg');

            Loader.show('SAVING CHANGES...');
            try {
                const res = await axios.post('/organizer/events/<%= event._id %>/update', formData, {
                    headers: { 'Content-Type': 'multipart/form-data' }
                });
                if (res.data.success) {
                    Toast.success('Event published successfully!');
                    setTimeout(() => window.location.href = '/organizer/events/<%= event._id %>', 1500);
                }
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to update event.');
            } finally { Loader.hide(); }
        });
    </script>
</body>
</html>
