<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <style>
        .request-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            transition: all 0.3s ease;
        }
        .request-card:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/organizer-nav') %>
    
    <div class="dashboard-layout">
        <%- include('../../partials/organizer-sidebar', { title: 'Events' }) %>
        
        <main class="dashboard-main">
            
            <div class="d-flex justify-content-between align-items-center mb-4 animate stagger-1">
                <div>
                    <h2 class="fw-bold mb-1"><i class="fi fi-rr-ban text-danger me-2"></i>Event Cancellations</h2>
                    <p class="text-dim m-0">Review all cancellations and requests for <%= event.title %></p>
                </div>
                <div>
                    <a href="/organizer/events/<%= event._id %>/bookings" class="btn btn-outline fw-bold">
                        <i class="fi fi-rr-arrow-left me-2"></i>Back to Bookings
                    </a>
                </div>
            </div>

            <%# ── Status Filter Tabs ── %>
            <div class="filter-tabs mb-4 animate stagger-3">
                <a href="?status=all&sort=<%= filters.sort %>" class="filter-tab <%= filters.status === 'all' ? 'active' : '' %>">
                    All <span class="tab-count"><%= counts.all %></span>
                </a>
                <a href="?status=pending&sort=<%= filters.sort %>" class="filter-tab <%= filters.status === 'pending' ? 'active' : '' %>">
                    <i class="fi fi-rr-time-fast me-1 text-warning"></i>Pending <span class="tab-count"><%= counts.pending %></span>
                </a>
                <a href="?status=approved&sort=<%= filters.sort %>" class="filter-tab <%= filters.status === 'approved' ? 'active' : '' %>">
                    <i class="fi fi-rr-check-circle me-1 text-success"></i>Approved <span class="tab-count"><%= counts.approved %></span>
                </a>
                <a href="?status=rejected&sort=<%= filters.sort %>" class="filter-tab <%= filters.status === 'rejected' ? 'active' : '' %>">
                    <i class="fi fi-rr-cross-circle me-1 text-danger"></i>Rejected <span class="tab-count"><%= counts.rejected %></span>
                </a>
                <a href="?status=direct&sort=<%= filters.sort %>" class="filter-tab <%= filters.status === 'direct' ? 'active' : '' %>">
                    <i class="fi fi-rr-ban me-1 text-danger"></i>Direct <span class="tab-count"><%= counts.direct %></span>
                </a>
            </div>

            <%# ── Search & Sort ── %>
            <div class="d-flex justify-content-between align-items-center mb-4 gap-3 animate stagger-3">
                <div class="search-wrapper flex-grow-1" style="position:relative;max-width:380px;">
                    <i class="fi fi-rr-search text-dim" style="position:absolute;left:15px;top:50%;transform:translateY(-50%);"></i>
                    <input type="text" id="cnSearch" class="input ps-5" placeholder="Search user, email, ticket..." value="<%= filters.search || '' %>" 
                           style="height:45px; color: white; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);">
                </div>
                <div class="d-flex gap-2">
                    <select id="cnSort" class="input px-3" style="height:45px; padding-top: 0; padding-bottom: 0; line-height: 43px; color: white; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);">
                        <option value="newest" <%= filters.sort === 'newest' || !filters.sort ? 'selected' : '' %> style="color: black;">Newest First</option>
                        <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %> style="color: black;">Oldest First</option>
                    </select>
                    <button id="cnClear" class="action-btn" title="Clear" style="height:45px;width:45px;"><i class="fi fi-rr-refresh"></i></button>
                    <button id="cnApply" class="btn btn-primary fw-bold" style="height:45px;padding:0 20px;">Apply</button>
                </div>
            </div>

            <% if (cancellations.length === 0) { %>
                <div class="glass-premium text-center py-5 rounded-4 animate stagger-2">
                    <div style="width: 80px; height: 80px; background: rgba(46,204,113,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                        <i class="fi fi-rr-check-circle" style="font-size: 2rem; color: #2ecc71;"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-2">No Cancellations</h4>
                    <p class="text-dim mb-0">There are no cancelled tickets or cancellation requests for this event.</p>
                </div>
            <% } else { %>
                <div class="row row-cols-1 g-4 animate stagger-2" id="eventCancellationsList">
                    <% cancellations.forEach(booking => { %>
                        <div class="col" id="card-col-<%= booking._id %>">
                            <div class="glass-premium request-card p-4">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-4">
                                    
                                    <!-- User & Event Info -->
                                    <div class="d-flex gap-4 flex-grow-1">
                                        <% if (booking.user?.profilePic) { %>
                                            <img src="<%= booking.user.profilePic %>" alt="User" class="rounded-circle" style="width:60px; height:60px; object-fit:cover; border: 2px solid rgba(255,255,255,0.1);">
                                        <% } else { %>
                                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:60px; height:60px; background: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.05);">
                                                <i class="fi fi-rr-user text-dim fs-4"></i>
                                            </div>
                                        <% } %>
                                        
                                        <div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <h5 class="fw-bold m-0"><%= booking.user?.fullName || 'Deleted User' %></h5>
                                                <% if (booking.cancellationRequest.status === 'pending') { %>
                                                    <span class="status-badge status-pending">Pending Request</span>
                                                <% } else if (booking.cancellationRequest.status === 'approved') { %>
                                                    <span class="status-badge" style="background: rgba(46, 204, 113, 0.15); color: #2ecc71; border: 1px solid rgba(46, 204, 113, 0.3);">Approved</span>
                                                <% } else if (booking.cancellationRequest.status === 'rejected') { %>
                                                    <span class="status-badge" style="background: rgba(230, 57, 70, 0.15); color: #E63946; border: 1px solid rgba(230, 57, 70, 0.3);">Rejected</span>
                                                <% } else if (booking.status === 'cancelled') { %>
                                                    <span class="status-badge" style="background: rgba(230, 57, 70, 0.15); color: #E63946; border: 1px solid rgba(230, 57, 70, 0.3);">Cancelled</span>
                                                <% } %>
                                            </div>
                                            <p class="text-dim small mb-2"><i class="fi fi-rr-envelope me-1"></i><%= booking.user?.email || 'N/A' %> <span class="ms-2">|</span> Booking #<%= booking._id.toString().slice(-8).toUpperCase() %></p>
                                            
                                            <div class="d-flex align-items-center gap-2 text-dim small mb-3">
                                                <% if (booking.cancellationRequest.status !== 'none') { %>
                                                    <span><i class="fi fi-rr-clock-three me-1"></i>Requested: <%= new Date(booking.cancellationRequest.requestedAt).toLocaleDateString(undefined, {day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit'}) %></span>
                                                <% } else if (booking.status === 'cancelled') { %>
                                                    <span><i class="fi fi-rr-ban me-1"></i>Cancelled on: <%= new Date(booking.cancelledAt).toLocaleDateString(undefined, {day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit'}) %></span>
                                                <% } %>
                                            </div>

                                            <% 
                                                const individuallyCancelledTickets = booking.tickets.filter(t => t.status === 'cancelled' && !booking.cancellationRequest.requestedTickets?.some(rt => rt.ticketId.toString() === t._id.toString())); 
                                                if (individuallyCancelledTickets.length > 0) { 
                                            %>
                                                <div class="p-3 rounded-3 mb-2" style="background: rgba(0,0,0,0.3); border-left: 3px solid #E63946;">
                                                    <span class="d-block text-danger small fw-bold mb-1 text-uppercase">Individually Cancelled Tickets:</span>
                                                    <ul class="mb-0 text-white small" style="padding-left: 1.2rem;">
                                                        <% individuallyCancelledTickets.forEach(t => { %>
                                                            <li><strong><%= t.quantity %>x</strong> <%= t.ticketName %></li>
                                                        <% }) %>
                                                    </ul>
                                                </div>
                                            <% } %>

                                            <% if (booking.cancellationRequest.status !== 'none') { %>
                                                <div class="p-3 rounded-3 mb-2" style="background: rgba(0,0,0,0.3); border-left: 3px solid <%= booking.cancellationRequest.status === 'pending' ? '#f39c12' : (booking.cancellationRequest.status === 'approved' ? '#2ecc71' : '#E63946') %>;">
                                                    <span class="d-block text-dim small fw-bold mb-1 text-uppercase" style="letter-spacing: 0.5px;">Reason for Cancellation Request:</span>
                                                    <p class="m-0 text-white mb-2" style="font-style: italic;">"<%= booking.cancellationRequest.reason %>"</p>
                                                    
                                                    <% if (booking.cancellationRequest.isPartial) { %>
                                                        <div class="p-2 rounded-3" style="background: rgba(255, 255, 255, 0.05);">
                                                            <span class="d-block text-white small fw-bold mb-1 text-uppercase">Partial Cancellation Requested:</span>
                                                            <ul class="mb-0 text-white small" style="padding-left: 1.2rem;">
                                                                <% (booking.cancellationRequest.requestedTickets || []).forEach(rt => { 
                                                                    const tItem = booking.tickets.find(t => (t._id || t.ticket || t).toString() === rt.ticketId.toString());
                                                                    if (tItem) {
                                                                %>
                                                                    <li><strong><%= rt.quantity %>x</strong> <%= tItem.ticketName %> (₹<%= (tItem.ticketPrice || 0).toLocaleString('en-IN') %> each)</li>
                                                                <% } }) %>
                                                            </ul>
                                                        </div>
                                                    <% } else { %>
                                                        <div class="p-2 rounded-3" style="background: rgba(255, 255, 255, 0.05);">
                                                            <span class="d-block text-white small fw-bold mb-0 text-uppercase">Full Booking Cancellation Requested</span>
                                                        </div>
                                                    <% } %>

                                                    <% if (booking.cancellationRequest.status === 'rejected') { %>
                                                        <div class="mt-2 pt-2" style="border-top: 1px solid rgba(255,255,255,0.1);">
                                                            <span class="d-block text-danger small fw-bold mb-1">Rejection Note:</span>
                                                            <p class="m-0 text-white small">"<%= booking.cancellationRequest.rejectionNote || 'No rejection note provided' %>"</p>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% } else if (booking.status === 'cancelled' && individuallyCancelledTickets.length === 0) { %>
                                                <div class="p-3 rounded-3 mb-2" style="background: rgba(0,0,0,0.3); border-left: 3px solid #E63946;">
                                                    <p class="m-0 text-white">This booking was cancelled directly.</p>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <%
                                        let targetCancelPrice = 0;
                                        let cancelLabel = 'Refund Amount';
                                        let isPartialFlag = false;

                                        if (booking.cancellationRequest && booking.cancellationRequest.status !== 'none') {
                                            if (booking.cancellationRequest.isPartial && booking.cancellationRequest.requestedTickets?.length > 0) {
                                                isPartialFlag = true;
                                                cancelLabel = booking.cancellationRequest.status === 'pending' ? 'Requested Refund' : 'Refunded Ticket Value';
                                                booking.cancellationRequest.requestedTickets.forEach(rt => {
                                                    const tItem = booking.tickets.find(t => (t._id || t.ticket || t).toString() === rt.ticketId.toString());
                                                    if (tItem) targetCancelPrice += (tItem.ticketPrice || 0) * rt.quantity;
                                                });
                                            } else {
                                                cancelLabel = booking.cancellationRequest.status === 'pending' ? 'Full Booking Refund' : 'Total Refunded Value';
                                                if (booking.totalAmount > 0 && booking.cancellationRequest.status === 'pending') {
                                                    targetCancelPrice = booking.totalAmount;
                                                } else {
                                                    booking.tickets.forEach(t => targetCancelPrice += (t.ticketPrice || 0) * (t.quantity || 0));
                                                }
                                            }
                                        } else if (booking.tickets?.some(t => t.status === 'cancelled')) {
                                            isPartialFlag = true;
                                            cancelLabel = 'Cancelled Tickets Value';
                                            booking.tickets.forEach(t => {
                                                if (t.status === 'cancelled') targetCancelPrice += (t.ticketPrice || 0) * (t.quantity || 0);
                                            });
                                        } else {
                                            targetCancelPrice = booking.totalAmount || 0;
                                        }
                                    %>

                                    <!-- Actions & Details -->
                                    <div class="text-end" style="min-width: 220px;">
                                        <div class="p-3 rounded-4 mb-3" style="background: rgba(230, 57, 70, 0.08); border: 1px solid rgba(230, 57, 70, 0.25); text-align: right;">
                                            <span class="d-block text-danger small fw-bold text-uppercase mb-1" style="letter-spacing: 0.8px;"><%= cancelLabel %></span>
                                            <h3 class="fw-extrabold m-0 text-white" style="font-size: 1.6rem; letter-spacing: -0.5px;">₹<%= targetCancelPrice.toLocaleString('en-IN') %></h3>
                                            <% if (isPartialFlag) { %>
                                                <div class="mt-2 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center small text-dim" style="font-size: 0.78rem;">
                                                    <span>Active Balance:</span>
                                                    <strong class="text-white">₹<%= booking.totalAmount.toLocaleString('en-IN') %></strong>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="text-end mb-2">
                                            <span class="badge <%= booking.paymentMethod === 'wallet' ? 'bg-primary' : 'bg-info text-dark' %>">
                                                Paid Via <%= booking.paymentMethod.toUpperCase() %>
                                            </span>
                                        </div>
                                        
                                        <% if (booking.cancellationRequest.status === 'pending') { %>
                                            <div class="d-flex flex-column gap-2 mt-3">
                                                <button onclick="approveRequest('<%= booking._id %>')" class="btn btn-outline w-100 fw-bold d-flex align-items-center justify-content-center gap-2" style="color:#2ecc71; border-color:rgba(46,204,113,0.3);">
                                                    <i class="fi fi-rr-check-circle"></i> Approve & Refund
                                                </button>
                                                <button onclick="openRejectModal('<%= booking._id %>')" class="btn btn-outline w-100 fw-bold d-flex align-items-center justify-content-center gap-2" style="color:#E63946; border-color:rgba(230,57,70,0.3);">
                                                    <i class="fi fi-rr-cross-circle"></i> Reject Request
                                                </button>
                                            </div>
                                        <% } else if (booking.cancellationRequest.status === 'approved') { %>
                                            <div class="p-2 rounded-3 text-center mt-3" style="background: rgba(46, 204, 113, 0.1); color: #2ecc71; border: 1px solid rgba(46, 204, 113, 0.3); font-weight: 700; font-size: 0.88rem;">
                                                <i class="fi fi-rr-check-circle me-1"></i> Refund Completed
                                            </div>
                                        <% } else if (booking.cancellationRequest.status === 'rejected') { %>
                                            <div class="p-2 rounded-3 text-center mt-3" style="background: rgba(230, 57, 70, 0.1); color: #E63946; border: 1px solid rgba(230, 57, 70, 0.3); font-weight: 700; font-size: 0.88rem;">
                                                <i class="fi fi-rr-cross-circle me-1"></i> Request Rejected
                                            </div>
                                        <% } %>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <% if (totalPages > 1) { %>
                    <% 
                        const buildUrl = (p) => {
                            let qs = `?page=${p}`;
                            if(filters.search) qs += `&search=${encodeURIComponent(filters.search)}`;
                            if(filters.sort) qs += `&sort=${filters.sort}`;
                            if(filters.status) qs += `&status=${filters.status}`;
                            return qs;
                        };
                    %>
                    <div class="d-flex justify-content-between align-items-center mt-5 px-1 animate stagger-3">
                        <p class="text-dim mb-0 small">Page <%= currentPage %> of <%= totalPages %></p>
                        <nav>
                            <ul class="pagination d-flex gap-2 list-unstyled mb-0">
                                <% if(currentPage > 1) { %>
                                    <li><a class="action-btn text-decoration-none" href="<%= buildUrl(currentPage-1) %>"><i class="fi fi-rr-angle-left"></i></a></li>
                                <% } %>
                                <% for(let i=1; i<=totalPages; i++) { %>
                                    <li><a class="action-btn text-decoration-none <%= i===currentPage ? 'active-page' : '' %>" href="<%= buildUrl(i) %>"><%= i %></a></li>
                                <% } %>
                                <% if(currentPage < totalPages) { %>
                                    <li><a class="action-btn text-decoration-none" href="<%= buildUrl(currentPage+1) %>"><i class="fi fi-rr-angle-right"></i></a></li>
                                <% } %>
                            </ul>
                        </nav>
                    </div>
                <% } %>
            <% } %>

        </main>
    </div>

<%# ── Reject Reason Modal ── %>
<div class="modal-overlay" id="rejectModal" style="z-index: 999999;">
    <div class="modal-container" style="max-width: 450px;">
        <div class="modal-header">
            <h5 class="fw-bold m-0"><i class="fi fi-rr-cross-circle me-2 text-danger"></i>Reject Request</h5>
            <span class="modal-close" onclick="closeRejectModal()" style="cursor: pointer;"><i class="fi fi-rr-cross-small"></i></span>
        </div>
        <div class="modal-body p-4 text-start">
            <p class="text-dim mb-3" style="font-size: 0.9rem;">Provide a reason for rejecting this cancellation request. This will be shown to the user.</p>
            <textarea id="rejectNoteInput" rows="3" placeholder="e.g., Event is non-refundable 24hrs before start..." 
                      style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 8px; padding: 12px; outline: none;"
                      onfocus="this.style.borderColor='rgba(255,255,255,0.4)'"
                      onblur="this.style.borderColor='rgba(255,255,255,0.1)'"></textarea>
            <p id="rejectNoteError" class="text-danger mt-1 small" style="display: none;"><i class="fi fi-rr-info me-1"></i>Please provide a rejection note.</p>
            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn px-4 py-2" style="background: rgba(255,255,255,0.05); color: white; border: none;" onclick="closeRejectModal()">Cancel</button>
                <button class="btn btn-danger px-4 py-2 fw-bold" id="confirmRejectBtn">Reject Request</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
    async function approveRequest(bookingId) {
        const ok = await CustomConfirm.show({
            title: 'Approve Cancellation?',
            message: 'This will cancel the booking and release inventory. Wallet payments will be refunded immediately.',
            confirmText: 'Approve & Refund',
            actionType: 'primary',
            icon: 'fi-rr-check-circle'
        });
        if (!ok) return;

        Loader.show('APPROVING...');
        try {
            const res = await axios.post(`/organizer/bookings/${bookingId}/approve-cancel`);
            if (res.data.success) {
                Toast.success(res.data.message);
                const cardCol = document.getElementById(`card-col-${bookingId}`);
                if (cardCol) {
                    cardCol.style.transition = 'all 0.4s ease';
                    cardCol.style.opacity = '0';
                    cardCol.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        cardCol.remove();
                        checkEmptyEventCancellations();
                    }, 400);
                }
            }
        } catch (err) {
            Toast.error(err.response?.data?.message || 'Failed to approve request.');
        } finally {
            Loader.hide();
        }
    }

    function checkEmptyEventCancellations() {
        const container = document.getElementById('eventCancellationsList');
        if (container && container.children.length === 0) {
            container.innerHTML = `
                <div class="glass-premium text-center py-5 rounded-4 animate stagger-2 w-100">
                    <div style="width: 80px; height: 80px; background: rgba(46,204,113,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                        <i class="fi fi-rr-check-circle" style="font-size: 2rem; color: #2ecc71;"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-2">No Cancellations</h4>
                    <p class="text-dim mb-0">There are no cancelled tickets or cancellation requests for this event.</p>
                </div>`;
        }
    }

    let rejectBookingId = null;

    function openRejectModal(bookingId) {
        rejectBookingId = bookingId;
        document.getElementById('rejectNoteInput').value = '';
        document.getElementById('rejectNoteError').style.display = 'none';
        document.getElementById('rejectModal').classList.add('active');
        setTimeout(() => document.getElementById('rejectNoteInput').focus(), 150);
    }

    function closeRejectModal() {
        document.getElementById('rejectModal').classList.remove('active');
        rejectBookingId = null;
    }

    document.getElementById('confirmRejectBtn')?.addEventListener('click', async () => {
        const noteInput = document.getElementById('rejectNoteInput');
        const errorEl   = document.getElementById('rejectNoteError');
        const btn       = document.getElementById('confirmRejectBtn');
        const note      = noteInput.value.trim();

        if (!note) {
            errorEl.style.display = 'block';
            noteInput.focus();
            return;
        }
        errorEl.style.display = 'none';

        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fi fi-rr-spinner" style="animation:spin 1s linear infinite;"></i> Processing...';
        btn.disabled  = true;

        try {
            const res = await axios.post(`/organizer/bookings/${rejectBookingId}/reject-cancel`, { rejectionNote: note });
            if (res.data.success) {
                const targetId = rejectBookingId;
                closeRejectModal();
                Toast.success(res.data.message);
                const cardCol = document.getElementById(`card-col-${targetId}`);
                if (cardCol) {
                    cardCol.style.transition = 'all 0.4s ease';
                    cardCol.style.opacity = '0';
                    cardCol.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        cardCol.remove();
                        checkEmptyEventCancellations();
                    }, 400);
                }
            }
        } catch (err) {
            Toast.error(err.response?.data?.message || 'Failed to reject request.');
            btn.innerHTML = originalHtml;
            btn.disabled  = false;
        }
    });

    // ── Rebind UI & Search Event Listeners ──
    function rebindUIEventListeners() {
        const searchInput = document.getElementById('cnSearch');
        const sortSelect  = document.getElementById('cnSort');
        const applyBtn    = document.getElementById('cnApply');
        const clearBtn    = document.getElementById('cnClear');

        function applyFilters() {
            const urlParams = new URLSearchParams(window.location.search);
            if (searchInput?.value.trim()) urlParams.set('search', searchInput.value.trim());
            else urlParams.delete('search');
            if (sortSelect?.value) urlParams.set('sort', sortSelect.value);
            urlParams.set('page', '1');
            window.location.href = '?' + urlParams.toString();
        }

        applyBtn?.addEventListener('click', applyFilters);
        searchInput?.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') applyFilters();
        });
        clearBtn?.addEventListener('click', () => {
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.delete('search');
            urlParams.delete('sort');
            urlParams.delete('page');
            window.location.href = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
        });

        // Rebind reject modal confirm button
        const confirmBtn = document.getElementById('confirmRejectBtn');
        if (confirmBtn && !confirmBtn.dataset.bound) {
            confirmBtn.dataset.bound = 'true';
            confirmBtn.addEventListener('click', async () => {
                const noteInput = document.getElementById('rejectNoteInput');
                const errorEl   = document.getElementById('rejectNoteError');
                const note      = noteInput.value.trim();

                if (!note) {
                    errorEl.style.display = 'block';
                    noteInput.focus();
                    return;
                }
                errorEl.style.display = 'none';

                const originalHtml = confirmBtn.innerHTML;
                confirmBtn.innerHTML = '<i class="fi fi-rr-spinner" style="animation:spin 1s linear infinite;"></i> Processing...';
                confirmBtn.disabled  = true;

                try {
                    const res = await axios.post(`/organizer/bookings/${rejectBookingId}/reject-cancel`, { rejectionNote: note });
                    if (res.data.success) {
                        const targetId = rejectBookingId;
                        closeRejectModal();
                        Toast.success(res.data.message);
                        const cardCol = document.getElementById(`card-col-${targetId}`);
                        if (cardCol) {
                            cardCol.style.transition = 'all 0.4s ease';
                            cardCol.style.opacity = '0';
                            cardCol.style.transform = 'scale(0.95)';
                            setTimeout(() => {
                                cardCol.remove();
                                checkEmptyEventCancellations();
                            }, 400);
                        }
                    }
                } catch (err) {
                    Toast.error(err.response?.data?.message || 'Failed to reject request.');
                    confirmBtn.innerHTML = originalHtml;
                    confirmBtn.disabled  = false;
                }
            });
        }
    }

    rebindUIEventListeners();

    // ── Live Socket: New Cancellation Request (Seamless DOM update) ──
    async function handleSeamlessDOMRefresh(data) {
        if (typeof Toast !== 'undefined') {
            Toast.show('⚠️ Live Update: New pending cancellation request received!', 'warning');
        }
        try {
            const res = await fetch(location.href);
            const htmlText = await res.text();
            const parser = new DOMParser();
            const newDoc = parser.parseFromString(htmlText, 'text/html');
            const newMain = newDoc.querySelector('.dashboard-main');
            const currentMain = document.querySelector('.dashboard-main');
            if (newMain && currentMain) {
                currentMain.innerHTML = newMain.innerHTML;
                rebindUIEventListeners();

                // Highlight first pending card nicely if visible
                const firstPendingCard = currentMain.querySelector('.request-card');
                if (firstPendingCard) {
                    firstPendingCard.style.boxShadow = '0 0 25px rgba(243, 156, 18, 0.4)';
                    firstPendingCard.style.transition = 'box-shadow 1.5s ease';
                    setTimeout(() => { firstPendingCard.style.boxShadow = ''; }, 3000);
                }
            }
        } catch (err) {
            console.error('Live socket DOM update failed:', err);
        }
    }

    if (window.socket) {
        window.socket.on('newCancellationRequest', handleSeamlessDOMRefresh);
    }
    window.addEventListener('liveCancellationRequest', handleSeamlessDOMRefresh);
</script>
</body>
</html>
