<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/organizer-nav') %>
    <div class="dashboard-layout">
        <%- include('../../partials/organizer-sidebar', { title: 'Global Sales Report' }) %>
        <main class="dashboard-main">

            <%# ── Page Header ─────────────────────────────── %>
            <div class="d-flex align-items-center justify-content-between mb-5 animate stagger-1" style="position: relative; z-index: 100;">
                <div>
                    <p class="page-label">Global Analytics</p>
                    <h2 class="fw-bold m-0" style="letter-spacing:-0.5px;">Sales Performance Overview</h2>
                    <p class="text-dim m-0" style="font-size:0.82rem;">
                        <i class="fi fi-rr-chart-pie-alt me-1"></i>
                        Aggregated metrics across all <%= eventsCount %> events
                    </p>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <!-- Export Dropdown -->
                    <div class="export-dropdown-wrap" id="exportDropWrap">
                        <button class="export-trigger-btn" id="exportTrigger" onclick="toggleExportMenu()">
                            <i class="fi fi-rr-file-export me-2"></i>
                            Export
                            <i class="fi fi-rr-angle-small-down ms-2" id="exportChevron"></i>
                        </button>
                        <div class="export-menu" id="exportMenu">
                            <a class="export-menu-item" href="/organizer/sales-report/export/excel<%= (locals.startDate && locals.endDate) ? `?startDate=${startDate}&endDate=${endDate}` : '' %>"
                               onclick="startExport(this, 'Generating Excel...')">
                                <div class="export-menu-icon excel-icon">
                                    <i class="fi fi-rr-file-spreadsheet"></i>
                                </div>
                                <div>
                                    <p class="export-menu-label">Export Excel</p>
                                    <p class="export-menu-sub">Detailed workbook (.xlsx)</p>
                                </div>
                            </a>
                            <a class="export-menu-item" href="/organizer/sales-report/export/pdf<%= (locals.startDate && locals.endDate) ? `?startDate=${startDate}&endDate=${endDate}` : '' %>"
                               onclick="startExport(this, 'Generating PDF...')">
                                <div class="export-menu-icon pdf-icon">
                                    <i class="fi fi-rr-file-pdf"></i>
                                </div>
                                <div>
                                    <p class="export-menu-label">Export PDF</p>
                                    <p class="export-menu-sub">Print-ready A4 report (.pdf)</p>
                                </div>
                            </a>
                            <div class="export-menu-divider"></div>
                            <button class="export-menu-item" onclick="window.print(); toggleExportMenu();">
                                <div class="export-menu-icon print-icon">
                                    <i class="fi fi-rr-print"></i>
                                </div>
                                <div>
                                    <p class="export-menu-label">Print Page</p>
                                    <p class="export-menu-sub">Print this report</p>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <%# ── Date Filter ─────────────────────────────── %>
            <div class="glass-premium mb-4 animate stagger-2" style="border-radius:14px; padding: 1.2rem;">
                <form action="/organizer/sales-report" method="GET" class="d-flex flex-wrap align-items-end gap-3 m-0">
                    <div class="col-md-3">
                        <label class="form-label text-dim small mb-1">Start Date</label>
                        <input type="date" id="startDate" name="startDate" class="form-control bg-dark border-secondary text-white" value="<%= locals.startDate || '' %>" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-dim small mb-1">End Date</label>
                        <input type="date" id="endDate" name="endDate" class="form-control bg-dark border-secondary text-white" value="<%= locals.endDate || '' %>" required>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="fi fi-rr-filter me-2"></i>Filter</button>
                        <% if (locals.startDate || locals.endDate) { %>
                            <a href="/organizer/sales-report" class="btn btn-outline-light px-4">Clear</a>
                        <% } %>
                    </div>
                </form>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const startDateInput = document.getElementById('startDate');
                    const endDateInput = document.getElementById('endDate');
                    if (startDateInput && endDateInput) {
                        startDateInput.addEventListener('change', (e) => {
                            endDateInput.min = e.target.value;
                            if (endDateInput.value && endDateInput.value < e.target.value) {
                                endDateInput.value = e.target.value;
                            }
                        });
                        // Initialize min on load
                        if (startDateInput.value) {
                            endDateInput.min = startDateInput.value;
                        }
                    }
                });
            </script>

            <%# ── Summary KPI Cards ───────────────────────── %>
            <div class="row g-3 mb-4 animate stagger-3">
                <div class="col-6 col-lg-3">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:rgba(46,204,113,0.1);color:#2ecc71;">
                            <i class="fi fi-rr-coins"></i>
                        </div>
                        <p class="kpi-label">Gross Revenue</p>
                        <p class="kpi-value" style="color:#2ecc71;">&#8377;<%= totalRevenue.toLocaleString('en-IN',{minimumFractionDigits:2}) %></p>
                        <p class="kpi-sub">Net: &#8377;<%= parseFloat(netRevenue).toLocaleString('en-IN',{minimumFractionDigits:2}) %></p>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:rgba(230,57,70,0.1);color:#E63946;">
                            <i class="fi fi-rr-ticket"></i>
                        </div>
                        <p class="kpi-label">Tickets Sold</p>
                        <p class="kpi-value"><%= totalTicketsSold %> <span class="text-dim" style="font-size:1rem;">/ <%= totalCapacity %></span></p>
                        <div class="kpi-progress">
                            <div class="kpi-progress-fill" style="width:<%= fillRate %>%;background:#E63946;"></div>
                        </div>
                        <p class="kpi-sub"><%= fillRate %>% capacity filled</p>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:rgba(52,152,219,0.1);color:#3498db;">
                            <i class="fi fi-rr-users"></i>
                        </div>
                        <p class="kpi-label">Total Bookings</p>
                        <p class="kpi-value"><%= totalBookings %></p>
                        <p class="kpi-sub"><%= activeBookingCount %> active · <%= cancelledCount %> cancelled</p>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:rgba(155,89,182,0.1);color:#9b59b6;">
                            <i class="fi fi-rr-chart-histogram"></i>
                        </div>
                        <p class="kpi-label">Avg. Order Value</p>
                        <p class="kpi-value">&#8377;<%= parseFloat(avgOrderValue).toLocaleString('en-IN',{minimumFractionDigits:2}) %></p>
                        <p class="kpi-sub">Platform fee: &#8377;<%= parseFloat(platformFee).toLocaleString('en-IN',{minimumFractionDigits:2}) %></p>
                    </div>
                </div>
            </div>

            <%# ── Revenue Trend Chart ─────────────────────── %>
            <div class="glass-premium p-4 mb-4 animate stagger-3" style="border-radius:18px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <p class="page-label">Revenue Chart</p>
                        <h5 class="fw-bold m-0">Global Daily Revenue Trend</h5>
                        <p class="text-dim m-0" style="font-size:0.8rem;">Last 30 days of booking activity across all events</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="chart-toggle-btn active" id="btnRevenue" onclick="toggleChart('revenue')">Revenue</button>
                        <button class="chart-toggle-btn" id="btnBookings" onclick="toggleChart('bookings')">Bookings</button>
                    </div>
                </div>
                <div style="position:relative;height:260px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>

            <%# ── Two-column: event breakdown + payment split ── %>
            <div class="row g-4 mb-4 animate stagger-4">
                <%# Event Breakdown %>
                <div class="col-lg-7">
                    <div class="glass-premium p-4 h-100" style="border-radius:18px; max-height: 400px; overflow-y: auto;">
                        <p class="page-label">Event Analysis</p>
                        <h5 class="fw-bold mb-4">Top Performing Events</h5>

                        <% if(eventPerformance && eventPerformance.length > 0) { %>
                        <div class="d-flex flex-column gap-3">
                            <% const colors = ['#E63946','#2ecc71','#3498db','#f39c12','#9b59b6','#4ECDC4']; %>
                            <% eventPerformance.forEach((ep, idx) => { %>
                            <div class="tier-breakdown-row" onclick="window.location.href='/organizer/events/<%= ep.id %>/sales-report'" style="cursor:pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background='transparent'">
                                <div class="tier-breakdown-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:10px;height:10px;border-radius:50%;background:<%= colors[idx % colors.length] %>;flex-shrink:0;"></div>
                                        <strong style="color:white;font-size:0.9rem;"><%= ep.title %></strong>
                                        <span class="text-dim" style="font-size:0.8rem;"><%= ep.category %></span>
                                    </div>
                                    <span style="color:<%= colors[idx % colors.length] %>;font-weight:700;font-size:0.9rem;">
                                        &#8377;<%= ep.revenue.toLocaleString('en-IN') %>
                                    </span>
                                </div>
                                <div class="tier-breakdown-meta">
                                    <span><%= ep.sold %> sold</span>
                                    <span><%= ep.capacity > 0 ? (ep.capacity - ep.sold) : 0 %> remaining</span>
                                    <span><%= ep.capacity %> capacity</span>
                                </div>
                                <div class="tier-progress-wrap">
                                    <div class="tier-progress-bar" style="background:rgba(255,255,255,0.06);">
                                        <div style="width:<%= ep.fillPct %>%;height:100%;border-radius:100px;background:<%= colors[idx % colors.length] %>;transition:width 0.8s ease;"></div>
                                    </div>
                                    <span class="text-dim" style="font-size:0.75rem;flex-shrink:0;"><%= ep.fillPct %>%</span>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                        <% } else { %>
                        <div class="text-center py-4 text-dim">
                            <i class="fi fi-rr-calendar-lines" style="font-size:2rem;opacity:0.3;display:block;margin-bottom:0.75rem;"></i>
                            No event data available.
                        </div>
                        <% } %>
                    </div>
                </div>

                <%# Payment & Status Charts %>
                <div class="col-lg-5 d-flex flex-column gap-4">
                    <div class="glass-premium p-4" style="border-radius:18px;flex:1;">
                        <p class="page-label">Payment</p>
                        <h5 class="fw-bold mb-3">Global Payment Methods</h5>
                        <div style="position:relative;height:160px;display:flex;align-items:center;justify-content:center;">
                            <canvas id="paymentChart"></canvas>
                        </div>
                        <div class="d-flex justify-content-center gap-4 mt-3">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:10px;height:10px;border-radius:50%;background:#3498db;"></div>
                                <span class="text-dim" style="font-size:0.8rem;">Razorpay &#8377;<%= (paymentMethodMap.razorpay||0).toLocaleString('en-IN') %></span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:10px;height:10px;border-radius:50%;background:#2ecc71;"></div>
                                <span class="text-dim" style="font-size:0.8rem;">Wallet &#8377;<%= (paymentMethodMap.wallet||0).toLocaleString('en-IN') %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%# ── Transactions Table with Pagination & Filters ── %>
            <div class="glass-premium animate stagger-5" style="border-radius:18px;overflow:hidden;margin-bottom:2rem;">
                <div class="d-flex justify-content-between align-items-center p-4 flex-wrap gap-3" style="border-bottom:1px solid rgba(255,255,255,0.06);">
                    <div>
                        <p class="page-label">Transactions</p>
                        <h5 class="fw-bold m-0">Global Bookings</h5>
                    </div>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="position-relative">
                            <i class="fi fi-rr-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:rgba(255,255,255,0.4);font-size:0.9rem;"></i>
                            <input type="text" id="txnSearch" class="form-control" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);color:white;padding:6px 12px 6px 36px;border-radius:100px;font-size:0.85rem;min-width:220px;" placeholder="Search attendee, email..." oninput="onTxnFilterChange()">
                        </div>
                        <select id="txnStatusFilter" class="form-select" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);color:white;padding:6px 30px 6px 12px;border-radius:100px;font-size:0.85rem;width:auto;" onchange="onTxnFilterChange()">
                            <option value="all">All Status</option>
                            <option value="active">Active</option>
                            <option value="on_hold">On Hold</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                        <select id="txnLimit" class="form-select" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);color:white;padding:6px 30px 6px 12px;border-radius:100px;font-size:0.85rem;width:auto;" onchange="onTxnFilterChange()">
                            <option value="10">10 / page</option>
                            <option value="25">25 / page</option>
                            <option value="50">50 / page</option>
                        </select>
                    </div>
                </div>
                <div style="overflow-x:auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Attendee</th>
                                <th>Tickets</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="globalTxnBody">
                            <!-- Injected via JS -->
                        </tbody>
                    </table>
                </div>
                <!-- Pagination Footer -->
                <div id="globalTxnPagination" class="d-flex justify-content-between align-items-center px-4 py-3" style="border-top:1px solid rgba(255,255,255,0.06);flex-wrap:wrap;gap:12px;">
                </div>
            </div>le>
                </div>
                <!-- Pagination -->
                <div id="globalTxnPagination" class="d-flex justify-content-between align-items-center px-4 py-3" style="border-top:1px solid rgba(255,255,255,0.06);flex-wrap:wrap;gap:12px;"></div>
            </div>

        </main>
    </div>

    <script>
    // ── Client-Side Transactions Pagination & Filtering ─────────────────────────
    const allTransactions = JSON.parse('<%- JSON.stringify(allTransactions || []).replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/"/g, '\\"') %>');
    let txnCurrentPage = 1;
    let filteredTxns = [...allTransactions];

    function onTxnFilterChange() {
        const search = document.getElementById('txnSearch').value.toLowerCase();
        const status = document.getElementById('txnStatusFilter').value;
        
        filteredTxns = allTransactions.filter(txn => {
            const matchesSearch = !search || 
                (txn.userName && txn.userName.toLowerCase().includes(search)) || 
                (txn.userEmail && txn.userEmail.toLowerCase().includes(search)) ||
                (txn.eventName && txn.eventName.toLowerCase().includes(search));
            const matchesStatus = status === 'all' || txn.status === status;
            return matchesSearch && matchesStatus;
        });
        
        txnCurrentPage = 1;
        renderTxnPage();
    }

    function renderTxnPage() {
        const tbody = document.getElementById('globalTxnBody');
        const pagination = document.getElementById('globalTxnPagination');
        const limit = parseInt(document.getElementById('txnLimit').value);
        
        if (filteredTxns.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-5 text-dim">
                        <i class="fi fi-rr-receipt" style="font-size:2rem;opacity:0.3;display:block;margin-bottom:1rem;"></i>
                        No transactions found.
                    </td>
                </tr>
            `;
            pagination.innerHTML = '';
            return;
        }

        const totalPages = Math.ceil(filteredTxns.length / limit);
        if (txnCurrentPage > totalPages) txnCurrentPage = totalPages;
        
        const start = (txnCurrentPage - 1) * limit;
        const pageData = filteredTxns.slice(start, start + limit);
        
        tbody.innerHTML = pageData.map(txn => {
            let statusHtml = '';
            if(txn.status === 'active') statusHtml = `<span class="status-badge status-approved">Active</span>`;
            else if(txn.status === 'on_hold') statusHtml = `<span class="status-badge status-pending">On Hold</span>`;
            else statusHtml = `<span class="status-badge status-rejected">Cancelled</span>`;
            
            return `
                <tr>
                    <td><strong style="color:white;font-size:0.875rem;">${txn.eventName}</strong></td>
                    <td>
                        <div>
                            <strong style="color:white;font-size:0.875rem;">${txn.userName}</strong>
                            <p class="text-dim m-0" style="font-size:0.75rem;">${txn.userEmail}</p>
                        </div>
                    </td>
                    <td>
                        <span style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.75);padding:3px 10px;border-radius:100px;font-size:0.78rem;font-weight:600;">
                            ${txn.ticketCount} ticket${txn.ticketCount !== 1 ? 's' : ''}
                        </span>
                    </td>
                    <td><strong style="color:#2ecc71;font-size:0.9rem;">₹${Number(txn.amount).toLocaleString('en-IN')}</strong></td>
                    <td class="text-dim" style="font-size:0.82rem;">${new Date(txn.bookingDate).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'})}</td>
                    <td>${statusHtml}</td>
                </tr>
            `;
        }).join('');

        // Pagination controls
        const startRow = start + 1;
        const endRow = Math.min(start + limit, filteredTxns.length);
        
        pagination.innerHTML = `
            <span style="color:rgba(255,255,255,0.45);font-size:0.83rem;">Showing ${startRow}–${endRow} of ${filteredTxns.length} entries</span>
            <div class="d-flex align-items-center gap-2">
                <button onclick="changeTxnPage(${txnCurrentPage - 1})" ${txnCurrentPage === 1 ? 'disabled' : ''}
                    style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:${txnCurrentPage===1?'rgba(255,255,255,0.2)':'rgba(255,255,255,0.7)'};border-radius:8px;padding:5px 12px;cursor:${txnCurrentPage===1?'default':'pointer'};font-size:0.82rem;">← Prev</button>
                <span class="text-dim mx-1" style="font-size:0.85rem;">Page ${txnCurrentPage} of ${totalPages}</span>
                <button onclick="changeTxnPage(${txnCurrentPage + 1})" ${txnCurrentPage === totalPages ? 'disabled' : ''}
                    style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:${txnCurrentPage===totalPages?'rgba(255,255,255,0.2)':'rgba(255,255,255,0.7)'};border-radius:8px;padding:5px 12px;cursor:${txnCurrentPage===totalPages?'default':'pointer'};font-size:0.82rem;">Next →</button>
            </div>
        `;
    }

    function changeTxnPage(page) {
        txnCurrentPage = page;
        renderTxnPage();
    }

    // Init table
    renderTxnPage();

    // ── Export Dropdown ──────────────────────────────────────────────────────────
    function toggleExportMenu() {
        const menu    = document.getElementById('exportMenu');
        const chevron = document.getElementById('exportChevron');
        const trigger = document.getElementById('exportTrigger');
        const isOpen  = menu.classList.contains('open');

        menu.classList.toggle('open', !isOpen);
        trigger.classList.toggle('active', !isOpen);
        chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
    }

    function startExport(linkEl, message) {
        // Close menu
        document.getElementById('exportMenu').classList.remove('open');
        document.getElementById('exportTrigger').classList.remove('active');
        document.getElementById('exportChevron').style.transform = 'rotate(0deg)';
        // Show loader (assuming Loader is available globally from layout)
        if (typeof Loader !== 'undefined') {
            Loader.show(message);
            setTimeout(() => Loader.hide(), 4000);
        }
    }

    // Close dropdown on outside click
    document.addEventListener('click', (e) => {
        const wrap = document.getElementById('exportDropWrap');
        if (wrap && !wrap.contains(e.target)) {
            document.getElementById('exportMenu')?.classList.remove('open');
            document.getElementById('exportTrigger')?.classList.remove('active');
            if (document.getElementById('exportChevron'))
                document.getElementById('exportChevron').style.transform = 'rotate(0deg)';
        }
    });

    // ── Chart.js Setup ──────────────────────────────────────────────────────────
    const CHART_DATA = <%- JSON.stringify(dailyRevenueTrend) %>;
    const PAYMENT_MAP = <%- JSON.stringify(paymentMethodMap) %>;

    const chartLabels  = CHART_DATA.map(d => d.label);
    const revenueData  = CHART_DATA.map(d => d.revenue);
    const bookingsData = CHART_DATA.map(d => d.bookings);

    Chart.defaults.color = 'rgba(255,255,255,0.4)';
    Chart.defaults.font.family = "'DM Sans', sans-serif";

    // Revenue / Bookings line chart
    const ctx = document.getElementById('revenueChart').getContext('2d');

    const gradient = ctx.createLinearGradient(0, 0, 0, 260);
    gradient.addColorStop(0, 'rgba(230,57,70,0.25)');
    gradient.addColorStop(1, 'rgba(230,57,70,0)');

    const bookingGradient = ctx.createLinearGradient(0, 0, 0, 260);
    bookingGradient.addColorStop(0, 'rgba(52,152,219,0.25)');
    bookingGradient.addColorStop(1, 'rgba(52,152,219,0)');

    let activeDataset = 'revenue';

    const revenueChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: chartLabels,
            datasets: [{
                label: 'Revenue (₹)',
                data: revenueData,
                borderColor: '#E63946',
                backgroundColor: gradient,
                borderWidth: 2,
                pointRadius: 3,
                pointHoverRadius: 6,
                pointBackgroundColor: '#E63946',
                tension: 0.4,
                fill: true,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: 'rgba(10,10,10,0.95)',
                    borderColor: 'rgba(255,255,255,0.1)',
                    borderWidth: 1,
                    padding: 12,
                    titleFont: { family: "'Syne', sans-serif", weight: 700, size: 13 },
                    bodyFont: { family: "'DM Sans', sans-serif", size: 12 },
                    callbacks: {
                        label: ctx => activeDataset === 'revenue'
                            ? `  ₹${ctx.parsed.y.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`
                            : `  ${ctx.parsed.y} bookings`
                    }
                }
            },
            scales: {
                x: {
                    grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                    ticks: { maxTicksLimit: 10, font: { size: 11 } }
                },
                y: {
                    grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                    ticks: {
                        font: { size: 11 },
                        callback: v => activeDataset === 'revenue' ? '₹' + v.toLocaleString('en-IN') : v
                    },
                    beginAtZero: true,
                }
            }
        }
    });

    function toggleChart(type) {
        activeDataset = type;
        document.getElementById('btnRevenue').classList.toggle('active', type === 'revenue');
        document.getElementById('btnBookings').classList.toggle('active', type === 'bookings');

        const isRevenue = type === 'revenue';
        revenueChart.data.datasets[0].data            = isRevenue ? revenueData : bookingsData;
        revenueChart.data.datasets[0].label           = isRevenue ? 'Revenue (₹)' : 'Bookings';
        revenueChart.data.datasets[0].borderColor     = isRevenue ? '#E63946' : '#3498db';

        const newGrad = ctx.createLinearGradient(0, 0, 0, 260);
        if (isRevenue) {
            newGrad.addColorStop(0, 'rgba(230,57,70,0.25)');
            newGrad.addColorStop(1, 'rgba(230,57,70,0)');
        } else {
            newGrad.addColorStop(0, 'rgba(52,152,219,0.25)');
            newGrad.addColorStop(1, 'rgba(52,152,219,0)');
        }
        revenueChart.data.datasets[0].backgroundColor = newGrad;
        revenueChart.data.datasets[0].pointBackgroundColor = isRevenue ? '#E63946' : '#3498db';
        revenueChart.update();
    }

    // Payment method doughnut chart
    const payCtx = document.getElementById('paymentChart').getContext('2d');
    const rzpAmt    = PAYMENT_MAP.razorpay || 0;
    const walletAmt = PAYMENT_MAP.wallet   || 0;
    const hasData   = rzpAmt > 0 || walletAmt > 0;

    new Chart(payCtx, {
        type: 'doughnut',
        data: {
            labels: ['Razorpay', 'Wallet'],
            datasets: [{
                data: hasData ? [rzpAmt, walletAmt] : [1, 1],
                backgroundColor: hasData
                    ? ['rgba(52,152,219,0.8)', 'rgba(46,204,113,0.8)']
                    : ['rgba(255,255,255,0.06)', 'rgba(255,255,255,0.06)'],
                borderColor: 'transparent',
                borderWidth: 0,
                hoverOffset: 6,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    enabled: hasData,
                    backgroundColor: 'rgba(10,10,10,0.95)',
                    borderColor: 'rgba(255,255,255,0.1)',
                    borderWidth: 1,
                    padding: 10,
                    callbacks: {
                        label: ctx => `  ₹${ctx.parsed.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`
                    }
                }
            }
        }
    });
    
    // Listen for live dashboard updates (e.g. new bookings across any event)
    if (window.socket) {
        window.socket.on('dashboardUpdate', (data) => {
            if (typeof Toast !== 'undefined') Toast.success('New Booking Received!');
            setTimeout(() => window.location.reload(), 1500);
        });
    }
    </script>
</body>
</html>
