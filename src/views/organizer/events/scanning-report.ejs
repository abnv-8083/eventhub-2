<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <style>
        .pin-card {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(16, 185, 129, 0.08));
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 24px;
            padding: 32px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 40px -15px rgba(99, 102, 241, 0.25);
        }

        .pin-code-display {
            font-family: 'Outfit', monospace;
            font-size: 3.5rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: 0.3em;
            text-shadow: 0 0 25px rgba(99, 102, 241, 0.6);
            line-height: 1;
            margin: 16px 0;
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 24px;
            transition: transform 0.2s, border-color 0.2s;
        }

        .stat-box:hover {
            transform: translateY(-3px);
            border-color: rgba(255, 255, 255, 0.18);
        }

        .stat-number {
            font-family: 'Outfit', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 8px;
        }

        .stat-title {
            color: #9CA3AF;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 600;
        }

        .progress-bar-wrap {
            height: 14px;
            border-radius: 8px;
            background: rgba(255,255,255,0.08);
            overflow: hidden;
            margin: 20px 0 10px;
        }

        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #6366F1, #10B981);
            border-radius: 8px;
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .feed-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 10px;
        }

        .feed-table th {
            color: #9CA3AF;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0 16px 10px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .feed-table td {
            background: rgba(255,255,255,0.03);
            padding: 16px;
            vertical-align: middle;
            border-top: 1px solid rgba(255,255,255,0.06);
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .feed-table tr td:first-child {
            border-left: 1px solid rgba(255,255,255,0.06);
            border-top-left-radius: 14px;
            border-bottom-left-radius: 14px;
        }

        .feed-table tr td:last-child {
            border-right: 1px solid rgba(255,255,255,0.06);
            border-top-right-radius: 14px;
            border-bottom-right-radius: 14px;
        }

        .new-row-animation {
            animation: highlightFade 3s ease-out forwards;
        }

        @keyframes highlightFade {
            0% { background: rgba(16, 185, 129, 0.3); }
            100% { background: rgba(255,255,255,0.03); }
        }

        .live-pulse {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #10B981;
            box-shadow: 0 0 12px #10B981;
            animation: pulse 2s infinite;
            margin-right: 8px;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }
    </style>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/organizer-nav') %>
    
    <div class="dashboard-layout">
        <%- include('../../partials/organizer-sidebar', { title: 'My Events' }) %>
        
        <main class="dashboard-main">
            <!-- Page Header -->
            <div class="d-flex align-items-center justify-content-between mb-5 animate stagger-1">
                <div class="d-flex align-items-center gap-3">
                    <a href="/organizer/events/<%= event._id %>" class="btn btn-outline btn-sm" style="border-radius:10px;">
                        <i class="fi fi-rr-arrow-left me-1"></i>Back
                    </a>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="live-pulse"></span>
                            <p class="page-label mb-0 text-success fw-bold">Live Scanning Center</p>
                        </div>
                        <h2 class="fw-bold m-0 mt-1" style="letter-spacing:-0.5px;"><%= event.title %></h2>
                        <p class="text-dim m-0" style="font-size:0.82rem;">
                            <i class="fi fi-rr-marker me-1"></i> <%= event.location?.venueName || 'Online' %>
                            &nbsp;·&nbsp; <%= new Date(event.startDate).toLocaleDateString(undefined, {day:'numeric', month:'short', year:'numeric'}) %>
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-2 align-items-center">
                    <a href="/scanner" target="_blank" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold d-flex align-items-center gap-2">
                        <i class="fi fi-rr-external-link"></i> Open Scanner Portal
                    </a>
                </div>
            </div>

            <!-- PIN Management Card -->
            <div class="pin-card mb-5 animate stagger-2">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50 px-3 py-2 rounded-pill fw-bold mb-2">
                            <i class="fi fi-rr-key me-1"></i> Gate Staff Access PIN
                        </span>
                        <h3 class="text-white fw-bold mt-2">Unique Event Scanning Code</h3>
                        <p class="text-secondary mb-0">
                            Share this 6-digit PIN with your gate security or volunteer staff. They can log into the 
                            <a href="/scanner" target="_blank" class="text-primary text-decoration-underline">Gate Scanner Portal</a> 
                            using this code without needing access to your organizer account.
                        </p>
                        <div class="pin-code-display" id="pinCodeText"><%= event.scanningCode %></div>
                    </div>
                    <div class="col-lg-5 text-lg-end mt-4 mt-lg-0">
                        <div class="d-flex flex-column flex-sm-row justify-content-lg-end gap-2">
                            <button class="btn btn-outline-light px-4 py-3 rounded-3 fw-semibold" onclick="copyPinCode()">
                                <i class="fi fi-rr-copy me-2"></i> Copy PIN Code
                            </button>
                            <button class="btn btn-outline-primary px-4 py-3 rounded-3 fw-semibold" onclick="copyScannerUrl()">
                                <i class="fi fi-rr-link me-2"></i> Copy Portal Link
                            </button>
                        </div>
                        <form action="/organizer/events/<%= event._id %>/regenerate-scanning-code" method="POST" class="mt-3" onsubmit="return confirm('⚠️ Are you sure you want to regenerate the PIN code? Any gate staff currently logged in with the old code will need to re-login.');">
                            <button type="submit" class="btn btn-link text-danger text-decoration-none btn-sm p-0">
                                <i class="fi fi-rr-refresh me-1"></i> Regenerate New PIN Code
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Analytics Overview Grid -->
            <div class="row g-4 mb-5 animate stagger-3">
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-box">
                        <div class="stat-number text-white" id="statTotalSold"><%= totalSold %></div>
                        <div class="stat-title">Total Tickets Sold</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-box" style="border-color: rgba(16, 185, 129, 0.4); background: rgba(16, 185, 129, 0.05);">
                        <div class="stat-number text-success" id="statTotalCheckedIn"><%= totalCheckedIn %></div>
                        <div class="stat-title text-success">Total Checked In</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-box">
                        <div class="stat-number text-info" id="statRemaining"><%= Math.max(0, totalSold - totalCheckedIn) %></div>
                        <div class="stat-title">Remaining Attendees</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-box">
                        <div class="stat-number text-secondary" id="statCancelled"><%= totalCancelled %></div>
                        <div class="stat-title">Cancelled Tickets</div>
                    </div>
                </div>
            </div>

            <!-- Attendance Progress Bar -->
            <% const pct = totalSold > 0 ? Math.round((totalCheckedIn / totalSold) * 100) : 0; %>
            <div class="stat-box mb-5 animate stagger-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="text-white fw-bold mb-1">Gate Check-in Progress</h5>
                        <p class="text-secondary small mb-0">Real-time attendance rate across all ticket tiers</p>
                    </div>
                    <div class="text-end">
                        <span class="fs-4 fw-bold text-success" id="statPctText"><%= pct %>%</span>
                    </div>
                </div>
                <div class="progress-bar-wrap">
                    <div class="progress-bar-fill" id="statProgressBar" style="width: <%= pct %>%;"></div>
                </div>
            </div>

            <!-- Live Check-in Feed -->
            <div class="animate stagger-5">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h4 class="text-white fw-bold mb-1">Live Check-in Feed</h4>
                        <p class="text-secondary small mb-0">Updates instantly as gate staff scan tickets</p>
                    </div>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-3 py-2 rounded-pill">
                        <span class="live-pulse"></span> Listening for Scans
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="feed-table">
                        <thead>
                            <tr>
                                <th>Attendee</th>
                                <th>Booking Ref</th>
                                <th>Ticket Tier</th>
                                <th>Qty Scanned</th>
                                <th>Scanned At</th>
                                <th>Gate / PIN</th>
                            </tr>
                        </thead>
                        <tbody id="liveCheckInTableBody">
                            <% if (checkInFeed && checkInFeed.length > 0) { %>
                                <% checkInFeed.forEach(item => { %>
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-white"><%= item.attendeeName %></div>
                                            <small class="text-secondary"><%= item.attendeeEmail %></small>
                                        </td>
                                        <td><span class="badge bg-dark border border-secondary border-opacity-25 text-white font-outfit">#<%= item.bookingRef %></span></td>
                                        <td><span class="text-white fw-semibold"><%= item.ticketName %></span></td>
                                        <td><span class="badge bg-success font-outfit fs-6">+<%= item.quantity %></span></td>
                                        <td><span class="text-secondary small"><%= new Date(item.checkedInAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit'}) %></span></td>
                                        <td><span class="text-secondary small font-outfit">#<%= item.scannedByCode %></span></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr id="noScansRow">
                                    <td colspan="6" class="text-center py-5 text-secondary">
                                        <i class="fi fi-rr-camera d-block fs-2 mb-2 opacity-50"></i>
                                        No tickets checked in yet. When gate staff scan tickets, they will appear here live!
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <!-- Toast Notification for Copy -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="copyToast" class="toast align-items-center text-white bg-dark border border-secondary border-opacity-50 rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="fi fi-rr-check-circle text-success fs-5"></i>
                    <span id="toastMessage">Copied to clipboard!</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Socket.io for Real-time Feed -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const EVENT_ID = "<%= event._id %>";
        const toastEl = document.getElementById('copyToast');
        const toast = new bootstrap.Toast(toastEl);

        function showToast(msg) {
            document.getElementById('toastMessage').innerText = msg;
            toast.show();
        }

        function copyPinCode() {
            const code = document.getElementById('pinCodeText').innerText.trim();
            navigator.clipboard.writeText(code).then(() => {
                showToast(`PIN Code #${code} copied to clipboard!`);
            }).catch(() => showToast('Failed to copy PIN.'));
        }

        function copyScannerUrl() {
            const url = `${window.location.origin}/scanner`;
            navigator.clipboard.writeText(url).then(() => {
                showToast(`Scanner Portal link (${url}) copied!`);
            }).catch(() => showToast('Failed to copy link.'));
        }

        // ─── Socket.io Real-time Listener ──────────────────────────────────
        const socket = io();
        socket.emit('joinEvent', EVENT_ID);
        socket.emit('joinEvent', `scan_${EVENT_ID}`);

        socket.on('ticket_checked_in', (data) => {
            console.log("⚡ Live check-in received via Socket.io:", data);

            // 1. Update metric counters
            const elCheckedIn = document.getElementById('statTotalCheckedIn');
            const elRemaining = document.getElementById('statRemaining');
            const elSold = document.getElementById('statTotalSold');
            const elProgressBar = document.getElementById('statProgressBar');
            const elPctText = document.getElementById('statPctText');

            if (elCheckedIn && elSold) {
                let currentChecked = parseInt(elCheckedIn.innerText, 10) || 0;
                let totalSold = parseInt(elSold.innerText, 10) || 0;
                
                currentChecked += (data.totalCheckedInThisScan || 0);
                elCheckedIn.innerText = currentChecked;
                elRemaining.innerText = Math.max(0, totalSold - currentChecked);

                const pct = totalSold > 0 ? Math.round((currentChecked / totalSold) * 100) : 0;
                elProgressBar.style.width = `${pct}%`;
                elPctText.innerText = `${pct}%`;
            }

            // 2. Remove "No scans yet" row if present
            const noScansRow = document.getElementById('noScansRow');
            if (noScansRow) {
                noScansRow.remove();
            }

            // 3. Prepend new rows to table
            const tbody = document.getElementById('liveCheckInTableBody');
            if (tbody && data.newLogs && data.newLogs.length > 0) {
                data.newLogs.forEach(log => {
                    const tr = document.createElement('tr');
                    tr.className = 'new-row-animation';
                    tr.innerHTML = `
                        <td>
                            <div class="fw-bold text-white">${data.attendeeName}</div>
                            <small class="text-secondary">${data.attendeeEmail}</small>
                        </td>
                        <td><span class="badge bg-dark border border-secondary border-opacity-25 text-white font-outfit">#${data.bookingRef}</span></td>
                        <td><span class="text-white fw-semibold">${log.ticketName || 'General Ticket'}</span></td>
                        <td><span class="badge bg-success font-outfit fs-6">+${log.quantity}</span></td>
                        <td><span class="text-secondary small">${new Date(log.checkedInAt || Date.now()).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit'})}</span></td>
                        <td><span class="text-secondary small font-outfit">#${log.scannedByCode || data.scannedByCode || 'GATE'}</span></td>
                    `;
                    tbody.insertBefore(tr, tbody.firstChild);
                });
            }
        });
    </script>
</body>
</html>
