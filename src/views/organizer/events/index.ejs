<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/organizer-nav') %>
    <div class="dashboard-layout">
        <%- include('../../partials/organizer-sidebar', { title: 'My Events' }) %>
        <main class="dashboard-main">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 animate stagger-1">
                <div>
                    <h2 class="fw-bold m-0">My Events</h2>
                    <p class="text-dim m-0 small">Manage your events, track statuses, and update details.</p>
                </div>
                <a href="/organizer/events/new" class="btn btn-primary" style="border-radius:12px;gap:6px;">
                    <i class="fi fi-rr-plus me-1"></i> Create Event
                </a>
            </div>

            <!-- Summary Stats -->
            <% const total_all = events.length;
               const approved_c = events.filter(e => e.status==='approved' && !e.isBlocked).length;
               const pending_c  = events.filter(e => e.status==='pending').length;
               const rejected_c = events.filter(e => e.status==='rejected').length;
               const draft_c    = events.filter(e => e.status==='draft').length;
            %>
            <div class="row g-3 mb-4 animate stagger-2">
                <div class="col-6 col-md-2">
                    <div class="summary-stat">
                        <div class="summary-stat-icon" style="background:rgba(255,255,255,0.05);"><i class="fi fi-rr-calendar" style="color:rgba(255,255,255,0.6);"></i></div>
                        <div><p class="text-dim m-0" style="font-size:0.72rem;text-transform:uppercase;font-weight:700;">Total</p><h4 class="fw-bold m-0"><%= total %></h4></div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="summary-stat">
                        <div class="summary-stat-icon" style="background:rgba(46,204,113,0.1);"><i class="fi fi-rr-check" style="color:#2ecc71;"></i></div>
                        <div><p class="text-dim m-0" style="font-size:0.72rem;text-transform:uppercase;font-weight:700;">Live</p><h4 class="fw-bold m-0" style="color:#2ecc71;"><%= approved_c %></h4></div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="summary-stat">
                        <div class="summary-stat-icon" style="background:rgba(243,156,18,0.1);"><i class="fi fi-rr-clock" style="color:#f39c12;"></i></div>
                        <div><p class="text-dim m-0" style="font-size:0.72rem;text-transform:uppercase;font-weight:700;">Pending</p><h4 class="fw-bold m-0" style="color:#f39c12;"><%= pending_c %></h4></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="summary-stat">
                        <div class="summary-stat-icon" style="background:rgba(155,89,182,0.1);"><i class="fi fi-rr-disk" style="color:#9b59b6;"></i></div>
                        <div><p class="text-dim m-0" style="font-size:0.72rem;text-transform:uppercase;font-weight:700;">Drafts</p><h4 class="fw-bold m-0" style="color:#9b59b6;"><%= draft_c %></h4></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="summary-stat">
                        <div class="summary-stat-icon" style="background:rgba(230,57,70,0.1);"><i class="fi fi-rr-cross" style="color:#E63946;"></i></div>
                        <div><p class="text-dim m-0" style="font-size:0.72rem;text-transform:uppercase;font-weight:700;">Rejected</p><h4 class="fw-bold m-0" style="color:#E63946;"><%= rejected_c %></h4></div>
                    </div>
                </div>
            </div>

            <!-- Filter Bar -->
            <div class="d-flex align-items-center gap-3 mb-4 flex-wrap animate stagger-3">
                <div class="flex-grow-1" style="position:relative; min-width: 250px;">
                    <i class="fi fi-rr-search text-dim" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);pointer-events:none;"></i>
                    <input type="text" id="evtSearch" class="input ps-5 w-100" placeholder="Search events..." value="<%= locals.filters?.search || '' %>" style="height:42px; padding-top:0; padding-bottom:0; border-radius:12px;">
                </div>
                
                <div class="d-flex align-items-center gap-2 flex-wrap flex-grow-1 flex-md-grow-0">
                    <select id="evtStatus" class="input px-3 flex-grow-1" style="height:42px; padding-top:0; padding-bottom:0; border-radius:12px; min-width:140px; width:auto;">
                        <option value="all" <%= filters?.status==='all'||!filters?.status?'selected':'' %>>All Status</option>
                        <option value="draft"    <%= filters?.status==='draft'   ?'selected':'' %>>Drafts</option>
                        <option value="pending"  <%= filters?.status==='pending' ?'selected':'' %>>Pending</option>
                        <option value="approved" <%= filters?.status==='approved'?'selected':'' %>>Approved</option>
                        <option value="rejected" <%= filters?.status==='rejected'?'selected':'' %>>Rejected</option>
                        <option value="inactive" <%= filters?.status==='inactive'?'selected':'' %>>Inactive</option>
                        <option value="blocked"  <%= filters?.status==='blocked' ?'selected':'' %>>Blocked</option>
                    </select>
                    
                    <select id="evtSort" class="input px-3 flex-grow-1" style="height:42px; padding-top:0; padding-bottom:0; border-radius:12px; min-width:150px; width:auto;">
                        <option value="newest"    <%= filters?.sort==='newest'||!filters?.sort?'selected':'' %>>Newest First</option>
                        <option value="oldest"    <%= filters?.sort==='oldest'   ?'selected':'' %>>Oldest First</option>
                        <option value="title-asc" <%= filters?.sort==='title-asc'?'selected':'' %>>Title (A–Z)</option>
                    </select>
                    
                    <button id="evtApply" class="btn btn-primary flex-grow-1 flex-md-grow-0" style="height:42px; padding:0 20px; border-radius:12px;">Apply</button>
                    <button id="evtClear" class="action-btn flex-shrink-0" title="Clear" style="height:42px; width:42px; border-radius:12px; display:flex; align-items:center; justify-content:center; padding:0;">
                        <i class="fi fi-rr-refresh m-0"></i>
                    </button>
                </div>
            </div>

            <!-- Event Cards Grid -->
            <% if(events && events.length > 0) { %>
            <div class="row g-4 animate stagger-4">
                <% events.forEach(event => { %>
                <div class="col-sm-6 col-lg-4">
                    <div class="event-card dynamic-card glass-premium" onclick="window.location.href='/organizer/events/<%= event._id %>'">
                        <!-- Thumbnail -->
                        <% if(event.banners && event.banners.length > 0) { %>
                            <img class="event-card-thumb" src="<%= event.banners[0] %>" alt="<%= event.title %>">
                        <% } else { %>
                            <div class="event-card-thumb-placeholder"><i class="fi fi-rr-picture"></i></div>
                        <% } %>

                        <div class="event-card-body">
                            <!-- Status Badge -->
                            <div class="mb-2">
                                <% if(event.isBlocked) { %>
                                    <span class="status-badge status-rejected" style="font-size:0.7rem;"><i class="fi fi-rr-ban me-1"></i>Blocked</span>
                                <% } else if(event.status==='draft') { %>
                                    <span class="status-badge" style="font-size:0.7rem;background:rgba(155,89,182,0.15);color:#9b59b6;border:1px solid rgba(155,89,182,0.3);"><i class="fi fi-rr-disk me-1"></i>Draft</span>
                                <% } else if(event.status==='pending' || event.status==='under_review') { %>
                                    <span class="status-badge status-pending" style="font-size:0.7rem;"><i class="fi fi-rr-clock me-1"></i>Pending Review</span>
                                <% } else if(event.status==='approved' || event.status==='published') { %>
                                    <span class="status-badge status-approved" style="font-size:0.7rem;"><i class="fi fi-rr-check me-1"></i>Live</span>
                                <% } else if(event.status==='completed' || event.status==='sales_closed') { %>
                                    <span class="status-badge" style="font-size:0.7rem;background:rgba(52,152,219,0.15);color:#3498db;border:1px solid rgba(52,152,219,0.3);"><i class="fi fi-rr-check-circle me-1"></i>Completed</span>
                                <% } else if(event.status==='archived') { %>
                                    <span class="status-badge" style="font-size:0.7rem;background:rgba(155,89,182,0.15);color:#9b59b6;border:1px solid rgba(155,89,182,0.3);"><i class="fi fi-rr-archive me-1"></i>Archived</span>
                                <% } else if(event.status==='inactive') { %>
                                    <span class="status-badge" style="font-size:0.7rem;background:rgba(108,117,125,0.15);color:#6c757d;border:1px solid rgba(108,117,125,0.3);"><i class="fi fi-rr-time-past me-1"></i>Inactive</span>
                                <% } else if(event.status==='cancelled') { %>
                                    <span class="status-badge status-rejected" style="font-size:0.7rem;background:rgba(230,57,70,0.15);color:#e63946;border:1px solid rgba(230,57,70,0.3);"><i class="fi fi-rr-cross-circle me-1"></i>Cancelled</span>
                                <% } else { %>
                                    <span class="status-badge status-rejected" style="font-size:0.7rem;"><i class="fi fi-rr-cross me-1"></i>Rejected</span>
                                <% } %>
                                <% if(event.isFeatured) { %>
                                    <span class="status-badge ms-1" style="font-size:0.7rem;background:rgba(255,193,7,0.12);border:1px solid rgba(255,193,7,0.3);color:#ffc107;"><i class="fi fi-rr-star me-1"></i>Featured</span>
                                <% } %>
                            </div>

                            <h6 class="fw-bold mb-1" style="color:white;font-size:1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= event.title %></h6>
                            <p class="text-dim m-0 small mb-2"><%= event.category ? event.category.name : 'Uncategorized' %></p>

                            <div class="d-flex align-items-center gap-2 text-dim" style="font-size:0.8rem;">
                                <i class="fi fi-rr-calendar"></i>
                                <span><%= new Date(event.startDate).toLocaleDateString(undefined,{day:'numeric',month:'short',year:'numeric'}) %> &middot; <%= formatTime12(event.startTime) %></span>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-dim mt-1" style="font-size:0.8rem;">
                                <i class="fi fi-rr-marker"></i>
                                <span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px;" title="<%= event.location.address %>"><%= event.location.address %></span>
                            </div>
                        </div>

                        <div class="event-card-footer" onclick="event.stopPropagation()">
                            <a href="/organizer/events/<%= event._id %>" class="btn btn-outline btn-sm px-3" style="border-radius:8px;font-size:0.8rem;" title="View Details">
                                <i class="fi fi-rr-eye me-1"></i> View
                            </a>
                            <div class="d-flex gap-2">
                                <% if(event.status==='approved' || event.status==='published' || event.status==='completed' || event.status==='sales_closed') { %>
                                <a href="/organizer/events/<%= event._id %>/bookings" class="action-icon-btn" title="Bookings">
                                    <i class="fi fi-rr-money"></i>
                                </a>
                                <a href="/organizer/events/<%= event._id %>/sales-report" class="action-icon-btn" title="Sales Report" style="color:#2ecc71;border-color:rgba(46,204,113,0.2);">
                                    <i class="fi fi-rr-chart-histogram"></i>
                                </a>
                                <a href="/organizer/events/<%= event._id %>/scanning-report" class="action-icon-btn" title="Scanning Report" style="color:#6366f1;border-color:rgba(99,102,241,0.2);">
                                    <i class="fi fi-rr-expand"></i>
                                </a>
                                <% } %>
                                <% if(event.status==='pending' || event.status==='approved' || event.status==='draft' || event.status==='inactive' || event.status==='under_review' || event.status==='published' || event.status==='scheduled') { %>
                                <a href="/organizer/events/<%= event._id %>/edit" class="action-icon-btn" title="<%= event.status === 'draft' ? 'Continue' : 'Edit' %>">
                                    <i class="fi fi-rr-edit"></i>
                                </a>
                                <button onclick="openEditScheduleModal('<%= event._id %>', '<%= event.startDate ? new Date(event.startDate).toISOString().split('T')[0] : '' %>', '<%= event.startTime || '' %>', '<%= event.endDate ? new Date(event.endDate).toISOString().split('T')[0] : '' %>', '<%= event.endTime || '' %>', '<%= event.doorsOpenTime || '' %>', '<%= event.bookingOpenTime || '' %>', '<%= event.bookingCloseTime || '' %>')" class="action-icon-btn" title="Edit Schedule" style="color:#00b4d8;border-color:rgba(0,180,216,0.3);">
                                    <i class="fi fi-rr-calendar-clock"></i>
                                </button>
                                <% } %>
                                <% if(event.status==='completed' || event.status==='sales_closed') { %>
                                <button onclick="openEditScheduleModal('<%= event._id %>', '<%= event.startDate ? new Date(event.startDate).toISOString().split('T')[0] : '' %>', '<%= event.startTime || '' %>', '<%= event.endDate ? new Date(event.endDate).toISOString().split('T')[0] : '' %>', '<%= event.endTime || '' %>', '<%= event.doorsOpenTime || '' %>', '<%= event.bookingOpenTime || '' %>', '<%= event.bookingCloseTime || '' %>')" class="action-icon-btn" title="Extend / Edit Schedule" style="color:#ffb703;border-color:rgba(255,183,3,0.2);">
                                    <i class="fi fi-rr-calendar-clock"></i>
                                </button>
                                <% } %>
                                <button onclick="duplicateEvent('<%= event._id %>')" class="action-icon-btn" title="Duplicate Event" style="color:#3498db;border-color:rgba(52,152,219,0.2);">
                                    <i class="fi fi-rr-copy"></i>
                                </button>
                                <% if(event.status==='pending' || event.status==='under_review') { %>
                                <button onclick="withdrawReview('<%= event._id %>')" class="action-icon-btn" title="Withdraw Review" style="color:#3498db;border-color:rgba(52,152,219,0.2);">
                                    <i class="fi fi-rr-undo"></i>
                                </button>
                                <% } %>
                                <% if(event.status==='rejected' || event.status==='inactive') { %>
                                <button onclick="handleResubmit('<%= event._id %>')" class="action-icon-btn success" title="Resubmit">
                                    <i class="fi fi-rr-redo"></i>
                                </button>
                                <% } %>
                                <% if(event.status==='approved' || event.status==='published') { %>
                                <button onclick="toggleBlockEvent('<%= event._id %>', <%= event.isBlocked %>)" class="action-icon-btn" title="<%= event.isBlocked ? 'Unblock' : 'Block' %>">
                                    <i class="fi <%= event.isBlocked ? 'fi-rr-check' : 'fi-rr-ban' %>"></i>
                                </button>
                                <% } %>
                                <% const totalSold = (event.tickets || []).reduce((acc, t) => acc + (t.sold || 0), 0); %>
                                <% if(totalSold === 0 || event.status==='cancelled' || event.status==='completed' || event.status==='sales_closed' || event.status==='draft') { %>
                                <button onclick="deleteEvent('<%= event._id %>')" class="action-icon-btn danger" title="Delete Event">
                                    <i class="fi fi-rr-trash"></i>
                                </button>
                                <button onclick="archiveEvent('<%= event._id %>')" class="action-icon-btn" title="Archive Event" style="color:#9b59b6;border-color:rgba(155,89,182,0.2);">
                                    <i class="fi fi-rr-archive"></i>
                                </button>
                                <% } else { %>
                                <button onclick="cancelEvent('<%= event._id %>')" class="action-icon-btn danger" title="Cancel Bookings & Event (100% Refund)" style="color:#ff9f43;border-color:rgba(255,159,67,0.2);">
                                    <i class="fi fi-rr-cross-circle"></i>
                                </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <div class="text-center py-5 animate stagger-4">
                <i class="fi fi-rr-calendar-lines" style="font-size:3.5rem;display:block;margin-bottom:1rem;opacity:0.2;"></i>
                <h5 class="text-dim">No events found</h5>
                <p class="text-dim small">Try adjusting your filters or <a href="/organizer/events/new" class="text-primary">create a new event</a>.</p>
            </div>
            <% } %>

            <!-- Pagination -->
            <% if(totalPages > 1) { %>
            <div class="d-flex justify-content-between align-items-center mt-5 px-1 animate stagger-5">
                <p class="text-dim mb-0 small">Page <%= currentPage %> of <%= totalPages %> (<%= total %> events)</p>
                <nav><ul class="pagination d-flex gap-2 list-unstyled mb-0">
                    <% if(currentPage > 1) { %><li><button class="action-btn" onclick="changePage(<%= currentPage-1 %>)"><i class="fi fi-rr-angle-left"></i></button></li><% } %>
                    <% for(let i=1;i<=totalPages;i++) { %><li><button class="action-btn <%= i==currentPage?'active-page':'' %>" onclick="changePage(<%= i %>)"><%= i %></button></li><% } %>
                    <% if(currentPage < totalPages) { %><li><button class="action-btn" onclick="changePage(<%= currentPage+1 %>)"><i class="fi fi-rr-angle-right"></i></button></li><% } %>
                </ul></nav>
            </div>
            <% } %>
        </main>
    </div>

    <div class="modal-overlay" id="editScheduleModal" style="z-index: 9999; backdrop-filter: blur(8px);">
        <div class="modal-container" style="max-width: 620px; background: linear-gradient(165deg, rgba(30,30,30,0.95) 0%, rgba(15,15,15,0.98) 100%); border: 1px solid rgba(255,255,255,0.08); border-radius: 24px; box-shadow: 0 25px 50px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.02) inset; overflow: hidden; padding: 0;">
            <div style="background: rgba(255,255,255,0.02); padding: 1.75rem 2.5rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.05);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div style="width: 48px; height: 48px; border-radius: 14px; background: linear-gradient(135deg, rgba(0, 180, 216, 0.2), rgba(0, 180, 216, 0.05)); color: #00b4d8; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; border: 1px solid rgba(0, 180, 216, 0.2);">
                        <i class="fi fi-rr-calendar-clock"></i>
                    </div>
                    <button class="action-btn" onclick="closeEditScheduleModal()" style="width: 36px; height: 36px; border-radius: 50%;"><i class="fi fi-rr-cross-small"></i></button>
                </div>
                <h4 class="text-white m-0 fw-bold" style="letter-spacing: -0.5px;">Edit Event Schedule & Timings</h4>
                <p class="text-dim small m-0 mt-1">Update event dates, start/end times, doors open time, and booking sales window.</p>
            </div>
            <form id="editScheduleForm" onsubmit="submitEditSchedule(event)" style="padding: 1.75rem 2.5rem; max-height: 75vh; overflow-y: auto;">
                <input type="hidden" id="editScheduleEventId" value="">
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">START DATE</label>
                        <input type="date" id="editStartDate" name="startDate" class="input text-white" required style="color-scheme: dark; height: 46px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                    </div>
                    <div class="col-6">
                        <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">START TIME</label>
                        <input type="time" id="editStartTime" name="startTime" class="input text-white" required style="color-scheme: dark; height: 46px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">END DATE</label>
                        <input type="date" id="editEndDate" name="endDate" class="input text-white" required style="color-scheme: dark; height: 46px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                    </div>
                    <div class="col-6">
                        <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">END TIME</label>
                        <input type="time" id="editEndTime" name="endTime" class="input text-white" required style="color-scheme: dark; height: 46px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-4">
                        <label class="form-label text-dim small fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">DOORS OPEN</label>
                        <input type="time" id="editDoorsOpenTime" name="doorsOpenTime" class="input text-white" style="color-scheme: dark; height: 44px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                    </div>
                    <div class="col-4">
                        <label class="form-label text-dim small fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">OPEN SALES</label>
                        <input type="time" id="editBookingOpenTime" name="bookingOpenTime" class="input text-white" style="color-scheme: dark; height: 44px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                    </div>
                    <div class="col-4">
                        <label class="form-label text-dim small fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">CLOSE SALES</label>
                        <input type="time" id="editBookingCloseTime" name="bookingCloseTime" class="input text-white" style="color-scheme: dark; height: 44px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                    </div>
                </div>
                <div class="mb-4" style="background: rgba(0, 180, 216, 0.08); border: 1px solid rgba(0, 180, 216, 0.2); border-radius: 14px; padding: 1rem;">
                    <label class="d-flex align-items-center gap-2 m-0" style="cursor: pointer;">
                        <input type="checkbox" id="editExtendTicketSales" checked style="width: 18px; height: 18px; accent-color: #00b4d8;">
                        <span class="text-white small">Automatically align ticket tier sales end date to match updated event schedule</span>
                    </label>
                </div>
                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-outline flex-grow-1" onclick="closeEditScheduleModal()" style="border-color: rgba(255,255,255,0.1) !important; color: white !important; height: 48px; border-radius: 12px; font-weight: 600;">Cancel</button>
                    <button type="submit" class="btn btn-primary flex-grow-1 d-flex justify-content-center align-items-center gap-2" style="height: 48px; border-radius: 12px; font-weight: 700; background: linear-gradient(135deg, #00b4d8 0%, #0077b6 100%); color: #fff; border: none; box-shadow: 0 8px 20px rgba(0, 180, 216, 0.3);">
                        <i class="fi fi-rr-check"></i> Save Schedule Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function changePage(p) { const u=new URL(window.location.href);u.searchParams.set('page',p);window.location.href=u.toString(); }
        function applyFilters() {
            const s=document.getElementById('evtSearch').value.trim();
            const st=document.getElementById('evtStatus').value;
            const so=document.getElementById('evtSort').value;
            const u=new URL(window.location.origin+window.location.pathname);
            if(s) u.searchParams.set('search',s);
            if(st!=='all') u.searchParams.set('status',st);
            if(so!=='newest') u.searchParams.set('sort',so);
            u.searchParams.set('page',1);
            window.location.href=u.toString();
        }
        async function toggleBlockEvent(id,isBlocked) {
            const c=await CustomConfirm.show({title:`${isBlocked?'Unblock':'Block'} Event?`,message:`Are you sure you want to ${isBlocked?'unblock':'block'} this event?`,confirmText:'Yes, proceed',actionType:isBlocked?'primary':'danger',icon:isBlocked?'fi-rr-check':'fi-rr-ban'});
            if(!c) return; Loader.show('PROCESSING...');
            try { const r=await axios.post(`/organizer/events/${id}/toggle-block`); if(r.data.success){Toast.success(r.data.message);setTimeout(()=>location.reload(),1000);} }
            catch(e){Toast.error(e.response?.data?.message||'Failed');} finally{Loader.hide();}
        }
        async function deleteEvent(id) {
            const c=await CustomConfirm.show({title:'Delete Event?',message:'Permanently delete this event? This cannot be undone.',confirmText:'Yes, Delete',actionType:'danger',icon:'fi-rr-trash'});
            if(!c) return; Loader.show('DELETING...');
            try { const r=await axios.delete(`/organizer/events/${id}`); if(r.data.success){Toast.success(r.data.message);setTimeout(()=>location.reload(),1000);} }
            catch(e){Toast.error(e.response?.data?.message||'Failed');} finally{Loader.hide();}
        }
        function openEditScheduleModal(id, startDate, startTime, endDate, endTime, doorsOpen, bookingOpen, bookingClose) {
            document.getElementById('editScheduleEventId').value = id;
            if (startDate) document.getElementById('editStartDate').value = startDate;
            if (startTime) document.getElementById('editStartTime').value = startTime;
            if (endDate)   document.getElementById('editEndDate').value   = endDate;
            if (endTime)   document.getElementById('editEndTime').value   = endTime;
            if (doorsOpen) document.getElementById('editDoorsOpenTime').value = doorsOpen;
            if (bookingOpen) document.getElementById('editBookingOpenTime').value = bookingOpen;
            if (bookingClose) document.getElementById('editBookingCloseTime').value = bookingClose;
            document.getElementById('editScheduleModal').classList.add('active');
        }
        function closeEditScheduleModal() {
            document.getElementById('editScheduleModal').classList.remove('active');
            document.getElementById('editScheduleForm').reset();
        }
        function openExtendModal(id, currentEndDate, currentEndTime) {
            openEditScheduleModal(id, '', '', currentEndDate, currentEndTime, '', '', '');
        }
        function closeExtendModal() { closeEditScheduleModal(); }

        async function submitEditSchedule(e) {
            e.preventDefault();
            const id = document.getElementById('editScheduleEventId').value;
            const startDate = document.getElementById('editStartDate').value;
            const startTime = document.getElementById('editStartTime').value;
            const endDate   = document.getElementById('editEndDate').value;
            const endTime   = document.getElementById('editEndTime').value;
            const doorsOpenTime    = document.getElementById('editDoorsOpenTime').value;
            const bookingOpenTime  = document.getElementById('editBookingOpenTime').value;
            const bookingCloseTime = document.getElementById('editBookingCloseTime').value;
            const extendTicketSales = document.getElementById('editExtendTicketSales').checked;

            if (!startDate || !startTime || !endDate || !endTime) {
                Toast.error('Please select both start and end date/time');
                return;
            }
            if (new Date(`${startDate}T${startTime}`) >= new Date(`${endDate}T${endTime}`)) {
                Toast.error('End date/time must be after start date/time');
                return;
            }

            Loader.show('Updating Event Schedule & Timings...');
            try {
                const res = await axios.post(`/organizer/events/${id}/update-schedule`, {
                    startDate, startTime, endDate, endTime,
                    doorsOpenTime, bookingOpenTime, bookingCloseTime,
                    extendTicketSales
                });
                if (res.data.success) {
                    Toast.success(res.data.message);
                    closeEditScheduleModal();
                    setTimeout(() => location.reload(), 1200);
                }
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to update event schedule');
            } finally {
                Loader.hide();
            }
        }
        async function duplicateEvent(id) {
            const c=await CustomConfirm.show({title:'Duplicate Event?',message:'Create a clone of this event as a draft?',confirmText:'Yes, Duplicate',actionType:'primary',icon:'fi-rr-copy'});
            if(!c) return; Loader.show('DUPLICATING EVENT...');
            try { const r=await axios.post(`/organizer/events/${id}/duplicate`); if(r.data.success){Toast.success(r.data.message);setTimeout(()=>location.reload(),1000);} }
            catch(e){Toast.error(e.response?.data?.message||'Failed');} finally{Loader.hide();}
        }
        async function cancelEvent(id) {
            const c=await CustomConfirm.show({title:'Cancel Event?',message:'Are you sure you want to cancel this event? All registered attendees will automatically receive a 100% refund to their wallet.',confirmText:'Yes, Cancel & 100% Refund',actionType:'danger',icon:'fi-rr-cross-circle'});
            if(!c) return; Loader.show('CANCELLING EVENT & REFUNDING 100%...');
            try { const r=await axios.post(`/organizer/events/${id}/cancel`); if(r.data.success){Toast.success(r.data.message);setTimeout(()=>location.reload(),1200);} }
            catch(e){Toast.error(e.response?.data?.message||'Failed');} finally{Loader.hide();}
        }
        async function withdrawReview(id) {
            const c=await CustomConfirm.show({title:'Withdraw Review?',message:'Withdraw this event from admin review? It will be returned to draft status.',confirmText:'Yes, Withdraw',actionType:'primary',icon:'fi-rr-undo'});
            if(!c) return; Loader.show('WITHDRAWING...');
            try { const r=await axios.post(`/organizer/events/${id}/withdraw`); if(r.data.success){Toast.success(r.data.message);setTimeout(()=>location.reload(),1000);} }
            catch(e){Toast.error(e.response?.data?.message||'Failed');} finally{Loader.hide();}
        }
        async function archiveEvent(id) {
            const c=await CustomConfirm.show({title:'Archive Event?',message:'Archive this event? It will be moved to your archived events list.',confirmText:'Yes, Archive',actionType:'primary',icon:'fi-rr-archive'});
            if(!c) return; Loader.show('ARCHIVING...');
            try { const r=await axios.post(`/organizer/events/${id}/archive`); if(r.data.success){Toast.success(r.data.message);setTimeout(()=>location.reload(),1000);} }
            catch(e){Toast.error(e.response?.data?.message||'Failed');} finally{Loader.hide();}
        }
        async function handleResubmit(id) {
            const e=await CustomConfirm.show({title:'Resubmit Event',message:'Edit before resubmitting?',confirmText:'Edit First',cancelText:'Resubmit Now',actionType:'primary',icon:'fi-rr-edit'});
            if(e){window.location.href=`/organizer/events/${id}/edit`;return;}
            const c=await CustomConfirm.show({title:'Confirm Resubmit?',message:'Event will be sent for admin review.',confirmText:'Yes, Resubmit',actionType:'primary',icon:'fi-rr-redo'});
            if(!c) return; Loader.show('RESUBMITTING...');
            try { const r=await axios.post(`/organizer/events/${id}/resubmit`); if(r.data.success){Toast.success(r.data.message);setTimeout(()=>location.reload(),1200);} }
            catch(err){Toast.error(err.response?.data?.message||'Failed');} finally{Loader.hide();}
        }
        document.addEventListener('DOMContentLoaded',()=>{
            document.getElementById('evtApply')?.addEventListener('click',applyFilters);
            document.getElementById('evtClear')?.addEventListener('click',()=>window.location.href=window.location.pathname);
            document.getElementById('evtSearch')?.addEventListener('keypress',e=>{if(e.key==='Enter')applyFilters();});
        });
    </script>
</body>
</html>