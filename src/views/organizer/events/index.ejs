<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
</head>
<body class="bg-mesh">
    
    <%- include('../partials/navbars/organizer-nav') %>

    <div class="dashboard-layout">
        <%- include('../../partials/organizer-sidebar', { title: 'My Events' }) %>
        
        <main class="dashboard-main">
            <div class="d-flex justify-between align-center mb-4 animate stagger-1">
                <div>
                    <h2 class="fw-bold">My Events</h2>
                    <p class="text-dim m-0">Manage your created events, track statuses, and update details.</p>
                </div>
                <a href="/organizer/events/new" class="btn btn-primary">
                    <i class="fi fi-rr-plus me-2"></i> Create Event
                </a>
            </div>

            <!-- Events Table -->
            <div class="glass-dark p-4 rounded-3 animate stagger-2">
                <div style="overflow-x: auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Event Details</th>
                                <th>Date & Location</th>
                                <th>Tickets Sold</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Example Data Row (Replace with EJS loop) -->
                            <!-- <% events.forEach(event => { %> -->
                            <tr>
                                <td>
                                    <div class="d-flex align-center gap-3">
                                        <div style="width: 50px; height: 50px; border-radius: 8px; background: rgba(255,255,255,0.1); overflow: hidden;">
                                            <!-- <img src="<%= event.imageUrl %>" style="width: 100%; height: 100%; object-fit: cover;"> -->
                                        </div>
                                        <div>
                                            <strong style="color: white; font-size: 1rem;">Kerala Tech Summit 2026</strong>
                                            <p class="text-dim m-0" style="font-size: 0.8rem;">Technology</p>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span style="color: white;">Nov 15, 2026</span>
                                    <p class="text-dim m-0" style="font-size: 0.8rem;">Kozhikode Trade Centre</p>
                                </td>
                                <td>
                                    <span style="color: white; font-weight: 600;">145 / 500</span>
                                    <div style="width: 100%; height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; margin-top: 5px;">
                                        <div style="width: 29%; height: 100%; background: #2ecc71; border-radius: 2px;"></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge status-approved">
                                        <i class="fi fi-rr-circle-small"></i> Published
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline btn-sm px-3"><i class="fi fi-rr-edit"></i></button>
                                </td>
                            </tr>
                            <!-- <% }) %> -->
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</body>
</html>