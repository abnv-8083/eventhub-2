<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
</head>
<body class="bg-mesh">
    <%- include('../../partials/navbars/organizer-nav') %>
    <div class="dashboard-layout">
        <%- include('../../partials/organizer-sidebar', { title: 'Manage Events' }) %>
        <main class="dashboard-main">

            <%# ── Page Header & Dedicated Payout UI ── %>
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 animate stagger-1">
                <div>
                    <h2 class="fw-bold mb-1">Bookings: <%= event.title %></h2>
                    <p class="text-dim m-0">Manage all bookings, statuses, and payouts for this event.</p>
                </div>
                
                <div class="d-flex gap-2 align-items-center p-2 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
                    <% 
                       const now = new Date();
                       const eventEnd = new Date(event.endDate || event.startDate);
                       eventEnd.setHours(23, 59, 59, 999);
                       const isFinished = now > eventEnd;
                    %>

                    <%# ── Pending Cancellation Requests Badge ── %>
                    <% if(typeof pendingCancelCount !== 'undefined' && pendingCancelCount > 0) { %>
                        <a href="/organizer/events/<%= event._id %>/bookings-cancellations" class="d-flex align-items-center gap-2 px-3 py-1 rounded-3 text-decoration-none" 
                           style="background: rgba(243,156,18,0.1); border: 1px solid rgba(243,156,18,0.3); color: #f39c12;">
                            <i class="fi fi-rr-bell-ring"></i>
                            <span class="fw-bold small"><%= pendingCancelCount %> Cancel Request<%= pendingCancelCount > 1 ? 's' : '' %></span>
                        </a>
                    <% } %>

                    <a href="/organizer/events/<%= event._id %>/bookings-cancellations" class="btn btn-outline btn-sm px-3 py-2 d-flex align-items-center gap-2" style="border-color: rgba(230,57,70,0.3); color: #E63946;">
                        <i class="fi fi-rr-ban"></i> Cancellations
                    </a>

                    <% if(payout) { %>
                        <div class="d-flex align-items-center px-3">
                            <span class="text-dim small me-2 text-uppercase fw-bold">Payout Status:</span>
                            <span class="badge <%= payout.status === 'paid' ? 'bg-success' : 'bg-warning text-dark' %> px-3 py-2" style="font-size: 0.85rem;">
                                <%= payout.status === 'paid' ? '✓ Processed' : '⏳ Pending Approval' %>
                            </span>
                        </div>
                    <% } else if(totalRevenue > 0) { %>
                        <% if(isFinished) { %>
                            <button onclick="requestPayout('<%= event._id %>')" class="btn btn-primary px-4 py-2 fw-bold d-flex align-items-center">
                                <i class="fi fi-rr-money me-2"></i> Request Payout
                            </button>
                        <% } else { %>
                            <span class="text-warning small px-3 fw-bold" style="background: rgba(243, 156, 18, 0.1); border: 1px solid rgba(243, 156, 18, 0.2); border-radius: 8px; padding: 8px; display: inline-flex; align-items: center;"><i class="fi fi-rr-time-clock me-2"></i>Payout opens after event ends</span>
                        <% } %>
                    <% } else { %>
                        <span class="text-dim small px-3"><i class="fi fi-rr-info me-1"></i>No revenue to payout yet</span>
                    <% } %>
                    
                    <div style="width: 1px; height: 30px; background: rgba(255,255,255,0.1); margin: 0 5px;"></div>
                    
                    <a href="/organizer/events/<%= event._id %>" class="btn btn-outline btn-sm px-3 py-2">
                        <i class="fi fi-rr-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>

            <%# ── Revenue Stats Cards ── %>
            <div class="row g-3 mb-4 animate stagger-2">
                
                <div class="col-sm-6 col-lg-3">
                    <div class="glass-premium dynamic-card p-4 rounded-4 h-100 d-flex flex-column justify-content-center">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div style="background: rgba(255,255,255,0.05); padding: 8px 10px; border-radius: 8px;">
                                <i class="fi fi-rr-coins text-white"></i>
                            </div>
                            <p class="text-dim small text-uppercase fw-bold m-0">Total Revenue</p>
                        </div>
                        <h3 class="fw-bold m-0 text-white">₹<%= totalRevenue.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></h3>
                    </div>
                </div>
                
                <div class="col-sm-6 col-lg-3">
                    <div class="glass-premium dynamic-card p-4 rounded-4 h-100 d-flex flex-column justify-content-center">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div style="background: rgba(230, 57, 70, 0.1); padding: 8px 10px; border-radius: 8px;">
                                <i class="fi fi-rr-receipt text-danger"></i>
                            </div>
                            <p class="text-dim small text-uppercase fw-bold m-0">Platform Fee (5%)</p>
                        </div>
                        <h3 class="fw-bold m-0" style="color:#E63946;">₹<%= (totalRevenue * 0.05).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></h3>
                    </div>
                </div>
                
                <div class="col-sm-6 col-lg-3">
                    <div class="glass-premium dynamic-card p-4 rounded-4 h-100 d-flex flex-column justify-content-center" 
                         style="border: 1px solid rgba(46, 204, 113, 0.2); background: linear-gradient(145deg, rgba(46, 204, 113, 0.05) 0%, rgba(0,0,0,0.2) 100%);">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div style="background: rgba(46, 204, 113, 0.15); padding: 8px 10px; border-radius: 8px;">
                                <i class="fi fi-rr-sack-dollar text-success"></i>
                            </div>
                            <p class="text-dim small text-uppercase fw-bold m-0">Net Payout</p>
                        </div>
                        <h3 class="fw-bold m-0" style="color:#2ecc71;">₹<%= (totalRevenue * 0.95).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></h3>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <div class="glass-premium dynamic-card p-3 rounded-4 h-100 d-flex flex-column justify-content-center">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <p class="text-dim small text-uppercase fw-bold m-0">Total Bookings</p>
                            <h5 class="fw-bold text-white m-0"><%= counts.all %></h5>
                        </div>
                        
                        <div class="d-flex flex-column gap-1">
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="text-dim"><i class="fi fi-rr-check text-success me-2"></i>Active</span>
                                <span class="fw-bold text-white"><%= counts.active %></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="text-dim"><i class="fi fi-rr-pause text-warning me-2"></i>On Hold</span>
                                <span class="fw-bold text-white"><%= counts.on_hold %></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="text-dim"><i class="fi fi-rr-ban text-danger me-2"></i>Cancelled</span>
                                <span class="fw-bold text-white"><%= counts.cancelled %></span>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>

            <%# ── Status Filter Tabs ── %>
            <div class="filter-tabs mb-4 animate stagger-3">
                <a href="?status=all&sort=<%= filters.sort %>" class="filter-tab <%= filters.status === 'all' ? 'active' : '' %>">
                    All <span class="tab-count"><%= counts.all %></span>
                </a>
                <a href="?status=active&sort=<%= filters.sort %>" class="filter-tab <%= filters.status === 'active' ? 'active' : '' %>">
                    <i class="fi fi-rr-check me-1"></i>Active <span class="tab-count"><%= counts.active %></span>
                </a>
                <a href="?status=on_hold&sort=<%= filters.sort %>" class="filter-tab <%= filters.status === 'on_hold' ? 'active' : '' %>">
                    <i class="fi fi-rr-pause me-1"></i>On Hold <span class="tab-count"><%= counts.on_hold %></span>
                </a>
                <a href="?status=cancelled&sort=<%= filters.sort %>" class="filter-tab <%= filters.status === 'cancelled' ? 'active' : '' %>">
                    <i class="fi fi-rr-ban me-1"></i>Cancelled <span class="tab-count"><%= counts.cancelled %></span>
                </a>
            </div>

            <%# ── Search & Sort ── %>
            <div class="d-flex justify-content-between align-items-center mb-4 gap-3 animate stagger-3">
                <div class="search-wrapper flex-grow-1" style="position:relative;max-width:380px;">
                    <i class="fi fi-rr-search text-dim" style="position:absolute;left:15px;top:50%;transform:translateY(-50%);"></i>
                    <input type="text" id="bkSearch" class="input ps-5" placeholder="Search user, email, ticket..." value="<%= filters.search || '' %>" 
                           style="height:45px; color: white; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);">
                </div>
                <div class="d-flex gap-2">
                    <select id="bkSort" class="input px-3" style="height:45px; padding-top: 0; padding-bottom: 0; line-height: 43px; color: white; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);">
                        <option value="newest"       <%= filters.sort === 'newest' || !filters.sort ? 'selected' : '' %> style="color: black;">Newest First</option>
                        <option value="oldest"       <%= filters.sort === 'oldest'       ? 'selected' : '' %> style="color: black;">Oldest First</option>
                        <option value="amount-high"  <%= filters.sort === 'amount-high'  ? 'selected' : '' %> style="color: black;">Amount (High→Low)</option>
                        <option value="amount-low"   <%= filters.sort === 'amount-low'   ? 'selected' : '' %> style="color: black;">Amount (Low→High)</option>
                    </select>
                    <button id="bkClear" class="action-btn" title="Clear" style="height:45px;width:45px;"><i class="fi fi-rr-refresh"></i></button>
                    <button id="bkApply" class="btn btn-primary fw-bold" style="height:45px;padding:0 20px;">Apply</button>
                </div>
            </div>

            <%# ── Bookings Table ── %>
            <div class="glass-premium dynamic-card p-4 rounded-3 animate stagger-4">
                <h6 class="fw-bold mb-4">Bookings (<%= total %>)</h6>
                <div style="overflow-x:auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Booking ID</th>
                                <th>User</th>
                                <!-- <th>Tickets</th>  -->
                                <th>Payments</th>
                                <th>Total</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(bookings && bookings.length > 0) { %>
                                <% bookings.forEach(booking => { %>
                                    <tr>
                                        <td class="text-dim" style="font-family:monospace;font-size:0.78rem;">#<%= booking._id.toString().slice(-8).toUpperCase() %></td>
                                        
                                        <td>
                                            <% if (booking.user && booking.user.fullName) { %>
                                                <strong style="color:white;"><%= booking.user.fullName %></strong>
                                            <% } else { %>
                                                <strong style="color:rgba(255,255,255,0.4);">Unknown User</strong>
                                            <% } %>
                                            <p class="text-dim m-0" style="font-size:0.78rem;"><%= booking.user?.email || 'N/A' %></p>
                                        </td>

                                        <!-- <td>
                                            <% if (booking.tickets && booking.tickets.length > 0) { %>
                                                <% booking.tickets.forEach(t => { %>
                                                    <div style="margin-bottom: 3px; padding-bottom: 3px; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                                        <strong><%= t.ticketName %></strong><br>
                                                        <span class="text-dim" style="font-size:0.75rem;">Qty: <%= t.quantity %></span>
                                                    </div>
                                                <% }) %>
                                            <% } else if (booking.ticketName) { %>
                                                <div style="margin-bottom: 3px; padding-bottom: 3px; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                                    <strong><%= booking.ticketName %></strong><br>
                                                    <span class="text-dim" style="font-size:0.75rem;">Qty: <%= booking.quantity || 1 %></span>
                                                </div>
                                            <% } else { %>
                                                <span class="text-dim small">No tickets</span>
                                            <% } %>
                                        </td> -->

                                        <td>
                                            <% if(booking.payments && Array.isArray(booking.payments) && booking.payments.length > 0) { %>
                                                <% booking.payments.forEach(p => { %>
                                                    <div class="payment-tag" style="font-size:0.7rem; padding:2px 5px; margin-bottom:2px;">
                                                        ID: <%= p.id ? p.id.slice(0,10)+'...' : 'Wallet' %> (<%= p.status %>)
                                                    </div>
                                                <% }) %>
                                            <% } else { %>
                                                <span class="text-dim small">No payments</span>
                                            <% } %>
                                        </td>

                                        <td>
                                            <strong style="color:<%= booking.status === 'cancelled' ? 'rgba(255,255,255,0.3)' : '#2ecc71' %>; text-decoration:<%= booking.status === 'cancelled' ? 'line-through' : 'none' %>;">
                                                ₹<%= booking.totalAmount.toLocaleString('en-IN') %>
                                            </strong>
                                        </td>

                                        <td class="text-dim" style="font-size:0.8rem;">
                                            <%= new Date(booking.bookingDate || booking.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                                        </td>

                                        <td>
                                            <% if(booking.status === 'active') { %>
                                                <span class="bk-badge bk-active"><i class="fi fi-rr-check me-1"></i>Active</span>
                                            <% } else if(booking.status === 'on_hold') { %>
                                                <span class="bk-badge bk-hold"><i class="fi fi-rr-pause me-1"></i>On Hold</span>
                                            <% } else { %>
                                                <span class="bk-badge bk-cancelled"><i class="fi fi-rr-ban me-1"></i>Cancelled</span>
                                            <% } %>
                                        </td>

                                        <td>
                                            <div class="d-flex gap-1 flex-wrap">
                                                <button class="org-action-btn org-view" onclick="viewBooking('<%= event._id %>', '<%= booking._id %>')" title="View Details">
                                                    <i class="fi fi-rr-eye"></i>
                                                </button>

                                                <%# Pending Cancellation Request — Approve/Reject quick buttons %>
                                                <% if(booking.cancellationRequest && booking.cancellationRequest.status === 'pending') { %>
                                                    <button class="org-action-btn" onclick="quickApproveCancelRequest('<%= booking._id %>')" 
                                                            title="Approve Cancellation Request"
                                                            style="color:#2ecc71;background:rgba(46,204,113,0.1);border-color:rgba(46,204,113,0.2);">
                                                        <i class="fi fi-rr-check"></i>
                                                    </button>
                                                    <button class="org-action-btn" onclick="openOrgRejectModal('<%= booking._id %>')" 
                                                            title="Reject Cancellation Request"
                                                            style="color:#f39c12;background:rgba(243,156,18,0.1);border-color:rgba(243,156,18,0.2);">
                                                        <i class="fi fi-rr-cross"></i>
                                                    </button>
                                                <% } %>

                                                <% if(booking.status === 'active') { %>
                                                    <button class="org-action-btn org-hold" onclick="toggleHold('<%= event._id %>', '<%= booking._id %>', false)" title="Put on Hold">
                                                        <i class="fi fi-rr-pause"></i>
                                                    </button>
                                                <% } else if(booking.status === 'on_hold') { %>
                                                    <button class="org-action-btn org-resume" onclick="toggleHold('<%= event._id %>', '<%= booking._id %>', true)" title="Resume Booking">
                                                        <i class="fi fi-rr-play"></i>
                                                    </button>
                                                <% } %>

                                                <% if(booking.status !== 'cancelled') { %>
                                                    <button class="org-action-btn org-cancel" onclick="cancelBooking('<%= event._id %>', '<%= booking._id %>')" title="Cancel Entire Booking">
                                                        <i class="fi fi-rr-ban"></i>
                                                    </button>
                                                <% } else { %>
                                                    <button class="org-action-btn" onclick="deleteBooking('<%= event._id %>', '<%= booking._id %>')" title="Delete Record permanently" style="color: #E63946; background: rgba(230,57,70,0.1); border-color: rgba(230,57,70,0.2);">
                                                        <i class="fi fi-rr-trash"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="8" class="text-center text-dim py-4">No bookings found.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <%# ── Pagination ── %>
            <% if(totalPages > 1) { %>
                <div class="d-flex justify-content-between align-items-center mt-4 px-1">
                    <p class="text-dim mb-0">Page <%= currentPage %> of <%= totalPages %> (<%= total %> bookings)</p>
                    <nav>
                        <ul class="pagination d-flex gap-2 list-unstyled mb-0">
                            <% if(currentPage > 1) { %><li><button class="action-btn" onclick="changePage(<%= currentPage - 1 %>)"><i class="fi fi-rr-angle-left"></i></button></li><% } %>
                            <% for(let i = 1; i <= totalPages; i++) { %><li><button class="action-btn <%= i == currentPage ? 'active-page' : '' %>" onclick="changePage(<%= i %>)"><%= i %></button></li><% } %>
                            <% if(currentPage < totalPages) { %><li><button class="action-btn" onclick="changePage(<%= currentPage + 1 %>)"><i class="fi fi-rr-angle-right"></i></button></li><% } %>
                        </ul>
                    </nav>
                </div>
            <% } %>

        </main>
    </div>

    <%# ── RESTORED: Booking Detail Modal ── %>
    <div class="modal-overlay" id="bookingDetailModal">
        <div class="modal-container" style="max-width:620px; max-height: 85vh; display: flex; flex-direction: column;">
            <div class="modal-header" style="flex-shrink: 0;">
                <h5 class="fw-bold m-0"><i class="fi fi-rr-ticket me-2 text-primary"></i>Booking Detail</h5>
                <span class="modal-close" onclick="closeModal()" style="cursor: pointer;"><i class="fi fi-rr-cross-small"></i></span>
            </div>
            <div class="modal-body custom-scrollbar" id="modalBody" style="overflow-y: auto; overflow-x: hidden; padding-bottom: 1.5rem;">
                <div class="text-center py-4 text-dim">
                    <i class="fi fi-rr-spinner" style="font-size:2rem;display:block;margin-bottom:0.75rem;animation:spin 1s linear infinite;"></i>
                    Loading...
                </div>
            </div>
        </div>
    </div>

    <%# ── Custom Hold Reason Modal ── %>
    <div class="modal-overlay" id="holdReasonModal">
        <div class="modal-container" style="max-width:450px;">
            <div class="modal-header">
                <h5 class="fw-bold m-0"><i class="fi fi-rr-pause-circle me-2 text-warning"></i>Hold Booking</h5>
                <span class="modal-close" onclick="closeHoldModal()" style="cursor: pointer;"><i class="fi fi-rr-cross-small"></i></span>
            </div>
            <div class="modal-body p-4 text-start">
                <p class="text-dim mb-3" style="font-size: 0.9rem;">Please provide a reason for placing this booking on hold. This will be visible in the booking details.</p>
                <textarea id="holdReasonInput" rows="3" placeholder="e.g., Pending offline payment verification..." 
                          style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 8px; padding: 12px; outline: none; transition: border-color 0.2s;"
                          onfocus="this.style.borderColor='rgba(255,255,255,0.4)'"
                          onblur="this.style.borderColor='rgba(255,255,255,0.1)'"></textarea>
                <p id="holdReasonError" class="text-danger mt-2 mb-0 small" style="display: none;"><i class="fi fi-rr-info me-1"></i>A reason is required.</p>
                
                <div class="d-flex justify-content-end gap-2 mt-4 pt-2">
                    <button class="btn px-4 py-2" style="background: rgba(255,255,255,0.05); color: white; border: none;" onclick="closeHoldModal()">Cancel</button>
                    <button class="btn btn-warning px-4 py-2 fw-bold" id="confirmHoldBtn">Confirm Hold</button>
                </div>
            </div>
        </div>
    </div>

    <%# ── Organizer Reject Reason Modal ── %>
    <div class="modal-overlay" id="orgRejectModal" style="z-index: 999999;">
        <div class="modal-container" style="max-width: 450px;">
            <div class="modal-header">
                <h5 class="fw-bold m-0"><i class="fi fi-rr-cross-circle me-2 text-warning"></i>Reject Cancellation Request</h5>
                <span class="modal-close" onclick="closeOrgRejectModal()" style="cursor: pointer;"><i class="fi fi-rr-cross-small"></i></span>
            </div>
            <div class="modal-body p-4 text-start">
                <p class="text-dim mb-3" style="font-size: 0.9rem;">Provide a reason for rejecting this request. The user will be notified.</p>
                <textarea id="orgRejectNoteInput" rows="3" placeholder="e.g., Event is non-refundable per terms..." 
                          style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 8px; padding: 12px; outline: none;"
                          onfocus="this.style.borderColor='rgba(255,255,255,0.4)'"
                          onblur="this.style.borderColor='rgba(255,255,255,0.1)'"></textarea>
                <p id="orgRejectNoteError" class="text-danger mt-1 small" style="display: none;"><i class="fi fi-rr-info me-1"></i>Please provide a rejection note.</p>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button class="btn px-4 py-2" style="background: rgba(255,255,255,0.05); color: white; border: none;" onclick="closeOrgRejectModal()">Cancel</button>
                    <button class="btn btn-warning px-4 py-2 fw-bold" id="confirmOrgRejectBtn">Reject Request</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="organizerQtyConfirmModal" style="z-index: 999999;">
        <div class="modal-container" style="max-width: 400px; padding: 0;">
            <div class="modal-body text-center p-5">
                <div style="width: 70px; height: 70px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.5rem; background: rgba(230, 57, 70, 0.1); color: #E63946;">
                    <i class="fi fi-rr-ticket"></i>
                </div>
                <h3 class="fw-bold mb-2 text-white">Cancel Tickets</h3>
                <p class="text-dim mb-4" style="font-size: 0.95rem;">How many tickets would you like to cancel for this user?</p>
                
                <div class="mb-4">
                    <input type="number" id="orgCancelQtyInput" class="input text-center" min="1" value="1" style="font-size: 1.5rem; width: 120px; margin: 0 auto;">
                </div>

                <div class="d-flex gap-3 mt-2">
                    <button class="btn btn-outline flex-grow-1" onclick="closeOrgQtyModal()" style="border-color: rgba(255,255,255,0.2) !important; color: white !important;">Go Back</button>
                    <button class="btn btn-primary flex-grow-1" id="confirmOrgQtyBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ── Filters ──────────────────────────────────────────────────────────
        function changePage(p) {
            const url = new URL(window.location.href);
            url.searchParams.set('page', p);
            window.location.href = url.toString();
        }
        function applyFilters() {
            const search = document.getElementById('bkSearch').value.trim();
            const sort   = document.getElementById('bkSort').value;
            const url    = new URL(window.location.origin + window.location.pathname);
            if (search) url.searchParams.set('search', search);
            if (sort !== 'newest') url.searchParams.set('sort', sort);
            const status = new URLSearchParams(window.location.search).get('status') || 'all';
            url.searchParams.set('status', status);
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        }
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('bkApply')?.addEventListener('click', applyFilters);
            document.getElementById('bkClear')?.addEventListener('click', () => window.location.href = window.location.pathname);
            document.getElementById('bkSearch')?.addEventListener('keypress', e => { if (e.key === 'Enter') applyFilters(); });
        });

        // ─── Booking Detail Modal ──────────────────────────────────────────────
        async function viewBooking(eventId, bookingId) {
            const modal = document.getElementById('bookingDetailModal');
            const body  = document.getElementById('modalBody');

            body.innerHTML = `<div class="text-center py-4 text-dim"><i class="fi fi-rr-spinner" style="font-size:2rem;display:block;margin-bottom:0.75rem;animation:spin 1s linear infinite;"></i>Loading details...</div>`;
            modal.classList.add('active');

            try {
                const res = await axios.get(`/organizer/events/${eventId}/bookings/${bookingId}`);
                const b = res.data.booking;
                
                const isPaid = b.paymentStatus === 'completed';
                const statusColors = { active: '#2ecc71', on_hold: '#f39c12', cancelled: '#E63946' };
                const statusLabels = { active: '✓ Active', on_hold: '⏸ On Hold', cancelled: '✗ Cancelled' };
                const col = statusColors[b.status] || 'white';

                // Handle both New Shopping Cart Arrays & Old Single Ticket Data
                let ticketsHtml = '';
                if (b.tickets && b.tickets.length > 0) {
                    ticketsHtml = b.tickets.map(t => {
                        const isCancelled = t.status === 'cancelled';
                        const priceHtml = isCancelled 
                            ? `<del class="text-dim">₹${(t.quantity * (t.ticketPrice || 0)).toLocaleString('en-IN')}</del>`
                            : `<strong class="text-white">₹${(t.quantity * (t.ticketPrice || 0)).toLocaleString('en-IN')}</strong>`;
                        
                        const actionBtn = (!isCancelled && b.status === 'active')
                            ? `<button class="btn btn-outline-danger px-2 py-0 ms-2" style="font-size: 0.65rem;" onclick="cancelSingleTicket('${eventId}', '${bookingId}', '${t._id}', ${t.quantity})">Cancel Ticket</button>`
                            : (isCancelled ? `<span class="badge bg-danger ms-2" style="font-size: 0.6rem;">Refunded</span>` : '');

                        return `
                        <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px dashed rgba(255,255,255,0.05);">
                            <div>
                                <p class="m-0 text-white fw-bold ${isCancelled ? 'text-dim text-decoration-line-through' : ''}">${t.ticketName}</p>
                                <small class="text-dim">Qty: ${t.quantity} × ₹${(t.ticketPrice || 0).toLocaleString('en-IN')}</small>
                            </div>
                            <div class="text-end d-flex align-items-center">
                                ${priceHtml}
                                ${actionBtn}
                            </div>
                        </div>`;
                    }).join('');
                } else if (b.ticketName) {
                    const tPrice = b.ticketPrice || b.totalAmount || 0;
                    const tQty = b.quantity || 1;
                    ticketsHtml = `
                        <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px dashed rgba(255,255,255,0.05);">
                            <div>
                                <p class="m-0 text-white fw-bold">${b.ticketName}</p>
                                <small class="text-dim">Qty: ${tQty} × ₹${tPrice.toLocaleString('en-IN')}</small>
                            </div>
                            <strong class="text-white">₹${(tQty * tPrice).toLocaleString('en-IN')}</strong>
                        </div>
                    `;
                } else {
                    ticketsHtml = '<p class="text-dim small m-0 py-2">No ticket data found.</p>';
                }

                // Inject Modal Content
                body.innerHTML = `
                    <div class="row g-3">
                        <div class="col-12">
                            <div style="background:rgba(255,255,255,0.03);border-radius:10px;padding:1rem 1.25rem;border:1px solid rgba(255,255,255,0.07);">
                                <p class="text-dim m-0 mb-1" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;font-weight:700;">Purchased By</p>
                                <strong class="text-white" style="font-size:1rem;">${b.user?.fullName || 'Unknown User'}</strong>
                                <span class="text-dim ms-2" style="font-size:0.85rem;">${b.user?.email || ''}</span>
                                ${b.user?.phone ? `<br><small class="text-dim"><i class="fi fi-rr-phone-call me-1 mt-1"></i>${b.user.phone}</small>` : ''}
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <div class="modal-detail-cell p-3" style="background:rgba(0,0,0,0.2);">
                                <p class="text-dim m-0 mb-2" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;font-weight:700;">Ticket Information</p>
                                ${ticketsHtml}
                                <div class="d-flex justify-content-between align-items-center pt-3 mt-2" style="border-top: 1px solid rgba(255,255,255,0.1);">
                                    <span class="text-white fw-bold">Grand Total</span>
                                    <strong style="color:#2ecc71;font-size:1.3rem;">₹${(b.totalAmount || 0).toLocaleString('en-IN')}</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-12"><div style="border-top:1px solid rgba(255,255,255,0.07);margin:0.5rem 0;"></div></div>

                        <div class="col-md-6">
                            <div class="modal-detail-cell">
                                <p class="modal-detail-label">Payment Method</p>
                                <p class="modal-detail-val fw-bold">${b.paymentMethod === 'wallet' ? '🔵 Wallet' : '💳 Razorpay'}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="modal-detail-cell">
                                <p class="modal-detail-label">Payment Status</p>
                                <p class="modal-detail-val fw-bold" style="color:${isPaid ? '#2ecc71' : (b.paymentStatus==='refunded' ? '#3498db' : '#f39c12')};">
                                    ${b.paymentStatus === 'completed' ? '● Completed' : b.paymentStatus === 'refunded' ? '↩ Refunded' : b.paymentStatus}
                                </p>
                            </div>
                        </div>
                        
                        <div class="col-12">
                            <div class="modal-detail-cell">
                                <p class="modal-detail-label">Transaction ID</p>
                                <p class="modal-detail-val" style="font-family:monospace;font-size:0.85rem;color:rgba(255,255,255,0.5);word-break:break-all;">${b.paymentId || '—'}</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="modal-detail-cell">
                                <p class="modal-detail-label">Booking Date</p>
                                <p class="modal-detail-val">${new Date(b.bookingDate || b.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric', hour:'2-digit', minute:'2-digit'})}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="modal-detail-cell">
                                <p class="modal-detail-label">Overall Status</p>
                                <p class="modal-detail-val fw-bold" style="color:${col};">${statusLabels[b.status] || b.status}</p>
                            </div>
                        </div>

                        ${b.heldAt ? `
                        <div class="col-md-6">
                            <div class="modal-detail-cell">
                                <p class="modal-detail-label">Held Since</p>
                                <p class="modal-detail-val" style="color:#f39c12;">${new Date(b.heldAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})}</p>
                            </div>
                        </div>
                        <div class="col-12 mt-2">
                            <div class="modal-detail-cell" style="background: rgba(243, 156, 18, 0.1); border: 1px solid rgba(243, 156, 18, 0.3);">
                                <p class="modal-detail-label text-warning m-0 mb-1"><i class="fi fi-rr-info me-1"></i>Reason for Hold</p>
                                <p class="text-white m-0" style="font-size: 0.95rem;">${b.holdReason || 'No reason provided by organizer.'}</p>
                            </div>
                        </div>` : ''}

                        ${b.cancelledAt ? `
                        <div class="col-md-6">
                            <div class="modal-detail-cell">
                                <p class="modal-detail-label">Cancelled On</p>
                                <p class="modal-detail-val" style="color:#E63946;">${new Date(b.cancelledAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})}</p>
                            </div>
                        </div>` : ''}
                    </div>
                `;
            } catch(err) {
                body.innerHTML = `<div class="text-center py-4"><i class="fi fi-rr-triangle-warning text-danger" style="font-size:2rem;display:block;margin-bottom:1rem;"></i><p class="text-dim m-0">Failed to load booking details.</p></div>`;
            }
        }

        function closeModal() {
            document.getElementById('bookingDetailModal').classList.remove('active');
        }
        document.getElementById('bookingDetailModal')?.addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        // ── Custom Hold Reason Logic ──
        let currentHoldEventId = null;
        let currentHoldBookingId = null;

        function closeHoldModal() {
            document.getElementById('holdReasonModal').classList.remove('active');
            document.getElementById('holdReasonInput').value = '';
            document.getElementById('holdReasonError').style.display = 'none';
        }

        async function toggleHold(eventId, bookingId, isResume) {
            if (!isResume) {
                currentHoldEventId = eventId;
                currentHoldBookingId = bookingId;
                document.getElementById('holdReasonModal').classList.add('active');
                document.getElementById('holdReasonInput').focus();
                return; 
            }

            const ok = await CustomConfirm.show({
                title: 'Resume Booking?',
                message: 'Are you sure you want to resume this booking? The hold status will be removed.',
                confirmText: 'Yes, Resume',
                actionType: 'primary',
                icon: 'fi-rr-play'
            });
            if (!ok) return;
            try {
                const res = await axios.post(`/organizer/events/${eventId}/bookings/${bookingId}/unhold`);
                if (res.data.success) { 
                    location.reload(); 
                }
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to resume booking');
            }
        }

        document.getElementById('confirmHoldBtn')?.addEventListener('click', async () => {
            const reasonInput = document.getElementById('holdReasonInput');
            const reason = reasonInput.value.trim();
            const errorMsg = document.getElementById('holdReasonError');
            const btn = document.getElementById('confirmHoldBtn');

            if (!reason) {
                errorMsg.style.display = 'block';
                reasonInput.style.borderColor = '#E63946'; 
                return;
            }
            
            errorMsg.style.display = 'none';
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fi fi-rr-spinner" style="animation:spin 1s linear infinite;"></i> Processing...';
            btn.disabled = true;

            try {
                const res = await axios.post(`/organizer/events/${currentHoldEventId}/bookings/${currentHoldBookingId}/hold`, { reason });
                if (res.data.success) { location.reload(); }
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to hold booking');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });

        // ── Cancel & Payout ──
        async function cancelBooking(eventId, bookingId) {
            const ok = await CustomConfirm.show({
                title: 'Cancel Booking?',
                message: 'This will cancel the booking and restore the ticket inventory. Wallet payments will be refunded immediately.',
                confirmText: 'Yes, Cancel',
                actionType: 'danger',
                icon: 'fi-rr-ban'
            });
            if (!ok) return;

            Loader.show('CANCELLING...');
            try {
                const res = await axios.post(`/organizer/events/${eventId}/bookings/${bookingId}/cancel`);
                if (res.data.success) { Toast.success(res.data.message); setTimeout(() => location.reload(), 1500); }
            } catch(err) { Toast.error(err.response?.data?.message || 'Failed to cancel booking.'); }
            finally { Loader.hide(); }
        }

        async function requestPayout(eventId) {
            const ok = await CustomConfirm.show({
                title: 'Request Payout?',
                message: 'A 5% platform fee will be deducted from the total revenue.',
                confirmText: 'Request', actionType: 'primary', icon: 'fi-rr-money'
            });
            if (!ok) return;
            Loader.show('PROCESSING...');
            try {
                const res = await axios.post('/organizer/events/payout/request', { eventId });
                if (res.data.success) { Toast.success(res.data.message); setTimeout(() => location.reload(), 1500); }
            } catch(err) { Toast.error(err.response?.data?.message || 'Failed to request payout'); }
            finally { Loader.hide(); }
        }

        // ── Delete Cancelled Booking ──
        async function deleteBooking(eventId, bookingId) {
            const ok = await CustomConfirm.show({
                title: 'Delete Record?',
                message: 'This will permanently remove this cancelled booking from your dashboard. This action cannot be undone.',
                confirmText: 'Delete Forever', actionType: 'danger', icon: 'fi-rr-trash'
            });
            if (!ok) return;

            Loader.show('DELETING...');
            try {
                const res = await axios.delete(`/organizer/events/${eventId}/bookings/${bookingId}`);
                if (res.data.success) { Toast.success(res.data.message); setTimeout(() => location.reload(), 1500); }
            } catch(err) { Toast.error(err.response?.data?.message || 'Failed to delete booking.'); }
            finally { Loader.hide(); }
        }

        // ── Cancellation Request: Approve & Reject ────────────────────────────
        async function quickApproveCancelRequest(bookingId) {
            const ok = await CustomConfirm.show({
                title: 'Approve Cancellation?',
                message: 'This will cancel the booking, release inventory, and process the refund (wallet payments are instant). The user will be notified.',
                confirmText: 'Approve & Refund',
                actionType: 'primary',
                icon: 'fi-rr-check-circle'
            });
            if (!ok) return;

            Loader.show('PROCESSING CANCELLATION...');
            try {
                const res = await axios.post(`/organizer/bookings/${bookingId}/approve-cancel`);
                if (res.data.success) {
                    Toast.success(res.data.message);
                    setTimeout(() => location.reload(), 1500);
                }
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to approve cancellation.');
            } finally {
                Loader.hide();
            }
        }

        let orgRejectBookingId = null;

        function openOrgRejectModal(bookingId) {
            orgRejectBookingId = bookingId;
            document.getElementById('orgRejectNoteInput').value = '';
            document.getElementById('orgRejectNoteError').style.display = 'none';
            document.getElementById('orgRejectModal').classList.add('active');
            setTimeout(() => document.getElementById('orgRejectNoteInput').focus(), 150);
        }

        function closeOrgRejectModal() {
            document.getElementById('orgRejectModal').classList.remove('active');
            orgRejectBookingId = null;
        }

        document.getElementById('confirmOrgRejectBtn')?.addEventListener('click', async () => {
            const noteInput = document.getElementById('orgRejectNoteInput');
            const errorEl   = document.getElementById('orgRejectNoteError');
            const btn       = document.getElementById('confirmOrgRejectBtn');
            const note      = noteInput.value.trim();

            if (!note) {
                errorEl.style.display = 'block';
                noteInput.focus();
                return;
            }
            errorEl.style.display = 'none';

            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fi fi-rr-spinner" style="animation:spin 1s linear infinite;"></i> Processing...';
            btn.disabled  = true;

            try {
                const res = await axios.post(`/organizer/bookings/${orgRejectBookingId}/reject-cancel`, { rejectionNote: note });
                if (res.data.success) {
                    closeOrgRejectModal();
                    Toast.success(res.data.message);
                    setTimeout(() => location.reload(), 1500);
                }
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to reject request.');
                btn.innerHTML = originalHtml;
                btn.disabled  = false;
            }
        });

        let orgQtyResolve = null;

        function openOrgQtyModal(maxQty) {
            return new Promise((resolve) => {
                const modal = document.getElementById('organizerQtyConfirmModal');
                const input = document.getElementById('orgCancelQtyInput');
                const confirmBtn = document.getElementById('confirmOrgQtyBtn');

                input.max = maxQty;
                input.value = 1;
                modal.classList.add('active');

                confirmBtn.onclick = () => {
                    const qty = parseInt(input.value);
                    if (qty > 0 && qty <= maxQty) {
                        modal.classList.remove('active');
                        resolve(qty);
                    } else {
                        Toast.error(`Please enter a valid quantity between 1 and ${maxQty}`);
                    }
                };
                
                orgQtyResolve = resolve;
            });
        }

        function closeOrgQtyModal() {
            document.getElementById('organizerQtyConfirmModal').classList.remove('active');
            if (orgQtyResolve) orgQtyResolve(null);
        }

        // Updated Cancel Function
        async function cancelSingleTicket(eventId, bookingId, ticketItemId, maxQty) {
            let cancelQty = 1;

            // Trigger custom quantity modal if they hold more than 1
            if (maxQty > 1) {
                cancelQty = await openOrgQtyModal(maxQty);
                if (!cancelQty) return; 
            } else {
                // Standard Confirm Modal for single items
                const ok = await CustomConfirm.show({
                    title: 'Cancel this Ticket?',
                    message: 'Are you sure you want to cancel this specific ticket? The user will be notified.',
                    confirmText: 'Yes, Cancel',
                    actionType: 'danger'
                });
                if (!ok) return;
            }

            Loader.show('Cancelling Ticket...');
            try {
                const res = await axios.post(`/organizer/events/${eventId}/bookings/${bookingId}/tickets/${ticketItemId}/cancel`, {
                    quantity: cancelQty // We are now passing the quantity!
                });

                if (res.data.success) {
                    Toast.success(res.data.message);
                    setTimeout(() => location.reload(), 1500);
                }
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to cancel ticket');
            } finally {
                Loader.hide();
            }
        }

        // ── LIVE SOCKET UPDATES: INCOMING BOOKINGS ──
        // Using String() and trim() to guarantee it's a clean text ID
        const currentEventId = String('<%= event._id %>').trim(); 

        function joinOrganizerEventRoom() {
            if (!currentEventId || currentEventId === '') {
                console.error('❌ Cannot join room: currentEventId is missing!');
                return;
            }
            
            // This is what ACTUALLY tells the backend to join the room
            window.socket.emit('joinEvent', currentEventId);
            console.log(`📡 Frontend asked Backend to join room: [${currentEventId}]`);
        }

        // Connect/Reconnect Logic
        if (window.socket.connected) {
            joinOrganizerEventRoom();
        } else {
            window.socket.on('connect', joinOrganizerEventRoom);
        }

        // Listen for the live booking
        window.socket.on('newBooking', (data) => {
            console.log('🎉 Live Booking Received from Backend!', data);
            
            try {
                const b = data.booking;
                if (!b) return console.error('No booking data received!');

                const totalAmt = b.totalAmount || 0; 
                const userName = (b.user && b.user.fullName) ? b.user.fullName : 'Unknown User';
                const userEmail = (b.user && b.user.email) ? b.user.email : 'N/A';
                
                // Show Toast
                if (typeof Toast !== 'undefined') {
                    Toast.success(`🎫 New booking! ${userName} paid ₹${totalAmt.toLocaleString('en-IN')}`);
                } else {
                    alert(`New booking! ${userName} paid ₹${totalAmt}`);
                }

                // Build Payment Tag safely
                let paymentHtml = '<span class="text-dim small">No payments</span>';
                if (b.payments && Array.isArray(b.payments) && b.payments.length > 0) {
                    paymentHtml = b.payments.map(p => {
                        const pid = p.id ? p.id.slice(0, 10) + '...' : 'Wallet';
                        return `<div class="payment-tag" style="font-size:0.7rem; padding:2px 5px; margin-bottom:2px;">ID: ${pid} (${p.status || 'unknown'})</div>`;
                    }).join('');
                }

                // Format Date & ID safely
                const safeDate = b.bookingDate || b.createdAt || new Date();
                const dateStr = new Date(safeDate).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'});
                const safeId = b._id ? b._id.toString().slice(-8).toUpperCase() : 'UNKNOWN';

                // Create Row HTML
                const newRowHtml = `
                    <tr style="background: rgba(46, 204, 113, 0.15); transition: background 2s ease;">
                        <td class="text-dim" style="font-family:monospace;font-size:0.78rem;">#${safeId}</td>
                        <td>
                            <strong style="color:white;">${userName}</strong>
                            <p class="text-dim m-0" style="font-size:0.78rem;">${userEmail}</p>
                        </td>
                        <td>${paymentHtml}</td>
                        <td><strong style="color:#2ecc71;">₹${totalAmt.toLocaleString('en-IN')}</strong></td>
                        <td class="text-dim" style="font-size:0.8rem;">${dateStr}</td>
                        <td><span class="bk-badge bk-active"><i class="fi fi-rr-check me-1"></i>Active</span></td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <button class="org-action-btn org-view" onclick="viewBooking('${currentEventId}', '${b._id}')" title="View Details">
                                    <i class="fi fi-rr-eye"></i>
                                </button>
                                <button class="org-action-btn org-hold" onclick="toggleHold('${currentEventId}', '${b._id}', false)" title="Put on Hold">
                                    <i class="fi fi-rr-pause"></i>
                                </button>
                                <button class="org-action-btn org-cancel" onclick="cancelBooking('${currentEventId}', '${b._id}')" title="Cancel Entire Booking">
                                    <i class="fi fi-rr-ban"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;

                // Inject into DOM
                const tbody = document.querySelector('.data-table tbody');
                if (!tbody) {
                    return console.error("❌ Could not find table body (.data-table tbody) to inject row!");
                }

                const emptyRow = tbody.querySelector('td[colspan]');
                if (emptyRow) emptyRow.parentElement.remove();

                tbody.insertAdjacentHTML('afterbegin', newRowHtml);

                // Fade out background after 3s
                setTimeout(() => {
                    if (tbody.firstElementChild) tbody.firstElementChild.style.background = 'transparent';
                }, 3000);

            } catch (error) {
                console.error("❌ Javascript error rendering new booking row:", error);
            }
        });
    </script>
</body>
</html>