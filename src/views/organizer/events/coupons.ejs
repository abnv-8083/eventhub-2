<%- include('../../partials/head') %>
<style>
    /* 1. Prevent Flexbox from blowing out the screen width */
    .dashboard-main { 
        min-width: 0 !important; 
    }

    /* 2. Premium Table Styling */
    .coupon-table-wrapper {
        background: #121212; 
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        
        width: 100%;
        overflow-x: auto; /* Forces horizontal scroll INSIDE the box if screen is small */
        -webkit-overflow-scrolling: touch;
    }
    
    .coupon-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        min-width: 850px; 
    }

    .coupon-table thead th {
        background: rgba(255, 255, 255, 0.03);
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        white-space: nowrap;
    }

    .coupon-table tbody td {
        padding: 1.25rem 1.5rem;
        color: #fff;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        vertical-align: middle;
        white-space: nowrap;
    }

    .coupon-table tbody tr:hover td { background: rgba(255, 255, 255, 0.01); }
    .coupon-table tbody tr:last-child td { border-bottom: none; }
</style>

<body class="bg-mesh">
    <%- include('../../partials/navbars/organizer-nav') %>
    <div class="dashboard-layout">
        <%- include('../../partials/organizer-sidebar') %>
        
        <main class="dashboard-main">
            
            <div class="container-fluid py-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <div class="text-dim small mb-1">
                            <a href="/organizer/events/<%= event._id %>" class="text-decoration-none text-primary"><i class="fi fi-rr-arrow-left me-1"></i> Back to Event</a>
                        </div>
                        <h2 class="text-white m-0 fw-bold"><i class="fi fi-rr-tags text-primary me-2"></i>Manage Offers</h2>
                        <p class="text-dim">Create and manage promo codes for <strong><%= event.title %></strong></p>
                    </div>
                    <button class="btn btn-primary px-4 shadow" onclick="openModal('add')">
                        <i class="fi fi-rr-plus"></i> New Offer
                    </button>
                </div>

                <div class="coupon-table-wrapper">
                    <table class="coupon-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Discount</th>
                                <th>Usage Limit</th>
                                <th>Expiry Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(coupons && coupons.length > 0) { %>
                                <% coupons.forEach(c => { %>
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary px-3 py-2 text-uppercase" style="font-family: monospace; letter-spacing: 1px; border: 1px dashed rgba(255,255,255,0.5);">
                                                <%= c.code %>
                                            </span>
                                        </td>
                                        <td>
                                            <strong class="text-white"><%= c.discountType === 'percentage' ? c.discountValue + '%' : '₹' + c.discountValue %> OFF</strong>
                                        </td>
                                        <td>
                                            <div class="text-dim small">
                                                <%= c.usedCount %> / <%= c.maxUses ? c.maxUses : '∞' %>
                                                <div class="progress mt-1" style="height: 4px; background: rgba(255,255,255,0.1);">
                                                    <div class="progress-bar bg-primary" style="width: <%= c.maxUses ? (c.usedCount/c.maxUses)*100 : 0 %>%"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-dim">
                                            <%= new Date(c.expiryDate).toLocaleDateString(undefined, {day:'numeric', month:'short', year:'numeric'}) %>
                                        </td>
                                        <td>
                                            <% if (c.isActive) { %>
                                                <span class="bk-badge bk-active" style="color: #2ecc71; background: rgba(46,204,113,0.1); padding: 4px 8px; border-radius: 4px; font-size: 0.8rem;"><i class="fi fi-rr-check-circle me-1"></i>Active</span>
                                            <% } else { %>
                                                <span class="bk-badge bk-cancelled" style="color: #e74c3c; background: rgba(231,76,60,0.1); padding: 4px 8px; border-radius: 4px; font-size: 0.8rem;"><i class="fi fi-rr-ban me-1"></i>Blocked</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-outline-secondary" onclick="openModal('edit', '<%= c._id %>')" title="Edit" style="border: 1px solid rgba(255,255,255,0.1); background: transparent; color: white;">
                                                    <i class="fi fi-rr-edit"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary" onclick="toggleStatus('<%= c._id %>')" title="<%= c.isActive ? 'Block' : 'Unblock' %>" style="border: 1px solid rgba(255,255,255,0.1); background: transparent; color: <%= c.isActive ? '#e74c3c' : '#2ecc71' %>;">
                                                    <i class="fi fi-rr-<%= c.isActive ? 'ban' : 'check' %>"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary" onclick="deleteOffer('<%= c._id %>')" title="Delete" style="border: 1px solid rgba(255,255,255,0.1); background: transparent; color: #e74c3c;">
                                                    <i class="fi fi-rr-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <i class="fi fi-rr-ticket-alt text-dim opacity-50 mb-3 d-block" style="font-size: 3rem;"></i>
                                        <h5 class="text-white">No Offers Yet</h5>
                                        <p class="text-dim">Create your first promo code to boost your sales!</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

            </div>
        </main>
    </div>

    <div class="modal-overlay" id="couponModal" style="z-index: 9999; backdrop-filter: blur(8px);">
        <div class="modal-container" style="max-width: 650px; background: linear-gradient(165deg, rgba(30,30,30,0.95) 0%, rgba(15,15,15,0.98) 100%); border: 1px solid rgba(255,255,255,0.08); border-radius: 24px; box-shadow: 0 25px 50px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.02) inset; overflow: hidden; display: flex; flex-direction: column; max-height: 90vh; padding: 0;">
            
            <!-- Sticky Header -->
            <div style="background: rgba(255,255,255,0.02); padding: 2rem 2.5rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.05); flex-shrink: 0;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div style="width: 50px; height: 50px; border-radius: 14px; background: linear-gradient(135deg, rgba(46, 204, 113, 0.2), rgba(46, 204, 113, 0.05)); color: #2ecc71; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; border: 1px solid rgba(46, 204, 113, 0.2);">
                        <i class="fi fi-rr-tags"></i>
                    </div>
                    <button class="action-btn" onclick="closeModal()" style="width: 36px; height: 36px; border-radius: 50%;"><i class="fi fi-rr-cross-small"></i></button>
                </div>
                <h4 class="text-white m-0 fw-bold" id="modalTitle" style="letter-spacing: -0.5px;">New Offer</h4>
                <p class="text-dim small m-0 mt-1">Configure your discount rules and limits.</p>
            </div>
            
            <!-- Scrollable Body -->
            <div style="overflow-y: auto; overflow-x: hidden; padding: 2rem 2.5rem; flex-grow: 1;">
                <form id="couponForm" onsubmit="submitForm(event)" novalidate>
                    <input type="hidden" id="editCouponId">
                    
                    <div class="mb-4">
                        <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">PROMO CODE</label>
                        <div class="position-relative">
                            <i class="fi fi-rr-text position-absolute top-50 start-0 translate-middle-y ms-3 text-dim"></i>
                            <input type="text" id="couponCode" name="code" class="input ps-5 text-uppercase fw-bold text-white w-100" placeholder="e.g. SUMMER50" data-rule="required" style="letter-spacing: 2px; font-family: monospace; font-size: 1.1rem; height: 55px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08); transition: border-color 0.3s, box-shadow 0.3s;" onfocus="this.style.borderColor='var(--primary)'; this.style.boxShadow='0 0 0 3px rgba(var(--primary-rgb), 0.15)';">
                        </div>
                    </div>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">DISCOUNT TYPE</label>
                            <select id="discountType" class="input text-white w-100" onchange="toggleCapAmount()" style="height: 50px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                                <option value="percentage">% Percentage</option>
                                <option value="flat">₹ Flat Amount</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">VALUE</label>
                            <div class="position-relative">
                                <i class="fi fi-rr-coins position-absolute top-50 start-0 translate-middle-y ms-3 text-dim"></i>
                                <input type="number" id="discountValue" name="discountValue" class="input ps-5 fw-bold text-white w-100" placeholder="e.g. 10" data-rule="required, number" data-min="1" style="height: 50px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                            </div>
                        </div>
                        <div class="col-md-4" id="capAmountBox">
                            <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">CAP AMOUNT <span class="opacity-50 fw-normal">(Max ₹)</span></label>
                            <input type="number" id="maxDiscountAmount" class="input text-white w-100" placeholder="e.g. 3000" min="1" style="height: 50px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">APPLICABLE TICKETS <span class="opacity-50 fw-normal">(Leave empty for all tickets)</span></label>
                        <div id="applicableTicketsContainer" class="d-flex flex-column gap-1 custom-scrollbar" style="max-height: 150px; overflow-y: auto; padding: 0.5rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px;">
                            <% event.tickets.forEach(t => { %>
                                <label class="d-flex align-items-center gap-3 m-0 ticket-checkbox-label" style="padding: 0.8rem 1rem; border-radius: 8px; cursor: pointer; transition: background 0.2s; border: 1px solid transparent;">
                                    <input type="checkbox" name="applicableTickets" value="<%= t._id %>" class="form-check-input m-0" style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--primary);">
                                    <div>
                                        <span class="text-white fw-bold d-block"><%= t.name %></span>
                                        <span class="text-dim small d-block" style="font-size: 0.8rem;">₹<%= t.price %></span>
                                    </div>
                                </label>
                            <% }) %>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">MIN PURCHASE <span class="opacity-50 fw-normal">(Opt)</span></label>
                            <input type="number" id="minOrderValue" class="input text-white w-100" placeholder="₹0" min="0" style="height: 50px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">EXPIRY DATE</label>
                            <div class="position-relative">
                                <input type="date" id="expiryDate" name="expiryDate" class="input text-white w-100" data-rule="required, futureDate" style="color-scheme: dark; height: 50px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                            </div>
                        </div>
                    </div>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">TOTAL USES <span class="opacity-50 fw-normal">(Opt)</span></label>
                            <div class="position-relative">
                                <i class="fi fi-rr-users position-absolute top-50 start-0 translate-middle-y ms-3 text-dim"></i>
                                <input type="number" id="maxUses" class="input ps-5 text-white w-100" placeholder="Unlimited" min="1" style="height: 50px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-dim small fw-bold" style="letter-spacing: 1px;">PER USER LIMIT <span class="opacity-50 fw-normal">(Opt)</span></label>
                            <div class="position-relative">
                                <i class="fi fi-rr-user position-absolute top-50 start-0 translate-middle-y ms-3 text-dim"></i>
                                <input type="number" id="maxPerUser" class="input ps-5 text-white w-100" placeholder="e.g. 1" min="1" style="height: 50px; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08);">
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Sticky Footer -->
                <div style="background: rgba(255,255,255,0.02); padding: 1.5rem 2.5rem; border-top: 1px solid rgba(255,255,255,0.05); flex-shrink: 0; display: flex; gap: 1rem;">
                    <button type="button" class="btn btn-outline flex-grow-1" onclick="closeModal()" style="border-color: rgba(255,255,255,0.1) !important; color: white !important; height: 50px; border-radius: 12px; font-weight: 600;">Cancel</button>
                    <button type="submit" class="btn btn-primary flex-grow-1 d-flex justify-content-center align-items-center gap-2" style="height: 50px; border-radius: 12px; font-weight: 700; background: linear-gradient(135deg, var(--primary) 0%, #3a58df 100%); border: none; box-shadow: 0 8px 20px rgba(var(--primary-rgb), 0.3);">
                        <i class="fi fi-rr-disk"></i> Save Offer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const EVENT_ID = '<%= event._id %>';
        const ALL_COUPONS = <%- JSON.stringify(coupons || []) %>;
    </script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        let mode = 'add'; // 'add' or 'edit'

        function openModal(action, id = null) {
            mode = action;
            document.getElementById('couponModal').classList.add('active');
            const ticketCheckboxes = document.querySelectorAll('input[name="applicableTickets"]');
            
            if(action === 'add') {
                document.getElementById('modalTitle').innerText = 'New Offer';
                document.getElementById('couponForm').reset();
                document.getElementById('editCouponId').value = '';
                
                const now = new Date();
                const offset = now.getTimezoneOffset() * 60000;
                document.getElementById('expiryDate').min = new Date(now.getTime() - offset).toISOString().split('T')[0];
                
                ticketCheckboxes.forEach(cb => cb.checked = false);
            } else {
                document.getElementById('modalTitle').innerText = 'Edit Offer';
                const c = ALL_COUPONS.find(c => c._id === id);
                if(c) {
                    document.getElementById('editCouponId').value = c._id;
                    document.getElementById('couponCode').value = c.code;
                    document.getElementById('discountType').value = c.discountType;
                    document.getElementById('discountValue').value = c.discountValue;
                    document.getElementById('maxDiscountAmount').value = c.maxDiscountAmount || '';
                    document.getElementById('minOrderValue').value = c.minOrderValue || '';
                    document.getElementById('maxUses').value = c.maxUses || '';
                    document.getElementById('maxPerUser').value = c.maxPerUser || '';
                    document.getElementById('expiryDate').value = new Date(c.expiryDate).toISOString().split('T')[0];
                    
                    const now = new Date();
                    const offset = now.getTimezoneOffset() * 60000;
                    document.getElementById('expiryDate').min = new Date(now.getTime() - offset).toISOString().split('T')[0];
                    
                    // Highlight selected tickets
                    ticketCheckboxes.forEach(cb => {
                        cb.checked = c.applicableTickets.includes(cb.value);
                    });
                }
            }
            toggleCapAmount();
        }

        function closeModal() {
            document.getElementById('couponModal').classList.remove('active');
        }

        async function submitForm(e) {
            e.preventDefault();
            if (!EV.validateForm(document.getElementById('couponForm'))) return;
            const id = document.getElementById('editCouponId').value;
            
            // Get selected tickets
            const ticketCheckboxes = document.querySelectorAll('input[name="applicableTickets"]:checked');
            const applicableTickets = Array.from(ticketCheckboxes).map(cb => cb.value);
            
            const payload = {
                code: document.getElementById('couponCode').value.trim(),
                discountType: document.getElementById('discountType').value,
                discountValue: Number(document.getElementById('discountValue').value),
                maxDiscountAmount: document.getElementById('maxDiscountAmount').value ? Number(document.getElementById('maxDiscountAmount').value) : null,
                minOrderValue: document.getElementById('minOrderValue').value ? Number(document.getElementById('minOrderValue').value) : 0,
                applicableTickets: applicableTickets,
                maxUses: document.getElementById('maxUses').value ? Number(document.getElementById('maxUses').value) : null,
                maxPerUser: document.getElementById('maxPerUser').value ? Number(document.getElementById('maxPerUser').value) : null,
                expiryDate: document.getElementById('expiryDate').value
            };

            try {
                if(mode === 'add') {
                    await axios.post(`/organizer/events/${EVENT_ID}/coupons`, payload);
                } else {
                    await axios.put(`/organizer/events/coupons/${id}`, payload);
                }
                window.location.reload();
            } catch (err) {
                Toast.error(err.response?.data?.message || 'Failed to save offer');
            }
        }

        async function toggleStatus(id) {
            try {
                await axios.patch(`/organizer/events/coupons/${id}/toggle`);
                window.location.reload();
            } catch (err) {
                Toast.error('Failed to toggle status');
            }
        }

        function deleteOffer(id) {
            Swal.fire({
                title: 'Delete this Offer?',
                text: "Users won't be able to use this code anymore.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74c3c',
                cancelButtonColor: 'rgba(255,255,255,0.1)',
                confirmButtonText: 'Yes, delete it',
                background: '#121212',
                color: '#fff'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        await axios.delete(`/organizer/events/coupons/${id}`);
                        window.location.reload();
                    } catch (err) {
                        Toast.error('Failed to delete offer');
                    }
                }
            });
        }

        function toggleCapAmount() {
            const type = document.getElementById('discountType').value;
            document.getElementById('capAmountBox').style.display = type === 'percentage' ? 'block' : 'none';
        }
    </script>
</body>
</html>