<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scanner: <%= event.title %> - EventHub</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Flaticons -->
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.1.0/uicons-regular-rounded/css/uicons-regular-rounded.css'>
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.1.0/uicons-bold-rounded/css/uicons-bold-rounded.css'>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- HTML5 QR Code Scanner CDN -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <style>
        :root {
            --bg-dark: #0B0F19;
            --card-bg: #111827;
            --card-bg-light: #1F2937;
            --border-color: rgba(255, 255, 255, 0.08);
            --primary: #6366F1;
            --primary-hover: #4F46E5;
            --accent: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
        }

        body {
            background: var(--bg-dark);
            font-family: 'Inter', sans-serif;
            color: #F3F4F6;
            min-height: 100vh;
            padding-bottom: 60px;
        }

        h1, h2, h3, h4, h5, .font-outfit {
            font-family: 'Outfit', sans-serif;
        }

        /* Top Navbar */
        .scanner-header {
            background: rgba(17, 24, 39, 0.8);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 1000;
            padding: 16px 0;
        }

        .pin-badge {
            background: rgba(99, 102, 241, 0.15);
            border: 1px solid rgba(99, 102, 241, 0.3);
            color: #818CF8;
            font-family: 'Outfit', monospace;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 10px;
            letter-spacing: 0.1em;
            font-size: 0.95rem;
        }

        /* Stats Bar */
        .stats-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 24px;
            margin-top: 24px;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);
        }

        .stat-value {
            font-size: 2.25rem;
            font-weight: 800;
            font-family: 'Outfit', sans-serif;
            line-height: 1;
            margin-bottom: 4px;
        }

        .stat-label {
            color: #9CA3AF;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
        }

        .progress-bar-custom {
            height: 10px;
            border-radius: 6px;
            background: rgba(255,255,255,0.1);
            overflow: hidden;
            margin-top: 16px;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            transition: width 0.5s ease;
        }

        /* Tabs & Scanner Container */
        .scanner-box {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 24px;
            margin-top: 24px;
        }

        .nav-pills .nav-link {
            color: #9CA3AF;
            font-weight: 600;
            border-radius: 12px;
            padding: 12px 24px;
            transition: all 0.2s;
        }

        .nav-pills .nav-link.active {
            background: var(--primary);
            color: #fff;
        }

        #reader {
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
            border: 2px dashed rgba(255,255,255,0.15) !important;
            border-radius: 16px;
            overflow: hidden;
            background: #000;
        }

        #reader video {
            border-radius: 14px;
        }

        .manual-input {
            background: rgba(0, 0, 0, 0.4) !important;
            border: 2px solid rgba(255, 255, 255, 0.12) !important;
            border-radius: 14px !important;
            color: #fff !important;
            font-family: 'Outfit', monospace;
            font-size: 1.25rem !important;
            padding: 16px 20px !important;
            text-transform: uppercase;
        }

        .manual-input:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.25) !important;
        }

        /* Modal Styles */
        .modal-content {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        }

        .modal-header {
            border-bottom: 1px solid var(--border-color);
            padding: 24px 28px;
        }

        .modal-body {
            padding: 28px;
        }

        .modal-footer {
            border-top: 1px solid var(--border-color);
            padding: 20px 28px;
        }

        .status-banner {
            border-radius: 14px;
            padding: 16px 20px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .status-banner.success {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #34D399;
        }

        .status-banner.warning {
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid rgba(245, 158, 11, 0.3);
            color: #FBBF24;
        }

        .status-banner.danger {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #FCA5A5;
        }

        .ticket-item-row {
            background: var(--card-bg-light);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .qty-input {
            width: 80px;
            background: #0B0F19 !important;
            border: 1px solid var(--border-color) !important;
            color: #fff !important;
            font-weight: 700;
            text-align: center;
            border-radius: 10px !important;
            padding: 8px !important;
        }

        .btn-approve {
            background: linear-gradient(135deg, var(--accent), #059669);
            border: none;
            border-radius: 14px;
            color: #fff;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            font-size: 1.1rem;
            padding: 14px 28px;
            transition: all 0.2s;
            box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.4);
        }

        .btn-approve:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 25px -5px rgba(16, 185, 129, 0.5);
            background: linear-gradient(135deg, #34D399, #10B981);
        }

        .btn-approve:disabled {
            background: #374151;
            box-shadow: none;
            cursor: not-allowed;
            transform: none;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="scanner-header">
        <div class="container d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-center bg-primary rounded-3 text-white" style="width: 40px; height: 40px; font-size: 20px;">
                    <i class="fi fi-rr-expand"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-white"><%= event.title %></h5>
                    <small class="text-secondary"><i class="fi fi-rr-marker"></i> <%= event.location?.venueName || 'Online Event' %></small>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="pin-badge d-none d-sm-inline-block">PIN: #<%= scannerCode %></span>
                <a href="/scanner/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                    <i class="fi fi-rr-sign-out-alt"></i> Exit
                </a>
            </div>
        </div>
    </header>

    <div class="container">
        <!-- Live Stats Card -->
        <div class="stats-card">
            <div class="row text-center g-3">
                <div class="col-4 border-end border-secondary border-opacity-25">
                    <div class="stat-value text-white" id="statSold"><%= totalSold %></div>
                    <div class="stat-label">Total Sold</div>
                </div>
                <div class="col-4 border-end border-secondary border-opacity-25">
                    <div class="stat-value text-success" id="statCheckedIn"><%= totalCheckedIn %></div>
                    <div class="stat-label">Checked In</div>
                </div>
                <div class="col-4">
                    <div class="stat-value text-info" id="statRemaining"><%= Math.max(0, totalSold - totalCheckedIn) %></div>
                    <div class="stat-label">Remaining</div>
                </div>
            </div>

            <% const pct = totalSold > 0 ? Math.round((totalCheckedIn / totalSold) * 100) : 0; %>
            <div class="progress-bar-custom">
                <div class="progress-fill" id="statProgress" style="width: <%= pct %>%;"></div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-secondary">Attendance Rate</small>
                <small class="text-white fw-bold" id="statPct"><%= pct %>%</small>
            </div>
        </div>

        <!-- Scanner Interface -->
        <div class="scanner-box">
            <ul class="nav nav-pills justify-content-center mb-4 gap-2" id="scannerTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active d-flex align-items-center gap-2" id="camera-tab" data-bs-toggle="pill" data-bs-target="#camera-pane" type="button" role="tab">
                        <i class="fi fi-rr-camera"></i> Camera Scanner
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link d-flex align-items-center gap-2" id="manual-tab" data-bs-toggle="pill" data-bs-target="#manual-pane" type="button" role="tab">
                        <i class="fi fi-rr-keyboard"></i> Manual Lookup
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="scannerTabContent">
                <!-- Camera Pane -->
                <div class="tab-pane fade show active text-center" id="camera-pane" role="tabpanel">
                    <div id="reader" class="mb-3"></div>
                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <button id="btnStartCamera" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                            <i class="fi fi-rr-play me-2"></i> Start Camera
                        </button>
                        <button id="btnStopCamera" class="btn btn-secondary rounded-pill px-4 py-2 fw-semibold d-none">
                            <i class="fi fi-rr-stop me-2"></i> Stop Camera
                        </button>
                    </div>
                    <p class="text-secondary small mt-3 mb-0">Point your phone camera at the attendee's ticket QR code.</p>
                </div>

                <!-- Manual Pane -->
                <div class="tab-pane fade" id="manual-pane" role="tabpanel">
                    <div class="max-w-md mx-auto" style="max-width: 500px;">
                        <form id="manualSearchForm" class="d-flex gap-2">
                            <input type="text" id="manualInput" class="form-control manual-input" placeholder="e.g. #6A4C8F or full ID" required>
                            <button type="submit" class="btn btn-primary px-4 rounded-3 fw-bold d-flex align-items-center gap-2">
                                <i class="fi fi-rr-search"></i> Search
                            </button>
                        </form>
                        <p class="text-secondary small mt-2 mb-0">Enter the 6-character short Ref ID shown on the e-ticket.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ticket Verification & Check-in Modal -->
    <div class="modal fade" id="verificationModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1 text-white fw-bold">Ticket Verification</h4>
                        <small class="text-secondary" id="modalBookingRef">Ref: #-----</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <!-- Status Banner -->
                    <div id="modalStatusBanner" class="status-banner success">
                        <i class="fi fi-rr-check-circle" style="font-size: 1.5rem;"></i>
                        <div>
                            <div class="fw-bold" id="modalStatusTitle">Valid & Ready for Check-in</div>
                            <small id="modalStatusSub">All checks passed.</small>
                        </div>
                    </div>

                    <!-- Attendee Info -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25">
                                <small class="text-secondary d-block mb-1">Attendee Name</small>
                                <strong class="text-white fs-5" id="modalAttendeeName">-----</strong>
                                <small class="text-secondary d-block mt-1" id="modalAttendeeEmail">-----</small>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25">
                                <small class="text-secondary d-block mb-1">Payment & Booking Status</small>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <span class="badge bg-success" id="modalPaymentBadge">PAID</span>
                                    <span class="badge bg-info" id="modalStatusBadge">ACTIVE</span>
                                </div>
                                <small class="text-secondary d-block mt-1" id="modalBookingDate">Booked on: ---</small>
                            </div>
                        </div>
                    </div>

                    <!-- Ticket Tiers Breakdown -->
                    <h6 class="text-secondary text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 0.05em;">Ticket Breakdown & Check-in Quantity</h6>
                    <div id="modalTicketItemsContainer">
                        <!-- Populated dynamically via JS -->
                    </div>
                </div>

                <div class="modal-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-approve" id="btnConfirmCheckIn">
                        <i class="fi fi-rr-check me-2"></i> Approve Entry & Check In
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Audio Beeps for Scanner Feedback -->
    <audio id="beepSuccess" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>
    <audio id="beepError" src="https://assets.mixkit.co/active_storage/sfx/2870/2870-preview.mp3" preload="auto"></audio>

    <!-- Bootstrap & Socket.io JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <script>
        const EVENT_ID = "<%= event._id %>";
        let html5QrCode = null;
        let isScanning = false;
        let currentBookingId = null;
        const verificationModal = new bootstrap.Modal(document.getElementById('verificationModal'));

        // Sound Beeps
        const playBeep = (type) => {
            try {
                const audio = document.getElementById(type === 'success' ? 'beepSuccess' : 'beepError');
                if (audio) {
                    audio.currentTime = 0;
                    audio.play().catch(e => console.log('Audio autoplay blocked'));
                }
            } catch(e) {}
        };

        // ─── Socket.io Live Listener ───────────────────────────────────────
        const socket = io();
        socket.emit('joinEvent', `scan_${EVENT_ID}`);

        socket.on('ticket_checked_in', (data) => {
            // Update live metrics on screen dynamically!
            const elCheckedIn = document.getElementById('statCheckedIn');
            const elRemaining = document.getElementById('statRemaining');
            const elSold = document.getElementById('statSold');
            const elProgress = document.getElementById('statProgress');
            const elPct = document.getElementById('statPct');

            if (elCheckedIn && elSold) {
                let currentChecked = parseInt(elCheckedIn.innerText, 10) || 0;
                let totalSold = parseInt(elSold.innerText, 10) || 0;
                
                // Add the new checked-in qty
                currentChecked += (data.totalCheckedInThisScan || 0);
                elCheckedIn.innerText = currentChecked;
                elRemaining.innerText = Math.max(0, totalSold - currentChecked);

                const pct = totalSold > 0 ? Math.round((currentChecked / totalSold) * 100) : 0;
                elProgress.style.width = `${pct}%`;
                elPct.innerText = `${pct}%`;
            }
        });

        // ─── Camera QR Scanner Setup ───────────────────────────────────────
        const btnStartCamera = document.getElementById('btnStartCamera');
        const btnStopCamera = document.getElementById('btnStopCamera');

        btnStartCamera.addEventListener('click', () => {
            if (!html5QrCode) {
                html5QrCode = new Html5Qrcode("reader");
            }

            html5QrCode.start(
                { facingMode: "environment" },
                {
                    fps: 10,
                    qrbox: { width: 250, height: 250 }
                },
                (decodedText) => {
                    // On QR Code read successfully!
                    playBeep('success');
                    pauseCamera();
                    verifyTicketCode(decodedText);
                },
                (errorMessage) => {
                    // ignore scan errors
                }
            ).then(() => {
                isScanning = true;
                btnStartCamera.classList.add('d-none');
                btnStopCamera.classList.remove('d-none');
            }).catch(err => {
                alert("Could not start camera: " + err);
            });
        });

        btnStopCamera.addEventListener('click', stopCamera);

        function pauseCamera() {
            if (html5QrCode && isScanning) {
                html5QrCode.pause();
            }
        }

        function resumeCamera() {
            if (html5QrCode && isScanning) {
                html5QrCode.resume();
            }
        }

        function stopCamera() {
            if (html5QrCode && isScanning) {
                html5QrCode.stop().then(() => {
                    isScanning = false;
                    btnStartCamera.classList.remove('d-none');
                    btnStopCamera.classList.add('d-none');
                }).catch(err => console.error("Stop camera error:", err));
            }
        }

        // Resume camera when modal closes
        document.getElementById('verificationModal').addEventListener('hidden.bs.modal', () => {
            currentBookingId = null;
            resumeCamera();
        });

        // ─── Manual Lookup Form ────────────────────────────────────────────
        document.getElementById('manualSearchForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const inputVal = document.getElementById('manualInput').value.trim();
            if (inputVal) {
                verifyTicketCode(inputVal);
            }
        });

        // ─── Verify Ticket AJAX ────────────────────────────────────────────
        async function verifyTicketCode(code) {
            try {
                const res = await fetch(`/scanner/api/verify/${encodeURIComponent(code)}`);
                const data = await res.json();

                if (!data.success) {
                    playBeep('error');
                    alert(data.message || "Ticket verification failed.");
                    resumeCamera();
                    return;
                }

                // Populate and show verification modal!
                populateModal(data.booking);
                verificationModal.show();
            } catch (err) {
                playBeep('error');
                alert("Network error while verifying ticket.");
                resumeCamera();
            }
        }

        function populateModal(booking) {
            currentBookingId = booking._id;
            document.getElementById('modalBookingRef').innerText = `Ref: #${booking.bookingRef}`;
            document.getElementById('modalAttendeeName').innerText = booking.user.fullName || 'Guest Attendee';
            document.getElementById('modalAttendeeEmail').innerText = `${booking.user.email || ''} ${booking.user.phone ? '· ' + booking.user.phone : ''}`;
            
            document.getElementById('modalPaymentBadge').innerText = booking.paymentStatus.toUpperCase();
            document.getElementById('modalStatusBadge').innerText = booking.status.toUpperCase();
            document.getElementById('modalBookingDate').innerText = `Booked on: ${new Date(booking.bookingDate).toLocaleDateString()}`;

            // Status Banner Logic
            const banner = document.getElementById('modalStatusBanner');
            const title = document.getElementById('modalStatusTitle');
            const sub = document.getElementById('modalStatusSub');
            const btnApprove = document.getElementById('btnConfirmCheckIn');

            if (booking.status !== 'active') {
                banner.className = 'status-banner danger';
                title.innerText = `⚠️ BOOKING IS ${booking.status.toUpperCase()}`;
                sub.innerText = 'This booking has been cancelled or is on hold. DO NOT ALLOW ENTRY.';
                btnApprove.disabled = true;
            } else if (booking.isCheckedIn) {
                banner.className = 'status-banner warning';
                title.innerText = '⚠️ ALREADY FULLY CHECKED IN!';
                sub.innerText = `All tickets were checked in on ${new Date(booking.checkedInAt).toLocaleString()}`;
                btnApprove.disabled = true;
            } else {
                banner.className = 'status-banner success';
                title.innerText = '✅ Valid & Ready for Check-in';
                sub.innerText = 'Please select ticket quantities below to check in.';
                btnApprove.disabled = false;
            }

            // Populate Ticket Items Table
            const container = document.getElementById('modalTicketItemsContainer');
            container.innerHTML = '';

            let totalRemainingAcrossBooking = 0;

            booking.items.forEach(item => {
                totalRemainingAcrossBooking += item.remainingQty;
                const row = document.createElement('div');
                row.className = 'ticket-item-row';
                
                const isCancelled = item.status !== 'active';
                const isFullyChecked = item.remainingQty === 0;

                row.innerHTML = `
                    <div>
                        <div class="fw-bold text-white fs-6">${item.ticketName}</div>
                        <small class="text-secondary">
                            Total: ${item.totalQty} · Checked in: ${item.checkedInQty}
                            ${isCancelled ? '<span class="badge bg-danger ms-2">CANCELLED</span>' : ''}
                        </small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="text-secondary small mb-0">Check in now:</label>
                        <input 
                            type="number" 
                            class="form-control qty-input checkin-qty-field" 
                            data-item-id="${item._id}"
                            min="0" 
                            max="${item.remainingQty}" 
                            value="${item.remainingQty}" 
                            ${isCancelled || isFullyChecked ? 'disabled' : ''}
                        >
                    </div>
                `;
                container.appendChild(row);
            });

            if (totalRemainingAcrossBooking === 0 && booking.status === 'active') {
                btnApprove.disabled = true;
            }
        }

        // ─── Execute Check-in AJAX ─────────────────────────────────────────
        document.getElementById('btnConfirmCheckIn').addEventListener('click', async () => {
            if (!currentBookingId) return;

            const qtyFields = document.querySelectorAll('.checkin-qty-field');
            const checkInItems = [];

            qtyFields.forEach(field => {
                const val = parseInt(field.value, 10) || 0;
                if (val > 0) {
                    checkInItems.push({
                        itemId: field.getAttribute('data-item-id'),
                        quantityToScan: val
                    });
                }
            });

            if (checkInItems.length === 0) {
                alert("Please select at least 1 ticket quantity to check in.");
                return;
            }

            const btn = document.getElementById('btnConfirmCheckIn');
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span> Processing...`;

            try {
                const res = await fetch('/scanner/api/checkin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        bookingId: currentBookingId,
                        checkInItems
                    })
                });

                const data = await res.json();
                if (data.success) {
                    playBeep('success');
                    verificationModal.hide();
                    // Live stats are updated via Socket.io automatically!
                } else {
                    playBeep('error');
                    alert(data.message || "Failed to process check-in.");
                    btn.disabled = false;
                    btn.innerHTML = `<i class="fi fi-rr-check me-2"></i> Approve Entry & Check In`;
                }
            } catch (err) {
                playBeep('error');
                alert("Network error while executing check-in.");
                btn.disabled = false;
                btn.innerHTML = `<i class="fi fi-rr-check me-2"></i> Approve Entry & Check In`;
            }
        });
    </script>
</body>
</html>
