<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gate Scanner Login - EventHub</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Flaticons -->
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.1.0/uicons-regular-rounded/css/uicons-regular-rounded.css'>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0B0F19;
            --card-bg: #111827;
            --border-color: rgba(255, 255, 255, 0.08);
            --primary: #6366F1;
            --primary-hover: #4F46E5;
            --accent: #10B981;
        }

        body {
            background: var(--bg-dark);
            font-family: 'Inter', sans-serif;
            color: #F3F4F6;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient background glow */
        .glow-bg {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(16, 185, 129, 0.05) 50%, transparent 70%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 0;
            pointer-events: none;
        }

        .scanner-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 40px 32px;
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 1;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(16px);
        }

        .icon-circle {
            width: 72px;
            height: 72px;
            border-radius: 20px;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(16, 185, 129, 0.2));
            border: 1px solid rgba(99, 102, 241, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            color: var(--primary);
            font-size: 32px;
            box-shadow: 0 0 25px rgba(99, 102, 241, 0.25);
        }

        h1 {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 1.75rem;
            text-align: center;
            margin-bottom: 8px;
            color: #fff;
        }

        .subtitle {
            text-align: center;
            color: #9CA3AF;
            font-size: 0.95rem;
            margin-bottom: 32px;
            line-height: 1.5;
        }

        .pin-input {
            background: rgba(0, 0, 0, 0.4) !important;
            border: 2px solid rgba(255, 255, 255, 0.12) !important;
            border-radius: 16px !important;
            color: #fff !important;
            font-family: 'Outfit', monospace;
            font-size: 2.25rem !important;
            font-weight: 700;
            text-align: center;
            letter-spacing: 0.45em;
            padding: 16px !important;
            text-indent: 0.45em; /* balance letter spacing */
            transition: all 0.3s ease;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);
        }

        .pin-input:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.25), inset 0 2px 4px rgba(0,0,0,0.5) !important;
            outline: none;
        }

        .pin-input::placeholder {
            color: rgba(255, 255, 255, 0.15);
            font-weight: 400;
        }

        .btn-scan {
            background: linear-gradient(135deg, var(--primary), #4338CA);
            border: none;
            border-radius: 16px;
            color: #fff;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            font-size: 1.1rem;
            padding: 16px;
            width: 100%;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 10px 20px -5px rgba(99, 102, 241, 0.4);
        }

        .btn-scan:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 25px -5px rgba(99, 102, 241, 0.5);
            background: linear-gradient(135deg, #6E71F5, #4F46E5);
        }

        .btn-scan:active {
            transform: translateY(0);
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 12px;
            color: #FCA5A5;
            padding: 12px 16px;
            font-size: 0.9rem;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .footer-link {
            text-align: center;
            margin-top: 24px;
        }

        .footer-link a {
            color: #6B7280;
            text-decoration: none;
            font-size: 0.85rem;
            transition: color 0.2s;
        }

        .footer-link a:hover {
            color: #9CA3AF;
        }
    </style>
</head>
<body>

    <div class="glow-bg"></div>

    <div class="container px-3">
        <div class="scanner-card mx-auto">
            <div class="icon-circle">
                <i class="fi fi-rr-expand"></i>
            </div>
            
            <h1>Gate Scanner Portal</h1>
            <p class="subtitle">Enter the 6-digit Unique Event PIN provided by the organizer to begin scanning tickets.</p>

            <% if (error) { %>
                <div class="alert-error" role="alert">
                    <i class="fi fi-rr-exclamation-triangle" style="font-size: 1.1rem;"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/scanner/login" method="POST">
                <div class="mb-4">
                    <input 
                        type="text" 
                        name="code" 
                        class="form-control pin-input" 
                        placeholder="••••••" 
                        maxlength="6" 
                        pattern="[0-9A-Za-z]{6}" 
                        required 
                        autofocus
                        autocomplete="off"
                    >
                </div>

                <button type="submit" class="btn btn-scan">
                    <span>Connect Scanner</span>
                    <i class="fi fi-rr-arrow-right"></i>
                </button>
            </form>

            <div class="footer-link">
                <a href="/"><i class="fi fi-rr-arrow-small-left"></i> Return to EventHub Homepage</a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
