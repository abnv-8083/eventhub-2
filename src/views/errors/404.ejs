<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 â€” Page Not Found | EventHub</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/uicons-regular-rounded/css/uicons-regular-rounded.css">
</head>
<body class="bg-mesh">
    <!-- Background blobs -->
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <div class="page-404">
        <div class="card-404">
            <!-- Brand -->
            <div class="logo-text">Event<span>Hub</span></div>

            <!-- Icon -->
            <div class="icon-wrap">
                <i class="fi fi-rr-search-alt"></i>
            </div>

            <!-- Number -->
            <div class="num-404">404</div>

            <!-- Text -->
            <h1 class="title-404">Page Not Found</h1>
            <p class="subtitle-404">
                The page you're looking for doesn't exist or has been moved.<br>
                Double-check the URL or head back to the homepage.
            </p>

            <!-- Actions -->
            <div class="actions">
                <a href="/" class="btn-home">
                    <i class="fi fi-rr-home"></i> Go Home
                </a>
                <a href="javascript:history.back()" class="btn-back">
                    <i class="fi fi-rr-arrow-left"></i> Go Back
                </a>
            </div>

            <!-- Quick navigation links -->
            <div class="quick-links">
                <a href="/user/events" class="quick-link">
                    <i class="fi fi-rr-calendar"></i> Browse Events
                </a>
                <a href="/user/tickets" class="quick-link">
                    <i class="fi fi-rr-ticket"></i> My Tickets
                </a>
                <a href="/user/wallet" class="quick-link">
                    <i class="fi fi-rr-wallet"></i> My Wallet
                </a>
            </div>
        </div>
    </div>
</body>
</html>
